
use ::self::primitives::string::ToString;
// write 函数应该分为 write_all write_partial

// libc 的 FILE* 统一用 *raw mut UInt8 表示, 和 fs 保持一致:
// extern type 出现在导出的结构体字段里时, zno 的导入方还解析不了 (见 fs::File),
// 所以这里不用 extern type, 两个模块声明同一批 libc 函数时类型必须写成一样的.
extern fn fwrite(buffer: *raw UInt8, size: UInt, count: UInt, stream: *raw mut UInt8) -> UInt;
// C 的 fflush 返回 int, 用 Int32 (原来写 UInt 会读到未定义的高 32 位)
extern fn fflush(stream: *raw mut UInt8) -> Int32;
extern fn strlen(s: *raw UInt8) -> UInt;
extern fn zinc_core_stdin() -> *raw mut UInt8;
extern fn zinc_core_stdout() -> *raw mut UInt8;
extern fn zinc_core_stderr() -> *raw mut UInt8;

unsafe fn print_cstr(cstr: *raw UInt8) -> UInt {
    unsafe {
        let len = strlen(cstr);
        let r = fwrite(cstr, 1, len, zinc_core_stdout());
        // 立刻刷出去: 程序 panic / 栈溢出时不会有机会 flush, stdout 还是全缓冲
        // (重定向到文件时) 的话, 崩溃前打印的内容就丢了。
        fflush(zinc_core_stdout());
        return r;
    }
}

pub fn print_str(str: Str) -> UInt {
    unsafe {
        let r = fwrite(str.pointer as *raw UInt8, 1, str.length, zinc_core_stdout());
        fflush(zinc_core_stdout());
        return r;
    }
}

// 注: 后续需要加锁
// 注: 从性能角度考虑，参数应该设计成 AsRef<Str> 类型。但是因为 zinc 没有 AsRef 这样的 trait，所以需要 as Str 这样的特殊语法糖支持。
pub fn print<T>(msg: T) -> UInt  where T: ToString {
    let s: String = msg.to_string();
    let str: Str = s.as_str().deref();
    unsafe {
        let r = fwrite(str.pointer as *raw UInt8, 1, str.length, zinc_core_stdout());
        fflush(zinc_core_stdout());
        return r;
    }
}

pub fn println() -> UInt {
    let new_line: Str = "\n";
    unsafe {
        fwrite(new_line.pointer as *raw UInt8, 1, new_line.length, zinc_core_stdout());
        fflush(zinc_core_stdout());
    }
    return 1;
}

pub fn println<T>(msg: T) -> UInt  where T: ToString {

    let new_line: Str = "\n";
    let r = print(msg);
    unsafe {
        let r = fwrite(new_line.pointer as *raw UInt8, 1, new_line.length, zinc_core_stdout());
        fflush(zinc_core_stdout());
        return r + 1;
    }
}

pub fn eprint<T>(msg: T) -> UInt  where T: ToString {
    let s: String = msg.to_string();
    let str = s.as_str().deref();
    unsafe {
        return fwrite(str.pointer as *raw UInt8, 1, str.length, zinc_core_stderr());
    }
}

pub fn eprintln() -> UInt {
    let new_line: Str = "\n";
    unsafe {
        return fwrite(new_line.pointer as *raw UInt8, 1, new_line.length, zinc_core_stderr());
    }
    return 1;
}

pub fn eprintln<T>(msg: T) -> UInt  where T: ToString {
    let new_line: Str = "\n";
    let r = eprint(msg);
    unsafe {
        return fwrite(new_line.pointer as *raw UInt8, 1, new_line.length, zinc_core_stderr());
    }
    return r + 1;
}
