use ::self::primitives::string::ToString;
use ::self::cmp::{Eq, PartialEq, PartialOrd, Ord, Ordering};
use ::self::hash::{Hash, Hasher};
use ::self::primitives::clone::Clone;
use ::self::primitives::default::Default;

impl Int {
    pub fn reverse_bits(self) -> Int {
        return ::self::intrinsic::reverse_bits(<Int>, self);
    }

    pub fn rotate_left(self, n: UInt32) -> Int {
        return ::self::intrinsic::rotate_left(<Int>, self, n);
    }

    pub fn rotate_right(self, n: UInt32) -> Int {
        return ::self::intrinsic::rotate_right(<Int>, self, n);
    }

    pub fn bit_and(self, n: Int) -> Int {
        return ::self::intrinsic::bit_and(<Int>, self, n);
    }

    pub fn bit_or(self, n: Int) -> Int {
        return ::self::intrinsic::bit_or(<Int>, self, n);
    }

    pub fn bit_xor(self, n: Int) -> Int {
        return ::self::intrinsic::bit_xor(<Int>, self, n);
    }

    pub fn bit_not(self) -> Int {
        return ::self::intrinsic::bit_not(<Int>, self);
    }

    pub fn bit_shl(self, n: UInt32) -> Int {
        return ::self::intrinsic::bit_shl(<Int>, self, n);
    }

    pub fn bit_shr(self, n: UInt32) -> Int {
        return ::self::intrinsic::bit_shr(<Int>, self, n);
    }
    pub fn min_value() -> Int {
        return 0x8000000000000000_u as Int;
    }
    pub fn max_value() -> Int {
        return 0x7FFFFFFFFFFFFFFF_i;
    }

    pub fn wrapping_add(self, rhs: Int) -> Int {
        // Integer `+` already wraps; this is the named wrapping API.
        return self + rhs;
    }

    pub fn wrapping_sub(self, rhs: Int) -> Int {
        return self - rhs;
    }

    pub fn wrapping_mul(self, rhs: Int) -> Int {
        return self * rhs;
    }

    pub fn checked_add(self, rhs: Int) -> Option<Int> {
        let sum = self + rhs;
        if rhs > 0 && sum < self {
            return None;
        }
        if rhs < 0 && sum > self {
            return None;
        }
        return Some(sum);
    }

    pub fn checked_sub(self, rhs: Int) -> Option<Int> {
        let diff = self - rhs;
        if rhs > 0 && diff > self {
            return None;
        }
        if rhs < 0 && diff < self {
            return None;
        }
        return Some(diff);
    }

    pub fn checked_mul(self, rhs: Int) -> Option<Int> {
        if self == 0 || rhs == 0 {
            return Some(0);
        }
        if self == Int::min_value() && rhs == -1_i {
            return None;
        }
        if rhs == Int::min_value() && self == -1_i {
            return None;
        }
        let prod = self * rhs;
        if prod / rhs != self {
            return None;
        }
        return Some(prod);
    }

    pub fn saturating_add(self, rhs: Int) -> Int {
        match self.checked_add(rhs) {
            Some(v) => {
                return v;
            }
            None => {
                if rhs > 0 {
                    return Int::max_value();
                }
                return Int::min_value();
            }
        }
    }

    pub fn saturating_sub(self, rhs: Int) -> Int {
        match self.checked_sub(rhs) {
            Some(v) => {
                return v;
            }
            None => {
                if rhs > 0 {
                    return Int::min_value();
                }
                return Int::max_value();
            }
        }
    }

    pub fn saturating_mul(self, rhs: Int) -> Int {
        match self.checked_mul(rhs) {
            Some(v) => {
                return v;
            }
            None => {
                if (self > 0) == (rhs > 0) {
                    return Int::max_value();
                }
                return Int::min_value();
            }
        }
    }

}

impl ToString for Int {
    fn to_string_inplace(&self, buf: &mut String) {
        let n: Int = *self;
        if (n < 0) {
            buf.push(b'-');
            let uv: UInt64 = (-(n + 1)) as UInt64 + 1;
            uv.to_string_inplace(buf);
        } else {
            let m = n as UInt64;
            m.to_string_inplace(buf);
        }
    }

    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

impl PartialEq for Int {
    fn eq(&self, other: &Self) -> Bool {
        return *self == *other;
    }

    fn ne(&self, other: &Self) -> Bool {
        return *self != *other;
    }
}

impl Eq for Int {}

impl PartialOrd for Int {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        if *self < *other {
            return Some(Ordering::Less);
        }
        else if *self == *other {
            return Some(Ordering::Equal);
        }
        else {
            return Some(Ordering::Greater);
        }
    }
    fn lt(&self, other: &Self) -> Bool {
        return self.partial_cmp(other) is Some(Ordering::Less);
    }
    fn le(&self, other: &Self) -> Bool {
        return !(self.partial_cmp(other) is Some(Ordering::Greater));
    }
    fn gt(&self, other: &Self) -> Bool {
        return self.partial_cmp(other) is Some(Ordering::Greater);
    }
    fn ge(&self, other: &Self) -> Bool {
        return !(self.partial_cmp(other) is Some(Ordering::Less));
    }
}

impl Ord for Int {
    fn cmp(&self, other: &Self) -> Ordering {
        if *self < *other {
            return Ordering::Less;
        }
        else if *self == *other {
            return Ordering::Equal;
        }
        else {
            return Ordering::Greater;
        }
    }
}

impl Hash for Int {
    fn hash(&self, state: &mut Hasher) {
        state.combine(*self as UInt64);
    }
}

impl Clone for Int {
    fn clone(&self) -> Int {
        return *self;
    }
}

impl Default for Int {
    fn default() -> Int {
        return 0;
    }
}
