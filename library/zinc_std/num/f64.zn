
use ::self::primitives::string::ToString;
use ::self::cmp::{Eq, PartialEq, PartialOrd, Ord, Ordering};
use ::self::hash::{Hash, Hasher};
use ::self::primitives::clone::Clone;
use ::self::primitives::default::Default;
use ::self::collections::vec::Shared;

extern fn zinc_core_float_to_string(num: F64, buf: *raw mut Byte, size: UInt) -> Int32;

impl F64 {
    pub fn is_nan(&self) -> Bool {
        let f: F64 = *self;
        return f != f;
    }
}

impl ToString for F64 {
    fn to_string_inplace(&self, buf: &mut String) {
        buf.reserve(32_u);
        let end = (buf.data.ptr as *raw Shared<UInt8> as *raw mut Byte) + buf.data.size;
        let mut n = unsafe(zinc_core_float_to_string(*self as F64, end, 32_u));
        // C 侧把结果写到了缓冲区末尾, 但不会更新 String 长度;
        // 这里不更新长度的话 String 仍然是空的 (println 会打印空行)。
        if (n < 0) {
            n = 0;
        } else if (n > 31) {
            // snprintf 缓冲区不够时返回"需要的长度", 实际只写了 31 字节 + '\0'
            n = 31;
        }
        buf.data.size = buf.data.size + (n as UInt);
    }

    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

impl PartialEq for F64 {
    fn eq(&self, other: &Self) -> Bool {
        return *self == *other;
    }

    fn ne(&self, other: &Self) -> Bool {
        return *self != *other;
    }
}

impl PartialOrd for F64 {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        if (*self != *self) {
            return None;
        }
        if (*other != *other) {
            return None;
        }
        if *self < *other {
            return Some(Ordering::Less);
        }
        else if *self == *other {
            return Some(Ordering::Equal);
        }
        else {
            return Some(Ordering::Greater);
        }
    }
    fn lt(&self, other: &Self) -> Bool {
        return self.partial_cmp(other) is Some(Ordering::Less);
    }
    fn le(&self, other: &Self) -> Bool {
        // 注意不能写成 !(... is Some(Greater)): NaN 的 partial_cmp 是 None,
        // 那样会得到 true, 而 IEEE 规定 NaN <= x 为 false。
        if (self.partial_cmp(other) is Some(Ordering::Less)) {
            return true;
        }
        if (self.partial_cmp(other) is Some(Ordering::Equal)) {
            return true;
        }
        return false;
    }
    fn gt(&self, other: &Self) -> Bool {
        return self.partial_cmp(other) is Some(Ordering::Greater);
    }
    fn ge(&self, other: &Self) -> Bool {
        // 同 le: NaN >= x 必须是 false
        if (self.partial_cmp(other) is Some(Ordering::Greater)) {
            return true;
        }
        if (self.partial_cmp(other) is Some(Ordering::Equal)) {
            return true;
        }
        return false;
    }
}

impl Hash for F64 {
    fn hash(&self, state: &mut Hasher) {
        let p = self as &F64 as *raw F64 as *raw UInt64;

        let mut bits: UInt64 = unsafe(*p);
        if (bits == 0xfff8_0000_0000_0000_u64) {
            bits = 0x7ff8_0000_0000_0000_u64;
        }
        // 使用位运算增强分布
        let h = bits * 11400714819323198485_u64;
        state.combine(h);
    }
}

impl Clone for F64 {
    fn clone(&self) -> F64 {
        return *self;
    }
}

impl Default for F64 {
    fn default() -> F64 {
        return 0.0;
    }
}
