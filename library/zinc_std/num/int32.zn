use ::self::primitives::string::ToString;
use ::self::cmp::{Eq, PartialEq, PartialOrd, Ord, Ordering};
use ::self::hash::{Hash, Hasher};
use ::self::primitives::clone::Clone;
use ::self::primitives::default::Default;

impl Int32 {
    pub fn reverse_bits(self) -> Int32 {
        return ::self::intrinsic::reverse_bits(<Int32>, self);
    }

    pub fn rotate_left(self, n: UInt32) -> Int32 {
        return ::self::intrinsic::rotate_left(<Int32>, self, n);
    }

    pub fn rotate_right(self, n: UInt32) -> Int32 {
        return ::self::intrinsic::rotate_right(<Int32>, self, n);
    }

    pub fn bit_and(self, n: Int32) -> Int32 {
        return ::self::intrinsic::bit_and(<Int32>, self, n);
    }

    pub fn bit_or(self, n: Int32) -> Int32 {
        return ::self::intrinsic::bit_or(<Int32>, self, n);
    }

    pub fn bit_xor(self, n: Int32) -> Int32 {
        return ::self::intrinsic::bit_xor(<Int32>, self, n);
    }

    pub fn bit_not(self) -> Int32 {
        return ::self::intrinsic::bit_not(<Int32>, self);
    }

    pub fn bit_shl(self, n: UInt32) -> Int32 {
        return ::self::intrinsic::bit_shl(<Int32>, self, n);
    }

    pub fn bit_shr(self, n: UInt32) -> Int32 {
        return ::self::intrinsic::bit_shr(<Int32>, self, n);
    }
}

impl ToString for Int32 {
    fn to_string_inplace(&self, buf: &mut String) {
        let n: Int32 = *self;
        if (n < 0) {
            buf.push(b'-');
            let uv: UInt64 = (-(n + 1)) as UInt64 + 1;
            uv.to_string_inplace(buf);
        } else {
            let m = n as UInt64;
            m.to_string_inplace(buf);
        }
    }

    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

impl PartialEq for Int32 {
    fn eq(&self, other: &Self) -> Bool {
        return *self == *other;
    }

    fn ne(&self, other: &Self) -> Bool {
        return *self != *other;
    }
}

impl Eq for Int32 {}

impl PartialOrd for Int32 {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        if *self < *other {
            return Some(Ordering::Less);
        }
        else if *self == *other {
            return Some(Ordering::Equal);
        }
        else {
            return Some(Ordering::Greater);
        }
    }
    fn lt(&self, other: &Self) -> Bool {
        return self.partial_cmp(other) is Some(Ordering::Less);
    }
    fn le(&self, other: &Self) -> Bool {
        return !(self.partial_cmp(other) is Some(Ordering::Greater));
    }
    fn gt(&self, other: &Self) -> Bool {
        return self.partial_cmp(other) is Some(Ordering::Greater);
    }
    fn ge(&self, other: &Self) -> Bool {
        return !(self.partial_cmp(other) is Some(Ordering::Less));
    }
}

impl Ord for Int32 {
    fn cmp(&self, other: &Self) -> Ordering {
        if *self < *other {
            return Ordering::Less;
        }
        else if *self == *other {
            return Ordering::Equal;
        }
        else {
            return Ordering::Greater;
        }
    }
}

impl Hash for Int32 {
    fn hash(&self, state: &mut Hasher) {
        state.combine(*self as UInt64);
    }
}

impl Clone for Int32 {
    fn clone(&self) -> Int32 {
        return *self;
    }
}

impl Default for Int32 {
    fn default() -> Int32 {
        return 0;
    }
}
