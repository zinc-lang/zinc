use ::self::primitives::string::ToString;
use ::self::cmp::{Eq, PartialEq, PartialOrd, Ord, Ordering};
use ::self::hash::{Hash, Hasher};
use ::self::primitives::clone::Clone;
use ::self::primitives::default::Default;

impl UShort {
    pub fn reverse_bits(self) -> UShort {
        return ::self::intrinsic::reverse_bits(<UShort>, self);
    }

    pub fn rotate_left(self, n: UInt32) -> UShort {
        return ::self::intrinsic::rotate_left(<UShort>, self, n);
    }

    pub fn rotate_right(self, n: UInt32) -> UShort {
        return ::self::intrinsic::rotate_right(<UShort>, self, n);
    }

    pub fn bit_and(self, n: UShort) -> UShort {
        return ::self::intrinsic::bit_and(<UShort>, self, n);
    }

    pub fn bit_or(self, n: UShort) -> UShort {
        return ::self::intrinsic::bit_or(<UShort>, self, n);
    }

    pub fn bit_xor(self, n: UShort) -> UShort {
        return ::self::intrinsic::bit_xor(<UShort>, self, n);
    }

    pub fn bit_not(self) -> UShort {
        return ::self::intrinsic::bit_not(<UShort>, self);
    }

    pub fn bit_shl(self, n: UInt32) -> UShort {
        return ::self::intrinsic::bit_shl(<UShort>, self, n);
    }

    pub fn bit_shr(self, n: UInt32) -> UShort {
        return ::self::intrinsic::bit_shr(<UShort>, self, n);
    }
}

impl ToString for UShort {
    fn to_string_inplace(&self, buf: &mut String) {
        let m = *self as UInt64;
        m.to_string_inplace(buf);
    }

    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

impl PartialEq for UShort {
    fn eq(&self, other: &Self) -> Bool {
        return *self == *other;
    }

    fn ne(&self, other: &Self) -> Bool {
        return *self != *other;
    }
}

impl Eq for UShort {}

impl PartialOrd for UShort {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        if *self < *other {
            return Some(Ordering::Less);
        }
        else if *self == *other {
            return Some(Ordering::Equal);
        }
        else {
            return Some(Ordering::Greater);
        }
    }
    fn lt(&self, other: &Self) -> Bool {
        return self.partial_cmp(other) is Some(Ordering::Less);
    }
    fn le(&self, other: &Self) -> Bool {
        return !(self.partial_cmp(other) is Some(Ordering::Greater));
    }
    fn gt(&self, other: &Self) -> Bool {
        return self.partial_cmp(other) is Some(Ordering::Greater);
    }
    fn ge(&self, other: &Self) -> Bool {
        return !(self.partial_cmp(other) is Some(Ordering::Less));
    }
}

impl Ord for UShort {
    fn cmp(&self, other: &Self) -> Ordering {
        if *self < *other {
            return Ordering::Less;
        }
        else if *self == *other {
            return Ordering::Equal;
        }
        else {
            return Ordering::Greater;
        }
    }
}

impl Hash for UShort {
    fn hash(&self, state: &mut Hasher) {
        state.combine(*self as UInt64);
    }
}

impl Clone for UShort {
    fn clone(&self) -> UShort {
        return *self;
    }
}

impl Default for UShort {
    fn default() -> UShort {
        return 0;
    }
}
