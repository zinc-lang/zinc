use self::cmp::{PartialEq, PartialOrd, Eq, Ord};

pub fn assert(condition: Bool) {
    if !condition {
        panic("assertion failed");
    }
}

pub fn assert(condition: Bool, message: Str) {
    if !condition {
        panic(message);
    }
}

pub fn assert_eq<T>(left: T, right: T) where T: PartialEq {
    if left.ne(&right) {
        panic("assertion failed: left != right");
    }
}

pub fn assert_eq<T>(left: T, right: T, message: Str) where T: PartialEq {
    if left.ne(&right) {
        panic(message);
    }
}

pub fn assert_ne<T>(left: T, right: T) where T: PartialEq {
    if left.eq(&right) {
        panic("assertion failed: left == right");
    }
}

pub fn assert_ne<T>(left: T, right: T, message: Str) where T: PartialEq {
    if left.eq(&right) {
        panic(message);
    }
}
