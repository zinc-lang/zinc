impl Step for Short {
    fn forward(&mut self) -> Bool {
        let sum = *self + 1;
        if sum < *self {
            return false;
        }
        *self = sum;
        return true;
    }
    fn backward(&mut self) -> Bool {
        let diff = *self - 1;
        if diff > *self {
            return false;
        }
        *self = diff;
        return true;
    }
}

impl Step for UInt {
    fn forward(&mut self) -> Bool {
        let sum = *self + 1_u;
        if sum < *self {
            return false;
        }
        *self = sum;
        return true;
    }
    fn backward(&mut self) -> Bool {
        if *self < 1_u {
            return false;
        }
        *self = *self - 1_u;
        return true;
    }
}

impl Step for UInt8 {
    fn forward(&mut self) -> Bool {
