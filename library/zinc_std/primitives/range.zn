impl Step for UInt {
    fn forward(&mut self, count: UInt) -> Bool {
        let sum = *self + count;
        if sum < *self {
            return false;
        }
        *self = sum;
        return true;
    }
    fn backward(&mut self, count: UInt) -> Bool {
        if *self < count {
            return false;
        }
        *self = *self - count;
        return true;
    }
}

