impl Step for UShort {
    fn forward(&mut self) -> Bool {
        let sum = *self + 1;
        if sum < *self {
            return false;
        }
        *self = sum;
        return true;
    }
    fn backward(&mut self) -> Bool {
        if *self < 1 {
            return false;
        }
        *self = *self - 1;
        return true;
    }
}

impl Step for Char {
    fn forward(&mut self) -> Bool {
        let c = *self as UInt32;
        let sum = c + 1_u32;
        if sum < c {
            return false;
        }
        *self = sum as Char;
        return true;
    }
    fn backward(&mut self) -> Bool {
        let c = *self as UInt32;
        if c < 1_u32 {
            return false;
        }
        *self = (c - 1_u32) as Char;
        return true;
    }
}