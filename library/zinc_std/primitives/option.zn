

use ::self::cmp::{Eq, PartialEq};
use ::self::hash::{Hash, Hasher};
use ::self::primitives::clone::Clone;

pub enum Option<T> {
    None, Some(T)
}

unsafe impl<T> Send for Option<T> where T: Send {}

// 约束写在 where 里, 不放松类型检查: T 不满足 PartialEq/Eq/... 时 Option<T> 也不会得到实现。
impl<T> PartialEq for Option<T> where T: PartialEq {
    fn eq(&self, other: &Self) -> Bool {
        match self {
            Option::None => {
                // 用 match other 而不是 `*other is ...`, 避免整体拷贝带 payload 的 Option
                match other {
                    Option::None => { return true; }
                    Option::Some(_) => { return false; }
                }
            }
            Option::Some(a) => {
                match other {
                    Option::Some(b) => { return a.eq(&b); }
                    Option::None => { return false; }
                }
            }
        }
    }

    fn ne(&self, other: &Self) -> Bool {
        return !self.eq(other);
    }
}

impl<T> Eq for Option<T> where T: Eq {}

impl<T> Hash for Option<T> where T: Hash {
    fn hash(&self, state: &mut Hasher) {
        match self {
            Option::None => { state.combine(0_u64); }
            Option::Some(v) => {
                state.combine(1_u64);
                v.hash(state);
            }
        }
    }
}

// Clone: 和 PartialEq 一样把 T: Clone 约束写在 where 里, 不放松类型检查。
// 逐元素 clone 需要 T 的 Clone 在运行期派发到具体类型上 (曾经因为
// "返回 Self 的 trait 方法 ABI 不一致" 而返回错值, 所以一直没有实现)。
impl<T> Clone for Option<T> where T: Clone {
    fn clone(&self) -> Self {
        match self {
            Option::None => { return None; }
            Option::Some(v) => { return Some(v.clone()); }
        }
    }
}

// 不需要 is_some / is_none 函数，用关键字 is 比这两个函数好
impl<T> Option<T> {

    pub fn get_or_panic(&self) -> T {
        match self {
            Option::Some(value) => {
                return value;
            }
            Option::None => {
                panic("called `Option::get_or_panic()` on a `None` value");
            }
        }
    }

    pub fn get_or_panic(&self, msg: Str) -> T {
        match self {
            Option::Some(value) => {
                return value;
            }
            Option::None => {
                panic msg;
            }
        }
    }

    pub fn get_or_else(&self, v: T) -> T {
        match self {
            Option::Some(value) => {
                return value;
            }
            Option::None => {
                return v;
            }
        }
    }
}