use ::self::iter::Iterable;
use ::self::iter::Iterator;
use ::self::primitives::string::ToString;
use ::self::cmp::{Eq, PartialEq};
use ::self::collections::vec::Shared;

pub struct Str<'a> {
    pointer: &'a UInt8,
    length: UInt,
}

unsafe impl<'a> Send for Str<'a> {}
impl<'a> !Sync for Str<'a> {}

impl<'a> Str<'a> {
    pub fn as_bytes<'s>(&'s self) -> Slice<'s, UInt8> {
        return {
            .pointer = self.pointer,
            .length = self.length,
        }: Slice<'s, UInt8>;
    }

    pub fn raw_ptr(&self) -> *raw UInt8 {
        return self.pointer as *raw UInt8;
    }

    pub fn len(&self) -> UInt {
        return self.length;
    }

    pub fn is_empty(&self) -> Bool {
        return self.length == 0;
    }

    // pub fn to_string(&self) -> String {
    //     let mut s = String::with_capacity(self.length);
    //     let mut dst = s.data.ptr as *raw Shared<UInt8> as *raw mut UInt8;
    //     let mut src = self.pointer as *raw UInt8;
    //     let mut i: UInt = 0;
    //     while i < self.length {
    //         unsafe {
    //             *dst = *src;
    //         }
    //         i += 1;
    //         dst = dst + 1;
    //         src = src + 1;
    //     }
    //     return s;
    // }

    pub unsafe fn from_cstr(cs: *raw UInt8) -> Str<'static> {
        let mut len: UInt = 0;
        let mut p = cs + len;
        while (p as UInt) != 0 && *p != 0_u8 {
            len += 1;
            p = cs + len;
        }
        return {
            .pointer = cs as &UInt8,
            .length = len,
        }: Str<'static>;
    }

    pub fn starts_with(&self, prefix: Str) -> Bool {
        if self.len() < prefix.len() {
            return false;
        }
        let mut i: UInt = 0;
        while i < prefix.length {
            let c1 = unsafe(self.pointer as *raw UInt8 + i);
            let c2 = unsafe(prefix.pointer as *raw UInt8 + i);
            if unsafe(*c1 != *c2) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    pub fn ends_with(&self, suffix: Str) -> Bool {
        if self.len() < suffix.len() {
            return false;
        }
        let start = self.len() - suffix.len();
        let mut i: UInt = 0;
        while i < suffix.length {
            let c1 = unsafe(self.pointer as *raw UInt8 + start + i);
            let c2 = unsafe(suffix.pointer as *raw UInt8 + i);
            if unsafe(*c1 != *c2) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    pub fn sub_str(&self, start: UInt) -> Str<'a> {
        if start > self.len() {
            panic("Index out of bounds in Str::sub_str method.");
        }
        return {
            .pointer = unsafe((self.pointer as *raw UInt8 + start) as &'a UInt8),
            .length = self.length - start,
        }: Str<'a>;
    }

    pub fn sub_str(&self, start: UInt, length: UInt) -> Str<'a> {
        // 先判断 start 再算 self.len() - start: 避免 `start + length` 先回绕，
        // 那样会构造出长度接近 UInt::MAX 的越界视图，后续访问直接段错误。
        if start > self.len() || length > self.len() - start {
            panic("Index out of bounds in Str::sub_str method.");
        }
        return {
            .pointer = unsafe((self.pointer as *raw UInt8 + start) as &'a UInt8),
            .length = length,
        }: Str<'a>;
    }

    pub fn index(&self, i: UInt) -> UInt8 {
        if i >= self.len() {
            panic("Index out of bounds in Str::index method.");
        }
        let c = unsafe(self.pointer as *raw UInt8 + i);
        return unsafe(*c);
    }

    // todo 通过泛型让参数支持多种类型, 返回一个lazy执行的迭代器
    pub fn split(&self, by: UInt8) -> Vec<String> {
        let mut parts: Vec<String> = (type Vec<String>)::new();
        let mut start: UInt = 0;
        let mut i: UInt = 0;
        while i < self.length {
            let c = unsafe(self.pointer as *raw UInt8 + i);
            if unsafe(*c == by) {
                parts.push(String::from_str({
                    .pointer = unsafe((self.pointer as *raw UInt8 + start) as &'a UInt8),
                    .length = i - start,
                }: Str));
                start = i + 1;
            }
            i += 1;
        }
        // 循环里只在遇到分隔符时 push, 最后一段 (含无分隔符的整段、以及以分隔符
        // 结尾时的空段) 必须在这里补上, 否则 "abc" 会得到 0 段、"a," 会丢掉空尾段。
        parts.push(String::from_str({
            .pointer = unsafe((self.pointer as *raw UInt8 + start) as &'a UInt8),
            .length = self.length - start,
        }: Str));
        return parts;
    }
}

impl<'a> ToString for Str<'a> {
    fn to_string_inplace(&self, buf: &mut String) {
        buf.push_str(*self);
    }
    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

impl<'a> PartialEq for Str<'a> {
    fn eq(&self, other: &Self) -> Bool {
        if self.len() != other.len() {
            return false;
        }
        let mut i: UInt = 0;
        while i < self.length {
            let c1 = unsafe(self.pointer as *raw UInt8 + i);
            let c2 = unsafe(other.pointer as *raw UInt8 + i);
            if unsafe(*c1 != *c2) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    fn ne(&self, other: &Self) -> Bool {
        return !self.eq(other);
    }
}

impl<'a> Eq for Str<'a> {}

pub struct StrIter<'i> {
    pointer: &'i UInt8,
    length: UInt,
    index: UInt,
    // next() 返回的是 &Char, 需要一个稳定的落脚点存当前解码出来的字符
    value: Char = '\0',
}

impl<'a> Iterable for Str<'a> {
    type Iter<'i> = StrIter<'i>; // StrIter 不携带隐式生命周期参数
    fn iter<'s>(&'s self) -> StrIter<'s> { // 返回的迭代器借用 Str 的缓冲区
        return {
            .pointer = self.pointer,
            .length = self.length,
            .index = 0,
        }: StrIter<'s>;
    }
}

impl<'s> Iterator for StrIter<'s> {
    type Item = Char;

    // 按 UTF-8 字符产出元素; 非法/截断的序列退化成逐字节产出, 保证永远不越界读。
    fn next<'n>(&'n mut self) -> Option<&'n Char> {
        if self.index >= self.length {
            return None;
        }
        let p = self.pointer as *raw UInt8;
        let b0 = unsafe(*(p + self.index));

        // 根据首字节判断序列长度并取高位
        let mut size: UInt = 1;
        let mut cp: UInt32 = b0 as UInt32;
        if b0 >= 0xC0_u8 && b0 < 0xE0_u8 {
            cp = (b0 as UInt32).bit_and(0x1F_u32);
            size = 2;
        } else if b0 >= 0xE0_u8 && b0 < 0xF0_u8 {
            cp = (b0 as UInt32).bit_and(0x0F_u32);
            size = 3;
        } else if b0 >= 0xF0_u8 && b0 <= 0xF4_u8 {
            cp = (b0 as UInt32).bit_and(0x07_u32);
            size = 4;
        }

        if size > self.length - self.index {
            // 截断的多字节序列: 按单字节处理
            size = 1;
            cp = b0 as UInt32;
        } else {
            let mut k: UInt = 1;
            while k < size {
                let b = unsafe(*(p + self.index + k));
                if b.bit_and(0xC0_u8) != 0x80_u8 {
                    // 非法续字节: 回退成单字节
                    size = 1;
                    cp = b0 as UInt32;
                    break;
                }
                cp = cp.bit_shl(6_u32).bit_or((b as UInt32).bit_and(0x3F_u32));
                k += 1;
            }
        }

        self.index += size;
        self.value = cp as Char;
        return Some(&self.value);
    }
}
