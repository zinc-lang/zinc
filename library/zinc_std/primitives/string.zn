
use ::self::iter::Iterable;
use ::self::iter::Iterator;
use ::self::collections::vec::Shared;
use ::self::cmp::{Eq, PartialEq};
use ::self::hash::{Hash, Hasher};
use ::self::primitives::clone::Clone;

pub struct String {
    data: Vec<UInt8>
}

unsafe impl Send for String {}
impl !Sync for String {}

pub trait ToString {

    virtual fn to_string_inplace(&self, buf: &mut String);

    virtual fn to_string(&self) -> String;
}

pub struct FromUtf8Error {
    bytes: Vec<UInt8>,
    error: String,
}

impl String {
    pub fn new() -> String {
        return { .data = (type Vec<UInt8>)::new() }: String;
    }

    pub fn with_capacity(cap: UInt) -> String {
        return { .data = (type Vec<UInt8>)::with_capacity(cap) }: String;
    }

    // todo 后面支持了 auto deref 之后，这个函数就没什么意义了，直接 deref 就好了
    pub fn capacity(&self) -> UInt {
        return self.data.capacity();
    }

    // todo 后面支持了 auto deref 之后，这个函数就没什么意义了，直接 deref 就好了
    pub fn len(&self) -> UInt {
        return self.data.size;
    }

    pub fn raw_ptr(&self) -> *raw UInt8 {
        return self.data.ptr as *raw Shared<UInt8> as *raw UInt8;
    }


    pub fn is_empty(&self) -> Bool {
        return self.data.size == 0;
    }

    pub fn from_str(s: Str) -> String {
        let mut vec: Vec<UInt8> = (type Vec<UInt8>)::with_capacity(s.length); // todo: 修复类型推导 bug
        vec.extend_from_slice(s.as_bytes());
        return {
            .data = move vec,
        }: String;
    }

    // 返回第一个非法 UTF-8 字节的下标; 全部合法时返回 None。
    // 覆盖: 非法起始字节、截断的多字节序列、非法续字节、overlong 编码、
    // UTF-16 代理区 (U+D800..U+DFFF) 以及超出 U+10FFFF 的码点。
    fn find_invalid_utf8(s: Str) -> Option<UInt> {
        let len = s.len();
        let mut i: UInt = 0;
        while i < len {
            let b0 = s.index(i);
            if b0 < 0x80_u8 {
                i += 1;
            } else if b0 >= 0xC2_u8 && b0 <= 0xDF_u8 {
                // 2 字节序列: 110xxxxx 10xxxxxx
                if len - i < 2 {
                    return Some(i);
                }
                let b1 = s.index(i + 1);
                if b1.bit_and(0xC0_u8) != 0x80_u8 {
                    return Some(i);
                }
                i += 2;
            } else if b0 >= 0xE0_u8 && b0 <= 0xEF_u8 {
                // 3 字节序列: 1110xxxx 10xxxxxx 10xxxxxx
                if len - i < 3 {
                    return Some(i);
                }
                let b1 = s.index(i + 1);
                let b2 = s.index(i + 2);
                if b1.bit_and(0xC0_u8) != 0x80_u8 || b2.bit_and(0xC0_u8) != 0x80_u8 {
                    return Some(i);
                }
                if b0 == 0xE0_u8 && b1 < 0xA0_u8 { // overlong
                    return Some(i);
                }
                if b0 == 0xED_u8 && b1 >= 0xA0_u8 { // 代理区
                    return Some(i);
                }
                i += 3;
            } else if b0 >= 0xF0_u8 && b0 <= 0xF4_u8 {
                // 4 字节序列: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
                if len - i < 4 {
                    return Some(i);
                }
                let b1 = s.index(i + 1);
                let b2 = s.index(i + 2);
                let b3 = s.index(i + 3);
                if b1.bit_and(0xC0_u8) != 0x80_u8 || b2.bit_and(0xC0_u8) != 0x80_u8 || b3.bit_and(0xC0_u8) != 0x80_u8 {
                    return Some(i);
                }
                if b0 == 0xF0_u8 && b1 < 0x90_u8 { // overlong
                    return Some(i);
                }
                if b0 == 0xF4_u8 && b1 >= 0x90_u8 { // > U+10FFFF
                    return Some(i);
                }
                i += 4;
            } else {
                // 0x80..0xC1 是孤立的续字节/overlong 起始, 0xF5..0xFF 超出范围
                return Some(i);
            }
        }
        return None;
    }

    pub fn from_utf8(vec: Vec<UInt8>) -> Result<String, FromUtf8Error> {
        let str = unsafe({ .pointer = vec.ptr as *raw Shared<UInt8> as *raw UInt8 as &UInt8, .length = vec.size }: Str);
        match (Self::find_invalid_utf8(str)) {
            Option::Some(_idx) => {
                let err = { .bytes = move vec, .error = String::from_str("invalid utf-8 sequence") }: FromUtf8Error;
                return (type Result<String, FromUtf8Error>)::Err(err);
            }
            Option::None => {
                return (type Result<String, FromUtf8Error>)::Ok({ .data = move vec } as String);
            }
        }
    }

    pub fn bytes(&self) -> Vec<UInt8> {
        return self.data;
    }

    pub fn as_str(&self) -> StringSlice {
        return unsafe({ .origin = self.data.ptr, .start = self.data.ptr as *raw Shared<UInt8> as *raw UInt8 as &UInt8, .length = self.data.size } as StringSlice);
    }

    pub fn slice(&self, start: UInt) -> StringSlice {
        if start > self.data.size {
            let len = self.len();
            let msg = f"Index out of bounds in String::slice method. start: $(start), len: $(len)";
            panic msg.as_str().deref();
        }
        if !self.is_char_boundary_at(start) {
            panic("index is not a UTF-8 char boundary in String::slice");
        }
        let old_start = self.data.ptr as *raw Shared<UInt8> as *raw UInt8;
        let new_start = unsafe(old_start + start);
        return unsafe({ .origin = self.data.ptr, .start = new_start as &UInt8, .length = self.data.size - start } as StringSlice);
    }

    pub fn slice(&self, start: UInt, len: UInt) -> StringSlice {
        // 先判 start 再判 len, 避免 `start + len` 回绕; 字符边界检查与 insert 保持一致。
        if start > self.data.size || len > self.data.size - start {
            panic("Index out of bounds in String::slice method.");
        }
        if !self.is_char_boundary_at(start) || !self.is_char_boundary_at(start + len) {
            panic("index is not a UTF-8 char boundary in String::slice");
        }
        let old_start = self.data.ptr as *raw Shared<UInt8> as *raw UInt8;
        let new_start = unsafe(old_start + start);
        return unsafe({ .origin = self.data.ptr, .start = new_start as &UInt8, .length = len } as StringSlice);
    }

    pub fn push_str(&mut self, s: Str) {
        self.data.extend_from_slice(s.as_bytes());
    }

    pub fn push(&mut self, byte: UInt8) {
        self.data.push(byte);
    }

    fn is_char_boundary_at(&self, idx: UInt) -> Bool {
        if idx > self.len() {
            return false;
        }
        if idx == 0 || idx == self.len() {
            return true;
        }
        let b = self.index(idx);
        return b.bit_and(0xC0_u8) != 0x80_u8;
    }

    fn encode_utf8_char(ch: Char, buf: &mut Vec<UInt8>) {
        let cp = ch as UInt32;
        if cp <= 0x7F_u32 {
            buf.push(cp as UInt8);
        } else if cp <= 0x7FF_u32 {
            buf.push((0xC0_u32.bit_or(cp.bit_shr(6_u32))) as UInt8);
            buf.push((0x80_u32.bit_or(cp.bit_and(0x3F_u32))) as UInt8);
        } else if cp <= 0xFFFF_u32 {
            buf.push((0xE0_u32.bit_or(cp.bit_shr(12_u32))) as UInt8);
            buf.push((0x80_u32.bit_or((cp.bit_shr(6_u32)).bit_and(0x3F_u32))) as UInt8);
            buf.push((0x80_u32.bit_or(cp.bit_and(0x3F_u32))) as UInt8);
        } else {
            buf.push((0xF0_u32.bit_or(cp.bit_shr(18_u32))) as UInt8);
            buf.push((0x80_u32.bit_or((cp.bit_shr(12_u32)).bit_and(0x3F_u32))) as UInt8);
            buf.push((0x80_u32.bit_or((cp.bit_shr(6_u32)).bit_and(0x3F_u32))) as UInt8);
            buf.push((0x80_u32.bit_or(cp.bit_and(0x3F_u32))) as UInt8);
        }
    }

    pub fn push_char(&mut self, ch: Char) {
        Self::encode_utf8_char(ch, &mut self.data);
    }


    pub fn index<'a>(&'a self, idx: UInt) -> UInt8 {
        if idx >= self.len() {
            let len = self.len();
            let msg = f"Index out of bounds in String::index method. start: $(idx), len: $(len)";
            panic msg.as_str().deref();
        }
        let c = unsafe(self.data.ptr as *raw Shared<UInt8> as *raw UInt8 + idx);
        return unsafe(*c);
    }

    pub fn insert(&mut self, idx: UInt, ch: Char) {
        if !self.is_char_boundary_at(idx) {
            panic("index is not a UTF-8 char boundary in String::insert");
        }
        let mut encoded = (type Vec<UInt8>)::new();
        Self::encode_utf8_char(ch, &mut encoded);
        let mut i = encoded.len();
        while i > 0 {
            i -= 1;
            let b = unsafe(*encoded.get_unchecked(i));
            self.data.insert(idx, b);
        }
    }

    pub fn insert_byte(&mut self, idx: UInt, b: UInt8) {
        self.data.insert(idx, b);
    }

    pub fn insert_str(&mut self, idx: UInt, s: Str) {
        if !self.is_char_boundary_at(idx) {
            panic("index is not a UTF-8 char boundary in String::insert_str");
        }
        let mut i = s.len();
        while i > 0 {
            i -= 1;
            self.data.insert(idx, s.index(i));
        }
    }

    pub fn reserve(&mut self, additional: UInt) {
        self.data.reserve(additional);
    }

    pub fn reverse(&mut self) {
        self.data.reverse(); // 这个不对，要根据 utf8 编码来实现
    }

    pub fn clear(&mut self) {
        self.data.clear();
    }

    pub fn starts_with(&self, prefix: Str) -> Bool {
        if prefix.length > self.data.size {
            return false;
        }
        let mut i: UInt = 0_u;
        while i < prefix.length {
            let c1 = unsafe(self.data.get_unchecked(i));
            let c2 = unsafe(prefix.pointer as *raw UInt8 + i);
            if unsafe(*c1 != *c2) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    pub fn ends_with(&self, suffix: Str) -> Bool {
        if suffix.length > self.data.size {
            return false;
        }
        let start = self.data.size - suffix.length;
        let mut i: UInt = 0_u;
        while i < suffix.length {
            let c1 = unsafe(self.data.get_unchecked(start + i));
            let c2 = unsafe(suffix.pointer as *raw UInt8 + i);
            if unsafe(*c1 != *c2) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
}

impl ToString for String {
    fn to_string_inplace(&self, buf: &mut String) {
        buf.push_str(self.as_str().deref());
    }

    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

impl PartialEq for String {
    fn eq(&self, other: &Self) -> Bool {
        if self.len() != other.len() {
            return false;
        }
        let mut i: UInt = 0;
        while i < self.data.size {
            let c1 = unsafe(self.data.get_unchecked(i));
            let c2 = unsafe(other.data.get_unchecked(i));
            if unsafe(*c1 != *c2) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn ne(&self, other: &Self) -> Bool {
        return !self.eq(other);
    }
}

impl Eq for String {}

impl Clone for String {
    // String 是 24 字节 (Vec<UInt8>), 和 trait 声明 `-> Self` 一样按 sret 返回,
    // 所以 vtable 上直连这个方法即可 (codegen 会自动判断 ABI 是否一致)。
    fn clone(&self) -> Self {
        return { .data = self.data.clone() }: String;
    }
}

impl Hash for String {
    fn hash(&self, state: &mut Hasher) {
        let mut hash: UInt64 = 1469598103934665603_u64; // FNV-1a 64-bit offset basis
        let prime: UInt64 = 1099511628211_u64; // FNV-1a 64-bit prime
        let mut i: UInt = 0;
        while i < self.data.size {
            let c = unsafe(self.data.get_unchecked(i));
            let a = *c as UInt64;
            hash = hash.bit_xor(a);
            hash = hash * prime;
            i = i + 1;
        }
        state.combine(hash);
    }
}

pub struct StringSlice<'a> {
    origin: *Shared<UInt8>,
    start: &'a UInt8,
    length: UInt,
}

impl Deref for String {
    type Target<'t> = StringSlice<'t>;

    fn deref<'a>(&'a self) -> StringSlice<'a> {
        return self.as_str();
    }
}

impl<'a> Deref for StringSlice<'a> {
    type Target<'t> = Str<'t>;

    fn deref(&self) -> Str<'a> {
        return unsafe({ .pointer = self.start, .length = self.length }: Str);
    }
}

// 支持 slice 切片
impl<'a> StringSlice<'a> {
    // 直接提供 len/is_empty: 方法调用不会自动 Deref 到 Str, 没有这两个函数时
    // 调用方必须写 v.deref().len()。
    pub fn len(&self) -> UInt {
        return self.length;
    }

    pub fn is_empty(&self) -> Bool {
        return self.length == 0;
    }

    fn is_char_boundary_at(&self, idx: UInt) -> Bool {
        if idx > self.length {
            return false;
        }
        if idx == 0 || idx == self.length {
            return true;
        }
        let b = unsafe(*(self.start as *raw UInt8 + idx));
        return b.bit_and(0xC0_u8) != 0x80_u8;
    }

    pub fn slice(&self, start: UInt) -> StringSlice {
        if start > self.length {
            let len = self.length;
            let msg = f"Index out of bounds in StringSlice::slice method. start: $(start), len: $(len)";
            panic msg.as_str().deref();
        }
        if !self.is_char_boundary_at(start) {
            panic("index is not a UTF-8 char boundary in StringSlice::slice");
        }
        let old_start = self.start as *raw UInt8;
        let new_start = unsafe(old_start + start);
        return unsafe({ .origin = self.origin, .start = new_start as &UInt8, .length = self.length - start } as StringSlice);
    }

    pub fn slice(&self, start: UInt, len: UInt) -> StringSlice {
        // 同 String::slice: 先判 start 再判 len, 避免 `start + len` 回绕。
        if start > self.length || len > self.length - start {
            panic("Index out of bounds in StringSlice::slice method.");
        }
        if !self.is_char_boundary_at(start) || !self.is_char_boundary_at(start + len) {
            panic("index is not a UTF-8 char boundary in StringSlice::slice");
        }
        let old_start = self.start as *raw UInt8;
        let new_start = unsafe(old_start + start);
        return unsafe({ .origin = self.origin, .start = new_start as &UInt8, .length = len } as StringSlice);
    }
}

impl<'a> ToString for StringSlice<'a> {
    fn to_string_inplace(&self, buf: &mut String) {
        let str: Str = self.deref();
        buf.push_str(str);
    }
    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

