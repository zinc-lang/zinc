
pub trait Iterator {
    type Item;

    // non-virtual
    fn next<'a>(&'a mut self) -> Option<&'a Self::Item>;
}

pub trait Iterable {
    type Iter<'i>; // 需要约束 Iter<'i> : Iterator

    // non-virtual
    fn iter<'a>(&'a self) -> Self::Iter<'a>;

}

