// 它是引用语义, non-Send non-Sync 的
pub struct VecSlice<'s, T> {
    origin: *Shared<T>,
    total_size: UInt,
    start: &'s T,
    size: UInt,
}

impl<'a, T> Deref for VecSlice<'a, T> {
    type Target<'t> = Slice<'t, T>;

    fn deref<'s>(&'s self) -> Slice<'s, T> {
        return {
            .pointer = self.start,
            .length = self.size,
        }: Slice<'s, T>;
    }
}