
// 这个版本的 hashmap 使用 robin hood 算法实现。
// 等后续 SIMD 支持完成, 再改用 swisstable 实现。
use ::self::cmp::Eq;
use ::self::hash::Hash;
use ::self::hash::default_hasher;
use ::self::collections::vec::VecIter;

pub struct HashMap<K, V> {
    table: Vec<Entry<K, V>>,
    size: UInt,
}

// 载荷形状: Occupied((K, V), UInt)。把 key/value 包成**真元组**紧挨着放, 后面才是
// 探测距离 (DIB)。这样迭代器拿到的 `&(K, V)` 是指向真实对象的引用, 不再需要
// `k as &K as *raw (K, V)` 那种"按前缀偏移重解释"的布局强转 —— 那种强转在对抗性
// 对齐的 (K,V) 尺寸组合下会把相邻字段读进来 (见 tests/std/collections/run-pass/
// hashmap_iter_adversarial_align.zn)。
pub enum Entry<K, V> {
    Occupied((K, V), UInt),
    Vacant,
    Tombstone,
}

// HashMap 的表缓冲区元素类型是 Entry<K, V>, 而 slice.zn 里的 ItemRef/ItemRefMut 是
// 按 T 的尺寸和析构函数遍历缓冲区的 (它们服务的是 Vec<T>)。HashMap::get/get_mut/or_insert
// 直接复用它们时, 句柄的 T 只是 V, 与缓冲区实际的元素布局不一致: 一旦句柄成为旧表的
// 最后一个强引用 (借出句柄后 map 触发 COW 换表), 归还句柄就会按 V 的布局逐个
// destruct_in_place 一整片 Entry<K, V>, 对 Entry 内存做非法析构 (SIGSEGV / UAF)。
//
// 所以这里为 HashMap 单独提供一对句柄: 类型参数带上 K, Drop 里显式按
// Entry<K, V> 析构 (类型参数已知, 尺寸与析构函数都正确), 语义与原句柄一致。
pub struct HashMapItemRef<'a, K, V> {
    ptr: *(),
    size: UInt, // 归还句柄时需要析构的元素个数 = table.len(); 0 表示不负责元素析构
    item: &'a V, // 这里也可以用裸指针，但是从使用的角度来看，借用更合理
}

impl<'a, K, V> Deref for HashMapItemRef<'a, K, V> {
    type Target<'t> = &'t V;

    fn deref(&self) -> &V {
        return unsafe(self.item as &V);
    }
}

impl<'a, K, V> Drop for HashMapItemRef<'a, K, V> {
    fn drop(&mut self) {
        // 只有自己是最后一个强引用时才遍历元素; 否则 (count != 1) 容器/其它句柄还在用
        // 这份缓冲区, 元素归它们负责。
        if (::self::ptr::is_unique(&self.ptr)) {
            unsafe {
                // 缓冲区首地址就是元素基址 (Vec::ptr 指向元素区起点, 分配头在它之前),
                // 元素个数用构造句柄时快照下来的 size (缓冲区冻结, 该值不变)。
                let mut i: UInt = 0;
                while (i < self.size) {
                    let item: *raw mut Entry<K, V> = (self.ptr as *raw () as *raw mut Entry<K, V>) + i;
                    ::self::intrinsic::destruct_in_place(item); // 析构, 包括间接内存释放
                    i += 1;
                }
                self.size = 0;
            }
        }
    }
}

// HashMapItemRef 的可变版本, 规则与 HashMapItemRef 完全对称; 通过 DerefMut<V> 直接修改值。
pub struct HashMapItemRefMut<'a, K, V> {
    ptr: *(),
    size: UInt, // 归还句柄时需要析构的元素个数 = table.len(); 0 表示不负责元素析构
    item: &'a mut V,
}

impl<'a, K, V> Deref for HashMapItemRefMut<'a, K, V> {
    type Target<'t> = &'t V;

    fn deref(&self) -> &V {
        return unsafe(self.item as &V);
    }
}

impl<'a, K, V> DerefMut for HashMapItemRefMut<'a, K, V> {
    type TargetMut<'t> = &'t mut V;

    fn deref_mut(&mut self) -> &mut V {
        return unsafe(self.item as &mut V);
    }
}

impl<'a, K, V> Drop for HashMapItemRefMut<'a, K, V> {
    fn drop(&mut self) {
        if (::self::ptr::is_unique(&self.ptr)) {
            unsafe {
                let mut i: UInt = 0;
                while (i < self.size) {
                    let item: *raw mut Entry<K, V> = (self.ptr as *raw () as *raw mut Entry<K, V>) + i;
                    ::self::intrinsic::destruct_in_place(item);
                    i += 1;
                }
                self.size = 0;
            }
        }
    }
}

// todo: K 的约束条件不应该写到类型定义这里, 应该写到构造函数那里
// 构造函数应该提供多种重载形式：
// fn new() -> Self where K: Eq + Hash {}  如果 K 满足约束, 构造函数就把 K 类型实现的 trait 里面的函数, 保存到成员变量里面去, 其它函数用这些函数指针
// fn new(hash_fn: *HashFn<K>) -> Self {}  如果 K 不满足约束, 就要求用户把 eq/hash 函数通过构造函数传递进去, 也保存到成员变量里面, 供其它函数使用
// 在 get/contains 函数上一律不应该有泛型约束。
// 按 Zinc 的设计思路, Hasher/Allocator 这种 trait 一定不能做成泛型参数搞 static dispatch, 而应该学 C++ 的 pmr 的设计思路用 dynamic dispatch
impl<K, V> HashMap<K, V> where K: Eq + Hash {

    pub fn new() -> Self {
        return Self::with_capacity(7);
    }

    pub fn with_capacity(cap: UInt) -> Self {
        let mut table = (type Vec<Entry<K, V>>)::with_capacity(cap);
        let mut i: UInt = 0;
        while (i < cap) {
            table.push((type Entry<K,V>)::Vacant);
            i += 1;
        }
        return {
            .table = move table,
            .size = 0,
        }: HashMap<K, V>;
    }

    pub fn len(&self) -> UInt {
        return self.size;
    }

    pub fn is_empty(&self) -> Bool {
        return self.size == 0;
    }

    pub fn capacity(&self) -> UInt {
        return self.table.len();
    }

    pub fn ref_count(&self) -> UShort {
        return self.table.ref_count();
    }

    fn ideal_index(&self, key: &K) -> UInt {
        let mut hasher = default_hasher();
        key.hash(&mut hasher);
        return (hasher.finish() as UInt) % self.table.len();
    }

    fn probe_distance(&self, key: &K, index: UInt) -> UInt {
        let ideal_index = self.ideal_index(key);
        if (index >= ideal_index) {
            return index - ideal_index;
        } else {
            return index + self.table.len() - ideal_index;
        }
    }

    fn resize(&mut self) {
        let mut new_capacity = self.table.len() * 2 + 1;
        if new_capacity < 7 {
            new_capacity = 7;
        }
        let mut new_table = Self::with_capacity(new_capacity);

        for entry in self.table {
            if entry is Entry::Occupied(kv, _) {
                let (key, value) = kv;
                new_table.insert(move key, move value);
            }
        }

        self.table = new_table.table;
        self.size = new_table.size;
    }

    pub fn insert(&mut self, key: K, value: V) -> Option<V> {
        if self.table.len() == 0 {
            self.resize();
        } else if ((self.size as F64 / self.table.len() as F64) > 0.75) {
            self.resize();
        }
        self.table.to_unique();

        let cap = self.table.len();
        let mut index: UInt = self.ideal_index(&key);
        let mut distance: UInt = 0;
        let mut hole: Option<UInt> = None;
        let mut hole_distance: UInt = 0;

        // 第一趟: 找已有 key; 同时记下第一个可复用的 Tombstone/Vacant。
        // 绝不能一碰到 Tombstone 就写入, 否则探测链后方的同一 key 会变成重复条目。
        //
        // ref 模式只在 unsafe match 里被旧 seed 接受 (见第 3 项 3.1 的有意设计);
        // 而且旧 seed 的 `match` 只能作语句、不能作产生值的表达式, 所以这里用
        // “match + break/continue + 循环外判断”的写法, 而不是 `let x = match ...`。
        unsafe {
            while distance < cap {
                let entry = self.table.get_unchecked_mut(index);
                match entry {
                    Entry::Occupied(ref kv, ref existing_distance) => {
                        let existing_key: &K = &kv.0;
                        let existing_value: &V = &kv.1;
                        if existing_key.eq(&key) {
                            let distance = *existing_distance;
                            let old_value = *existing_value;
                            *entry = Entry::Occupied((move key, move value), distance);
                            return Some(move old_value);
                        }
                    }
                    _ => {
                        if hole is None {
                            hole = Some(index);
                            hole_distance = distance;
                        }
                    }
                }
                if entry is Entry::Vacant {
                    break;
                }

                distance += 1;
                index = (index + 1) % cap;
            }
        }

        if hole is Some(place) {
            // Robin Hood 从 hole 起继续向前排空槽; 简单起见直接写入第一个 hole。
            let entry = unsafe(self.table.get_unchecked_mut(place));
            *entry = Entry::Occupied((move key, move value), hole_distance);
            self.size += 1;
            return None;
        }

        self.resize();
        return self.insert(move key, move value);
    }

    pub fn to_unique(&mut self) {
        self.table.to_unique();
    }

    // todo 参数类型应该更灵活一些, 比如 String 作为 Key 的时候应该允许用 Str 做查询
    pub fn get<'a>(&'a self, key: &K) -> Option<HashMapItemRef<'a, K, V>> {
        if self.size == 0 {
            return None;
        }

        let mut index = self.ideal_index(key);
        let mut distance: UInt = 0;

        unsafe {
            while distance < self.table.len() {
                let entry = self.table.get_unchecked(index);
                match entry {
                    Entry::Occupied(ref kv, _) => {
                        if (kv.0.eq(key)) {
                            return Some({
                                .ptr = self.table.ptr as *(),
                                .size = self.table.len(),
                                .item = &kv.1,
                            } : HashMapItemRef<'a, K, V>);
                        }
                    }
                    Entry::Vacant => return None;
                    Entry::Tombstone => {}
                }

                distance += 1;
                index = (index + 1) % self.table.len();
            }
        }
        return None;
    }

    pub fn get_mut<'a>(&'a mut self, key: &K) -> Option<HashMapItemRefMut<'a, K, V>> {
        if self.size == 0 {
            return None;
        }
        self.table.to_unique();

        let mut index = self.ideal_index(key);
        let mut distance: UInt = 0;

        unsafe {
            while distance < self.table.len() {
                match self.table.get_unchecked_mut(index) {
                    Entry::Occupied(ref mut kv, _) => {
                        if (kv.0.eq(key)) {
                            return Some({
                                .ptr = self.table.ptr as *(),
                                .size = self.table.len(),
                                .item = unsafe(&raw mut kv.1 as &mut V),
                            } : HashMapItemRefMut<'a, K, V>);
                        }
                    }
                    Entry::Vacant => return None;
                    Entry::Tombstone => {}
                }

                distance += 1;
                index = (index + 1) % self.table.len();
            }
        }
        return None;
    }

    pub fn at(&self, key: &K) -> Option<V> {
        match self.get(key) {
            Some(item_ref) => {
                let item: &V = item_ref.item;
                return Some(*item);
            }
            None => return None;
        }
    }

    pub fn or_insert<'a>(&'a mut self, key: K, default: V) -> HashMapItemRefMut<'a, K, V> {
        if self.table.len() == 0 {
            self.resize();
        } else if ((self.size as F64 / self.table.len() as F64) > 0.75) {
            self.resize();
        }
        self.table.to_unique();

        let cap = self.table.len();
        let mut index = self.ideal_index(&key);
        let mut distance: UInt = 0;
        let mut hole: Option<UInt> = None;

        unsafe {
            while distance < cap {
                match self.table.get_unchecked_mut(index) {
                    Entry::Occupied(ref mut kv, _) => {
                        if (kv.0.eq(&key)) {
                            // key 已存在: 本次传入的 key 与 default 都不会被使用。
                            // 它们只在下面的插入分支里被 move; 这条提前返回的路径上没有被
                            // move, 由编译器按 drop flag 在函数返回前自动析构 (形参的 drop
                            // flag 在入口处初始化为 true)。这里**不要**再显式析构, 否则会
                            // 和编译器插入的析构重复, 造成 double free。
                            // (历史: 编译器曾经不给"条件 move 的形参"插入析构, 这里用
                            //  destruct_in_place 绕过; 编译器修好后已移除。)
                            return {
                                .ptr = self.table.ptr as *(),
                                .size = self.table.len(),
                                .item = unsafe(&raw mut kv.1 as &mut V),
                            }: HashMapItemRefMut<'a, K, V>;
                        }
                    }
                    Entry::Vacant => {
                        if hole is None {
                            hole = Some(index);
                        }
                        break;
                    }
                    Entry::Tombstone => {
                        if hole is None {
                            hole = Some(index);
                        }
                    }
                }

                distance += 1;
                index = (index + 1) % cap;
            }

            if hole is None {
                self.resize();
                return self.or_insert(move key, move default);
            }

            let place = hole.get_or_panic();
            let place_distance = self.probe_distance(&key, place);
            *self.table.get_unchecked_mut(place) = Entry::Occupied((move key, move default), place_distance);
            self.size += 1;
            match self.table.get_unchecked_mut(place) {
                Entry::Occupied(ref mut kv, _) => {
                    return {
                        .ptr = self.table.ptr as *(),
                        .size = self.table.len(),
                        .item = unsafe(&raw mut kv.1 as &mut V),
                    }: HashMapItemRefMut<'a, K, V>;
                }
                _ => {
                    panic "BUG: HashMap::or_insert failed to insert";
                }
            }
        }
    }


    pub fn contains(&self, key: &K) -> Bool {
        if self.size == 0 {
            return false;
        }

        let mut index = self.ideal_index(key);
        let mut distance: UInt = 0;

        unsafe {
            while distance < self.table.len() {
                match self.table.get_unchecked(index) {
                    Entry::Occupied(ref kv, _) => {
                        if (kv.0.eq(key)) {
                            return true;
                        }
                    }
                    Entry::Vacant => return false;
                    _ => {}
                }

                distance += 1;
                index = (index + 1) % self.table.len();
            }
        }
        return false;
    }

    pub fn remove(&mut self, key: &K) -> Option<V> {
        if self.size == 0 {
            return None;
        }

        self.table.to_unique();

        let mut index = self.ideal_index(key);
        let mut distance: UInt = 0;
        let cap = self.table.len();

        unsafe {
            while distance < cap {
                let entry = self.table.get_unchecked_mut(index);
                // ref 模式只在 unsafe match 里被旧 seed 接受 (见第 3 项 3.1 的设计),
                // 且旧 seed 的 match 只能作语句, 故在 arm 里直接完成删除并 return。
                match entry {
                    Entry::Occupied(ref kv, _) => {
                        if kv.0.eq(key) {
                            let value = kv.1;
                            *entry = Entry::Tombstone;
                            self.size -= 1;
                            return Some(move value);
                        }
                    }
                    Entry::Vacant => {
                        return None;
                    }
                    _ => {}
                }

                distance += 1;
                index = (index + 1) % cap;
            }
        }
        return None;
    }

    pub fn merge(&mut self, other: &HashMap<K, V>) {
        self.to_unique();
        for entry in other.table {
            match entry {
                Entry::Occupied(kv, _) => {
                    let (k, v) = kv;
                    self.insert(move k, move v);
                }
                _ => {}
            }
        }
    }

    pub fn clear(&mut self) {
        self.size = 0;
        self.to_unique();
        self.table.clear();
    }

    pub fn keys(&self) -> Vec<K> {
        let mut res = (type Vec<K>)::with_capacity(self.size);
        for entry in self.table {
            // 这里只做字段读取 (不 move): 旧 seed 不允许对绑定变量做部分 move
            // (`move kv.0` 会报"这个表达式不能被 move"), 而模板参数 K 本身可复制。
            if entry is Entry::Occupied(kv, _) {
                res.push(kv.0);
            }
        }
        return res;
    }

    pub fn values(&self) -> Vec<V> {
        let mut res = (type Vec<V>)::with_capacity(self.size);
        for entry in self.table {
            if entry is Entry::Occupied(kv, _) {
                res.push(kv.1);
            }
        }
        return res;
    }

}

// todo 实现 traits
pub struct HashMapIter<'a, K, V> {
    vec_iter: VecIter<'a, Entry<K, V> >,
}

impl<'a, K, V> Iterator for HashMapIter<'a, K, V> {
    // 注意: 这里的 `Item = (K, V)` 是**公开 API**, 编译器源码也按它写。
    // H14 曾把它改成 `(&'a K, &'a V)` (并给迭代器加一个 `cur` 真元组字段),
    // 那是一次公开 API 变更: 改完之后必须**最后**刷新 seed, 否则编译器自身源码
    // 无法被旧 seed 编译。
    //
    // 当前 seed = `fc3d993d…`(bin/zinc) / `0c5a0bd4…`(lib/libstd.a) /
    // `fc958638…`(lib/std.zno), `out/stage0.zip` = `df4b80d4…`; 它正是由当前源码
    // 自举出来的同代产物, 所以上面那条约束不是"seed 太老"而是**流程**约束:
    // 改语言能力 / 公开 API / std 载荷时, 顺序必须是
    // **先改源码 → 用旧 seed 构建 → 最后才刷新 seed**
    // (根因与完整链条见 `docs/memory_layout.md` §4.2)。
    type Item = (K, V);

    fn next<'n>(&'n mut self) -> Option<&'n (K, V)> {
        while true {
            let r = self.vec_iter.next();
            if r is Some(entry) {
                unsafe {
                    // Entry::Occupied 的载荷就是真元组 (K, V): 直接借出这个对象,
                    // 不再做 `k as &K as *raw (K, V)` 的布局重解释强转。
                    match entry {
                        Entry::Occupied(ref kv, _) => {
                            return Some(&*kv);
                        }
                        _ => {
                            continue;
                        }
                    }
                }
            } else {
                return None;
            }
        }
        return None;
    }
}

impl<K, V> Iterable for HashMap<K, V> {
    type Iter<'i> = HashMapIter<'i, K, V>;

    fn iter<'a>(&'a self) -> HashMapIter<'a, K, V> {
        // 注意: 必须先把 VecIter 放进局部变量, 再用 `move` 装进结构体字面量。
        // 直接写 `.vec_iter = self.table.iter()` (或包一层括号) 时, codegen 会走
        // "临时量 + VecIter.copyfn" 的路径, 而 VecIter 带 Drop: copyfn 里的 retain
        // 没有配对的 release, 每构造一次迭代器就泄漏一个表强引用 —— ref_count 每次
        // +1, 迭代后表再也回不到独占, 缓冲区元素不会被析构 (整张表泄漏)。
        // 经局部变量 + move 是纯 move (实测不再调用 copyfn)。
        let mut it = self.table.iter();
        return { .vec_iter = move it }: HashMapIter<K, V>;
    }
}
