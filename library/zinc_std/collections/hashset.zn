use ::self::cmp::Eq;
use ::self::hash::Hash;
use ::self::hash::default_hasher;
use ::self::primitives::slice::ItemRef;
use ::self::primitives::slice::ItemRefMut;
use ::self::collections::vec::VecIter;

use super::hashmap::*;

// HashSet 是 HashMap<T, ()>。T = UInt 的 Hash/Eq 没问题; 以前 liveness 卡死是
// HashMap 墓碑探测死循环 / insert 占墓碑导致重复 key, 见 hashmap.zn。

pub struct HashSet<T> {
    map: HashMap<T, ()>,
}

impl<T> HashSet<T> where T: Eq + Hash {

    pub fn new() -> Self {
        return {
            .map = (type HashMap<T, ()>)::new(),
        }: HashSet<T>;
    }

    pub fn with_capacity(cap: UInt) -> Self {
        return {
            .map = (type HashMap<T, ()>)::with_capacity(cap),
        }: HashSet<T>;
    }

    pub fn len(&self) -> UInt {
        return self.map.len();
    }

    pub fn ref_count(&self) -> UShort {
        return self.map.ref_count();
    }

    pub fn to_unique(&mut self) {
        self.map.to_unique();
    }

    pub fn insert(&mut self, value: T) -> Bool {
        let prev_size = self.map.size;
        self.map.insert(move value, ());
        return self.map.size > prev_size;
    }

    pub fn clear(&mut self) {
        self.map.clear();
    }

    pub fn contains(&self, value: &T) -> Bool {
        return self.map.contains(value);
    }

    pub fn remove(&mut self, value: &T) -> Bool {
        let prev_size = self.map.size;
        self.map.remove(value);
        return self.map.size < prev_size;
    }

    pub fn keys(&self) -> Vec<T> {
        let mut res = (type Vec<T>)::with_capacity(self.len());
        for entry in self.map.table {
            // 只做字段读取 (不 move): 旧 seed 不允许对绑定变量做部分 move。
            if entry is Entry::Occupied(kv, _) {
                res.push(kv.0);
            }
        }
        return res;
    }
}

pub struct HashSetIter<'a, T> {
    vec_iter: VecIter<'a, Entry<T, ()> >,
}

impl<'a, T> Iterator for HashSetIter<'a, T> {
    type Item = T;

    fn next<'n>(&'n mut self) -> Option<&'n T> {
        while true {
            let r = self.vec_iter.next();
            if r is Some(entry) {
                unsafe {
                    // 载荷是真元组 (T, ()): 借出真实对象的第 0 个字段, 不再做强转。
                    match entry {
                        Entry::Occupied(ref kv, _) => {
                            let ptr = unsafe(&kv.0 as &T);
                            return Some(ptr);
                        }
                        _ => {
                            continue;
                        }
                    }
                }
            } else {
                return None;
            }
        }
        return None;
    }
}

impl<T> Iterable for HashSet<T> {
    type Iter<'i> = HashSetIter<'i, T>;

    fn iter<'a>(&'a self) -> HashSetIter<'a, T> {
        // 与 HashMap::iter 同样的原因: 先落局部变量再 move, 否则走
        // "临时量 + VecIter.copyfn" 路径, retain 泄漏 (见 hashmap.zn 的注释)。
        let mut it = self.map.table.iter();
        return { .vec_iter = move it }: HashSetIter<T>;
    }
}