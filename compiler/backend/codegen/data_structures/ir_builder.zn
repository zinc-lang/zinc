    }

    fn phi_add_incoming(&self, phi: CgValue, v: CgValue, bb: CgBasicBlock) {
        unsafe(llds_phi_add_incoming(phi.value, v.value, bb.bb));
    }

    fn create_insert_value(&self, agg: CgValue, val: CgValue, idx: UInt) -> CgValue {
        let v = unsafe(llds_create_insert_value(self.ds, agg.value, val.value, idx));
        return { .value = v, .indirect = false, }: CgValue;
    }

    fn create_di_file(&self, name: Str) -> Ptr {
        return unsafe(llds_create_di_file(self.ds, name.raw_ptr(), name.len()));
    }

    fn create_di_subprogram(&self, f: CgFunc, short_name: Str, dif: Ptr, line: UInt32) -> Ptr {
        let mut sname = short_name.to_string();
        sname.push(0_u8);

        return unsafe(llds_create_di_subprogram(self.ds, f.llfn, sname.raw_ptr(), dif, line));
    }

    fn create_di_location(&self, f: CgFunc, line: UInt32, column: UInt32) -> Ptr {
        return unsafe(llds_create_di_location(self.ds, f.llfn, line, column));
    }

    fn set_di_loc(&self, di_loc: Ptr) {
        unsafe(llds_set_di_loc(self.ds, di_loc));
    }

    fn reset_di_loc(&self) {
        unsafe(llds_set_di_loc(self.ds, unsafe(0_u as *raw UInt8)));
    }
}
