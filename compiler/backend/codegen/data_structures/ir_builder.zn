impl LLDataStructures {

    fn create_fn(&self, ty: CgFuncType, name: Str) -> CgFunc {
        let ll_fn = unsafe(llds_create_function(self.ds, name.raw_ptr(), name.len(), ty.llfnty));
        return {
            .llfn = ll_fn
        }: CgFunc;
    }

    fn verify_function(&self, f: CgFunc) -> Bool {
        return unsafe(llds_verify_function(f.llfn));
    }

    fn set_ip_for_instantiate(&self, f: CgFunc) {
        unsafe(llds_set_ip_for_instantiate(self.ds, f.llfn));
    }

    fn set_insert_point(&self, bb: CgBasicBlock) {
        unsafe{
            llds_set_insert_point(self.ds, bb.bb);
        }
    }

    fn save_ip(&self) -> Ptr {
        return unsafe(llds_save_ip(self.ds));
    }

    fn restore_ip(&self, ip: Ptr) {
        return unsafe(llds_restore_ip(self.ds, ip));
    }

    fn get_arg(&self, func: CgFunc, i: UInt) -> CgValue {
        unsafe {
            let a = llds_get_arg(func.llfn, i);
            return {
                .value = a,
                .indirect = false,
            }: CgValue;
        }
    }

    fn set_arg_name(&self, func: CgFunc, i: UInt, name: Str) {
        unsafe {
            llds_set_arg_name(func.llfn, i, name.raw_ptr(), name.len());
        }
    }

    fn create_bb(&self, name: Str, func: CgFunc) -> CgBasicBlock {
        unsafe {
            let bb = llds_create_basicblock(self.ds, name.raw_ptr(), name.len(), func.llfn);
            return {
                .bb = bb,
            }: CgBasicBlock;
        }
    }

    fn create_do_nothing(&self) {
        unsafe(llds_create_do_nothing(self.ds));
    }

    fn create_struct_gep(&self, ty: CgType, val: CgValue, idx: UInt) -> CgValue {
        unsafe {
            // FIXME, size.value 要视情况 load
            let v = llds_create_struct_gep(self.ds, ty.llty, val.value, idx);
            return {
                .value = v,
                .indirect = true,
            }: CgValue;
        }
    }

    fn create_gep(&self, ty: CgType, val: CgValue, idx: CgValue) -> CgValue {
        unsafe {
            let v = llds_create_gep(self.ds, ty.llty, val.value, idx.value);
            return {
                .value = v,
                .indirect = true,
            }: CgValue;
        }
    }

    fn extract_value(&self, val: CgValue, idx: UInt) -> CgValue {
        unsafe {
            let v = llds_extract_value(self.ds, val.value, idx);
            return {
                .value = v,
                .indirect = false,
            }: CgValue;
        }
    }

    fn create_alloca_sized(&self, ty: CgType) -> CgValue {
        unsafe {
            let v = llds_create_alloca_sized(self.ds, ty.llty);
            return {
                .value = v,
                .indirect = true,
            }: CgValue;
        }
    }

    fn create_alloca_unsized(&self, size: CgValue) -> CgValue {
        unsafe {
            let v = llds_create_alloca_unsized(self.ds, size.value);
            return {
                .value = v,
                .indirect = true,
            }: CgValue;
        }
    }

    fn create_store(&self, val: CgValue, place: CgValue) {
        unsafe(llds_create_store(self.ds, val.value, place.value));
    }

    fn create_load(&self, ty: CgType, ptr: CgValue) -> CgValue {
        let v = unsafe(llds_create_load(self.ds, ty.llty, ptr.value));
        return {
            .value = v,
            .indirect = false,
        }: CgValue;
    }

    fn create_memcpy(&self, dst: CgValue, src: CgValue, size: CgValue) {
        unsafe(llds_create_memcpy(self.ds, dst.value, src.value, size.value));
    }

    fn create_memset(&self, dst: CgValue, val: CgValue, count: CgValue) {
        unsafe(llds_create_memset(self.ds, dst.value, val.value, count.value));
    }


    fn create_br(&self, bb: CgBasicBlock) {
        unsafe(llds_create_br(self.ds, bb.bb));
    }

    fn create_cond_br(&self, cond: CgValue, target_true: CgBasicBlock, target_false: CgBasicBlock) {
        // FIXME, cond 要视情况 load
        unsafe(llds_create_cond_br(self.ds, cond.value, target_true.bb, target_false.bb));
    }

    fn create_ret(&self, v: CgValue) {
        // FIXME, v 要视情况 load
        unsafe(llds_create_ret(self.ds, v.value));
    }

    fn create_retvoid(&self) {
        unsafe(llds_create_retvoid(self.ds));
    }

    fn create_unreachable(&self) {
        unsafe(llds_create_unreachable(self.ds));
    }

    fn create_call(&self, func: CgFunc, args: Slice<CgValue>) -> CgValue {
        let mut llargs = (type Vec<Ptr>)::new();
        for a in args {
            llargs.push(a.value);
        }
        let v = unsafe(llds_create_call(self.ds, func.llfn, llargs.raw_ptr(), llargs.len()));
        return {
            .value = v,
            .indirect = false,
        }: CgValue;
    }

    fn create_call(&self, fnty: CgFuncType, func: CgValue, args: Slice<CgValue>) -> CgValue {
        let mut llargs = (type Vec<Ptr>)::new();
        for a in args {
            llargs.push(a.value);
        }
        let v = unsafe(llds_create_call_with_fnty(self.ds, fnty.llfnty, func.value, llargs.raw_ptr(), llargs.len()));
        return {
            .value = v,
            .indirect = false,
        }: CgValue;
    }

    fn create_fat_ptr(&self, p1: CgValue, p2: CgValue, p3: CgValue) -> CgValue {
        let v = unsafe(llds_create_fat_ptr(self.ds, p1.value, p2.value, p3.value));
        return {
            .value = v,
            .indirect = false,
        }: CgValue;
    }

    fn create_ptr_to_int(&self, ptr: CgValue) -> CgValue {
        unsafe {
            let v = llds_create_ptr_to_int(self.ds, ptr.value);
            return {
                .value = v,
                .indirect = false,
            }: CgValue;
        }
    }

    fn create_int_to_ptr(&self, val: CgValue) -> CgValue {
        unsafe {
            let v = llds_create_int_to_ptr(self.ds, val.value);
            return {
                .value = v,
                .indirect = false,
            }: CgValue;
        }
    }

    fn create_zext(&self, val: CgValue, ty: CgType) -> CgValue {
        let v = unsafe(llds_create_zext(self.ds, val.value, ty.llty));
        return { .value = v, .indirect = false, }: CgValue;
    }

    fn create_sext_or_trunc(&self, val: CgValue, ty: CgType) -> CgValue {
        let v = unsafe(llds_create_sext_or_trunc(self.ds, val.value, ty.llty));
        return { .value = v, .indirect = false, }: CgValue;
    }

    fn create_zext_or_trunc(&self, val: CgValue, ty: CgType) -> CgValue {
