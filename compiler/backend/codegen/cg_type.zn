use super::*;
use super::data_structures::*;

use ::self::frontend::semantic::hir::ir::*;
use ::self::frontend::semantic::hir::checker::type_mapping::*;
use ::self::frontend::semantic::hir::checker::type_utils::*;

impl CodeGenerator {

    // 编译时未知大小的类型返回 None
    fn cgtype_of(&mut self, sty: *SType) -> Option<CgType> {
        let sty_addr = sty as *raw SType as UInt;
        if self.sty_to_cgty.at(&sty_addr) is Some(t) {
            return t;
        }

        let ty = self.calc_cgtype_of(move sty);
        self.sty_to_cgty.insert(sty_addr, ty);
        return ty;
    }

    fn size_of_stype(&mut self, sty: *SType, ctx: *CgContext) -> CgValue {
        if self.cgtype_of(sty) is Some(cgtype) {
            let s = self.llds.storage_size_of(cgtype);
            return self.llds.get_const_int64(s as UInt64).as_value();
        } else {
            if sty.type_symbol is lsym: *LambdaSymbol {
                // 没有捕获的闭包是空结构体 (有 CgType), 走到这里说明它带了捕获环境
                let name = lsym.mangle_name();
                let msg = f"BUG: 有捕获的闭包 ($(name)) 还不能作为值保存 (等 Fn/FnMut 支持)";
                panic msg.as_str().deref();
            }
            let tm = self.rt_typemeta_of(sty, ctx);
            return self.access_typemeta_size(tm);
        }
    }

    fn calc_cgtype_of(&mut self, sty: *SType) -> Option<CgType> {
        match sty.type_symbol {
            type *InvalidSymbol => panic;
            // 以下这些分支未实现或者是 UnSized
            type *TypeParamSymbol => return None;
            type *TraitSymbol => return None;
            // fn(A, B) -> C: 值就是一个函数指针 (LLVM 不透明指针, 函数类型在调用处构造)
            type *FnLowerTypeSymbol => return Some(self.llds.type_thin_ptr());
            type *FnUpperTypeSymbol => return None;
            type *FnUpperMutTypeSymbol => return None;
            type *ExternTypeSymbol => return None;
            lambda_sym: *LambdaSymbol => {
                // 闭包可以看成一个结构体: 有捕获时字段就是捕获进来的变量
                if lambda_sym.captures.is_empty() {
                    return Some(self.llds.type_empty_struct());
                }
                return Some(self.lambda_env_cgtype(move lambda_sym));
            }
            // 函数项也是独立的类型, 它不携带数据, 相当于空结构体 (和没有捕获的闭包一样)
            type *FuncSymbol => return Some(self.llds.type_empty_struct());

            assoc: *AssociatedTypeSymbol => {
                return self.cgtype_of(assoc.target_sty);
            }
            alias: *TypeAliasSymbol => return self.cgtype_of(alias.target_sty);

            // builtins
            type *BoolSymbol => return Some(self.llds.type_int1());
            type *CharSymbol => return Some(self.llds.type_int32());
            int_sym: *IntegerSymbol => {
                match int_sym.kind {
                    IntegerKind::I8 => return Some(self.llds.type_int8());
                    IntegerKind::I16 => return Some(self.llds.type_int16());
                    IntegerKind::I32 => return Some(self.llds.type_int32());
                    IntegerKind::I64 => return Some(self.llds.type_int64());
                    IntegerKind::Isize => return Some(self.llds.type_int64());
                    IntegerKind::Ishort => return Some(self.llds.type_int32());
                    IntegerKind::U8 => return Some(self.llds.type_int8());
                    IntegerKind::U16 => return Some(self.llds.type_int16());
                    IntegerKind::U32 => return Some(self.llds.type_int32());
                    IntegerKind::U64 => return Some(self.llds.type_int64());
                    IntegerKind::Usize => return Some(self.llds.type_int64());
                    IntegerKind::Ushort => return Some(self.llds.type_int32());
                }
            }
            float_sym: *FloatSymbol => {
                match float_sym.kind {
                    FloatKind::F32 => return Some(self.llds.type_f32());
                    FloatKind::F64 => return Some(self.llds.type_f64());
                }
            }

            // Compound
            struct_sym: *StructSymbol => {
                let mut mappings = TypeMapping::new();
                mappings.unify(struct_sym.to_sty(), sty);
                let mut elements: Vec<CgType> = (type Vec<CgType>)::new();
                for field in struct_sym.fields {
                    let actual_field_sty = mappings.subst(field.stype);
                    if self.cgtype_of(move actual_field_sty) is Some(t) {
                        elements.push(move t);
                    } else {
                        return None;
                    }
                }
                return Some(self.llds.type_struct(&elements));
            }
            enum_sym: *EnumSymbol => {
                // todo 目前的 tag 统一是 int64, 简化代码编写。这里显然有优化机会
                // Option 类型特殊处理
                if enum_sym.export_key().as_str().deref().eq(&"::std::primitives::option::Option") {
                    let arg = sty.args.ty_arg(0);
                    return self.calc_typeof_builtin_option(arg);
                }

                let mut mappings = TypeMapping::new();
                mappings.unify(enum_sym.to_sty(), sty);
                let mut payload_size: UInt = 0;
                for ev in enum_sym.variants {
                    let mut elements: Vec<CgType> = (type Vec<CgType>)::new();
                    for field in ev.fields {
                        let actual_field_sty = mappings.subst(field);
                        if self.cgtype_of(move actual_field_sty) is Some(t) {
                            elements.push(move t);
                        } else {
                            return None;
                        }
                    }
                    let struct_ty = self.llds.type_struct(&elements);
                    let ev_size = self.llds.storage_size_of(struct_ty);
                    if ev_size > payload_size {
                        payload_size = ev_size;
                    }
                }

                let payload = self.llds.type_byte_array(payload_size);
                let mut tag_and_payload = (type Vec<CgType>)::new();
                tag_and_payload.push(self.llds.type_int64());
                tag_and_payload.push(move payload);
                return Some(self.llds.type_struct(&tag_and_payload));
            }
            union_sym: *UnionSymbol => {
                let mut max_size: UInt = 0;
                for field in union_sym.fields {
                    if self.cgtype_of(field.stype) is Some(t) {
                        let field_size = self.llds.storage_size_of(t);
                        if field_size > max_size {
                            max_size = field_size;
                        }
                    } else {
                        return None;
                    }
                }
                return Some(self.llds.type_byte_array(max_size));
            }
            tuple_sym: *TupleSymbol => {
                let mut elements: Vec<CgType> = (type Vec<CgType>)::new();
                for field in sty.args.ty_args {
                    if self.cgtype_of(move field) is Some(t) {
                        elements.push(move t);
                    } else {
                        return None;
                    }
                }
                return Some(self.llds.type_struct(&elements));
            }
            array_sym: *ArraySymbol => {
                if sty.args.ty_args.is_empty() {
                    return Some(self.llds.type_empty_struct());
                }
                let elem_sty = sty.args.ty_arg(0);
                if self.cgtype_of(elem_sty) is Some(t) {
                    return Some(self.llds.type_array_of(t, sty.args.ty_args.len()));
                } else {
                    return None;
                }
            }

            // pointers
            type *PointerLikeSymbol => {
                let pointee = sty.args.ty_arg(0);
                if pointee.type_symbol is type *TraitSymbol ||
                    pointee.type_symbol is type *FnUpperTypeSymbol ||
                    pointee.type_symbol is type *FnUpperMutTypeSymbol {
                    return Some(self.llds.type_fat_ptr());
                } else {
                    return Some(self.llds.type_thin_ptr());
                }
            }

            _ => return Some(self.llds.type_empty_struct());
        }
    }

    fn can_option_niche_opt(&self, arg: *SType) -> Bool {
        let ty_sym = arg.type_symbol;
        if ty_sym is type *ArcPointerSymbol ||
            ty_sym is type *WeakPointerSymbol ||
            ty_sym is type *BorrowMutSymbol ||
            ty_sym is type *BorrowImmutSymbol {

            return true;
        } else {
            return false;
        }
    }

    // todo Niche 优化还能覆盖更多场景
    fn calc_typeof_builtin_option(&mut self, arg: *SType) -> Option<CgType> {
        let ty_sym = arg.type_symbol;
        if ty_sym is type *ArcPointerSymbol ||
            ty_sym is type *WeakPointerSymbol ||
            ty_sym is type *BorrowMutSymbol ||
            ty_sym is type *BorrowImmutSymbol {

            let pointee: *SType = arg.args.ty_arg(0);
            if pointee.type_symbol is type *TraitSymbol ||
                pointee.type_symbol is type *FnUpperTypeSymbol ||
                pointee.type_symbol is type *FnUpperMutTypeSymbol {
                return Some(self.llds.type_fat_ptr());
            } else {
                return Some(self.llds.type_thin_ptr());
            }
        } else {
            if self.cgtype_of(move arg) is Some(payload) {
                let mut tag_and_payload = (type Vec<CgType>)::new();
                tag_and_payload.push(self.llds.type_int64());
                tag_and_payload.push(move payload);
                return Some(self.llds.type_struct(&tag_and_payload));
            } else {
                return None;
            }
        }
    }

    // 取 TypeMeta / GenericArg 对应的 LLVM 实参。在 enum-pat helper 内时走 remap
    // (helper 自己的参数), 否则取当前函数参数 —— 跨函数直接引用 Argument 会校验失败。
    fn cg_typemeta_arg(&mut self, ctx: *CgContext, llvm_idx: UInt) -> CgValue {
        if ctx.pat_helper_arg_remap.at(&llvm_idx) is Some(v) {
            return v;
        }
        return self.llds.get_arg(ctx.ll_func, llvm_idx);
    }

    fn rt_typemeta_of(&mut self, sty: *SType, ctx: *CgContext) -> CgValue {
        // 编译侧的"全局 typemeta 缓存" (见本文件末尾 tmcache_* 的注释):
        // 上下文无关的实例化类型 (Option<Int> / Vec<String> / [Int; 4] ...) 的 TypeMeta
        // 只依赖编译期常量, 所以在模块内发射一个 internal 全局量, 在 component_init 里赋值,
        // 使用点直接 load 这个全局量 (没有分支、没有调用、没有运行时查表)。
        if self.sty_is_tmcacheable(sty) {
            let sty_int = sty as *raw SType as UInt;
            if ctx.cached_instantiated.at(&sty_int) is Some(v) {
                return v;
            }
            // 和原来的 instantiated_typemeta 一样, 把 load 提到函数入口基本块,
            // 保证它支配本函数里所有复用点
            let saved_insert_point = self.llds.save_ip();
            self.llds.set_ip_for_instantiate(ctx.ll_func);
            let result = self.tmcache_load(sty);
            ctx.cached_instantiated.insert(sty_int, result);
            self.llds.restore_ip(saved_insert_point);
            return result;
        }

        // (E3) 自引用短路: 若这个类型就是本函数的 Self 类型, 那么函数收到的
        // `$typemeta` 隐式实参**就是**它的 TypeMeta, 不必再运行期 instantiate 一次。
        // 这一步只复用已有实参: 不改 ABI、不改 .zno、不新增运行期状态。
        //
        // 守卫 (两层, 缺一不可):
        //   1) 签名里必须真的有 TypeMeta 形参 (闭包的签名没有; 不能在这里 panic,
        //      否则会把"闭包内 Self 查询"从原本的 BUG panic 提前成一个新 panic);
        //   2) canonical 后结构相等, 实参按 TypeParamSymbol 身份区分 (T != U)。
        if ctx.self_sty() is Some(self_sty) {
            if ctx.signature.index_of_typemeta_opt() is Some(tm_idx) {
                if stype_eq_regardless_lifetime(sty, self_sty) {
                    return self.cg_typemeta_arg(ctx, tm_idx);
                }
            }
        }

        match sty.type_symbol {
            assoc: *AssociatedTypeSymbol => {
                if assoc.is_self_ty() {
                    // 特殊处理 Self 类型, 从函数参数中获得
                    let idx = ctx.signature.index_of_typemeta();
                    return self.cg_typemeta_arg(ctx, idx);
                } else {
                    return self.rt_typemeta_of(sty.canonical(), ctx);
                }
            }
            alias: *TypeAliasSymbol => {
                return self.rt_typemeta_of(sty.canonical(), ctx);
            }
            tp: *TypeParamSymbol => {
                // 泛型参数有两种来源:
                // 一种是直接携带的, fn f<T>() 这种; 第二种是包含在 Self 类型中的, impl<T> S<T> { fn f(&self) {} }
                if ctx.signature.index_of_type_param(tp) is Some(i) {
                    return self.cg_typemeta_arg(ctx, i);
                } else {
                    // todo 这里假设了泛型参数就是 Self 类型的直接参数而不是 S<Option<T>> 这种, 后续继续改进支持更多情况
                    let mut self_sty = ctx.self_sty().get_or_panic();
                    if self_sty.type_symbol is assoc: *AssociatedTypeSymbol {
                        self_sty = assoc.target_sty;
                    }
                    let mut idx: UInt = 0;
                    for a in self_sty.args.ty_args {
                        if a.type_symbol as *raw TypeSymbol as UInt == tp as *raw TypeParamSymbol as UInt {
                            let self_ty_idx = ctx.signature.index_of_typemeta();
                            let self_tymeta = self.cg_typemeta_arg(ctx, self_ty_idx);
                            return self.access_typemeta_argv_of(self_tymeta, idx);
                        }
                        idx += 1;
                    }
                    let tp_name = tp.short_name();
                    let fname = ctx.sym.mangle_name();
                    let self_sty_str = self_sty.to_string();
                    let msg = f"BUG: TypeParamSymbol $(tp_name) is not found in $(fname), self sty: $(self_sty_str)";
                    panic msg.as_str().deref();
                }
            }
            // 这个是不看泛型实参个数的, 统一用 instantiated_typemeta
            tup: *TupleSymbol => {
                return self.instantiated_typemeta(sty, ctx);
            }
            arr: *ArraySymbol => {
                // 针对 Array 类型做点小优化, 如果 Array 的 size 较大会生成大量的指令划不来, 应该生成循环
                let sty_int = sty as *raw SType as UInt;
                if ctx.cached_instantiated.at(&sty_int) is Some(v) {
                    return v;
                }

                let saved_insert_point = self.llds.save_ip();

                let generic_typemeta = self.cg_generic_typemeta(arr as *TypeSymbol).as_value();
                let len = sty.args.ty_args.len();
                let argc = self.llds.get_const_int8(len as UInt8).as_value();

                if len == 0 {
                    let argv = self.llds.get_const_null().as_value();
                    let callee = self.llds.get_ext_fn_in_core("zinc_core_instantiate_array");
                    let result = self.llds.create_call(callee, &[generic_typemeta, argc, argv] as Slice<CgValue>);
                    ctx.cached_instantiated.insert(sty_int, result);
                    self.llds.restore_ip(saved_insert_point);
                    return result;
                } else {
                    let arg_sty = sty.args.ty_arg(0);
                    let argv = self.rt_typemeta_of(arg_sty, ctx);
                    let callee = self.llds.get_ext_fn_in_core("zinc_core_instantiate_array");
                    let result = self.llds.create_call(callee, &[generic_typemeta, argc, argv] as Slice<CgValue>);
                    ctx.cached_instantiated.insert(sty_int, result);
                    self.llds.restore_ip(saved_insert_point);
                    return result;
                }
            }
            // fn 指针类型: args 里存的是签名而不是泛型实参, 不能走 instantiated_typemeta,
            // 直接按需生成一个具体类型的 TypeMeta
            type *FnLowerTypeSymbol => {
                return self.cg_typemeta(sty.type_symbol).as_value();
            }
            // Fn / FnMut 同理: args 里是签名
            type *FnUpperTypeSymbol => {
                return self.cg_typemeta(sty.type_symbol).as_value();
            }
            type *FnUpperMutTypeSymbol => {
                return self.cg_typemeta(sty.type_symbol).as_value();
            }
            _ => {
                if sty.args.ty_args.is_empty() {
                    // 可调用类型 (函数项/闭包) 的 TypeMeta 是按需生成的,
                    // 不像 struct/enum 那样在 codegen_items 里预先全部生成
                    if sty.type_symbol is type *FuncSymbol || sty.type_symbol is type *LambdaSymbol {
                        return self.cg_typemeta(sty.type_symbol).as_value();
                    }
                    return self.get_typemeta_global(sty.type_symbol).as_value();
                } else {
                    return self.instantiated_typemeta(sty, ctx);
                }
            }
        }
        panic;
    }

    // 假设 sty 是包含泛型参数的
    // 上下文无关的形态 (实参全是具体类型) 会在 rt_typemeta_of 的开头走 tmcache 缓存;
    // 这里是"依赖运行时上下文"的老路径 (泛型函数/泛型 impl 里的 T、Self 关联类型等)。
    // (原来这里的 todo "对每个函数做一个缓存, 其实可以做一个全局缓存" 已经由 tmcache_* 实现)
    fn instantiated_typemeta(&mut self, sty: *SType, ctx: *CgContext) -> CgValue {
        // 查缓存
        let sty_int = sty as *raw SType as UInt;
        if ctx.cached_instantiated.at(&sty_int) is Some(v) {
            return v;
        }

        let saved_insert_point = self.llds.save_ip();

        self.llds.set_ip_for_instantiate(ctx.ll_func);

        let generic_typemeta = self.cg_generic_typemeta(sty.type_symbol).as_value();
        let len = sty.args.ty_args.len();
        let argc = self.llds.get_const_int8(len as UInt8).as_value();
        let argv = self.llds.create_alloca_sized(self.llds.type_ptr_array(len));

        let mut i: UInt32 = 0;
        for arg in sty.args.ty_args {
            let a = self.rt_typemeta_of(arg, ctx);
            let elem_ptr = self.llds.create_gep(
                self.llds.type_thin_ptr(),
                argv,
                self.llds.get_const_int32(i).as_value()
            );
            self.llds.create_store(a, elem_ptr);
            i += 1;
        }

        let callee = self.llds.get_ext_fn_in_core("zinc_core_instantiated");
        let result = self.llds.create_call(callee, &[generic_typemeta, argc, argv] as Slice<CgValue>);
        ctx.cached_instantiated.insert(sty_int, result);

        self.llds.restore_ip(saved_insert_point);
        return result;
    }

    // 使用点: load 缓存槽
    fn tmcache_load(&mut self, sty: *SType) -> CgValue {
        let gv = self.get_or_insert_tmcache_slot(sty);
        return self.llds.create_load(self.llds.type_thin_ptr(), gv.as_value());
    }

    // 拿到 (必要时创建) 某个上下文无关实例化的模块内缓存槽
    fn get_or_insert_tmcache_slot(&mut self, sty: *SType) -> CgGlobal {
        let c = sty.canonical();
        let name = self.tmcache_slot_name_of(c);
        if self.tmcache_slots.at(&name) is Some(g) {
            return g;
        }

        // 先把"实参里也需要缓存的槽"建好 (后序), 这样 tmcache_entries 里的顺序保证
        // 依赖 (实参) 在依赖者之前 —— 初始化函数里可以按顺序直接赋值。
        if c.type_symbol is type *ArraySymbol {
            // [T; N] 的 ty_args 是 N 个重复的 T, 只递归一次
            if c.args.ty_args.len() > 0_u {
                let ec = c.args.ty_arg(0).canonical();
                if self.sty_needs_runtime_instantiate(ec) && self.is_context_independent_sty(ec, 0_u) {
                    self.get_or_insert_tmcache_slot(ec);
                }
            }
        } else {
            for a in c.args.ty_args {
                let ac = a.canonical();
                if self.sty_needs_runtime_instantiate(ac) && self.is_context_independent_sty(ac, 0_u) {
                    self.get_or_insert_tmcache_slot(ac);
                }
            }
        }

        let g = self.llds.get_or_insert_internal_global(name.as_str().deref(), self.llds.type_thin_ptr());
        self.tmcache_slots.insert(name, g);
        self.tmcache_entries.push(c);
        return g;
    }

    // 该类型是否需要经过运行时 instantiate (和 rt_typemeta_of 的分派保持一致)
    fn sty_needs_runtime_instantiate(&self, sty: *SType) -> Bool {
        let ts = sty.type_symbol;
        if ts is type *TupleSymbol || ts is type *ArraySymbol {
            return true;
        }
        if ts is type *PointerLikeSymbol ||
            ts is type *StructSymbol ||
            ts is type *EnumSymbol {
            return !sty.args.ty_args.is_empty();
        }
        // fn 指针 / Fn / FnMut: args 里存的是签名而不是泛型实参, 走 cg_typemeta
        // 其它 (trait / union / FuncSymbol / LambdaSymbol ...) 都不在这里缓存
        return false;
    }

    // 归一化之后, 类型实参树里没有自由类型参数 / 关联类型 / 生命周期 / Invalid
    fn is_context_independent_sty(&self, sty: *SType, depth: UInt) -> Bool {
        if depth > 32_u {
            return false; // 保守: 太深就不缓存
        }
        let c = sty.canonical();
        if c.type_symbol is type *TypeParamSymbol ||
            c.type_symbol is type *AssociatedTypeSymbol ||
            c.type_symbol is type *LifetimeSymbol ||
            c.type_symbol is type *InvalidSymbol {
            return false;
        }
        for a in c.args.ty_args {
            if !self.is_context_independent_sty(a, depth + 1_u) {
                return false;
            }
        }
        return true;
    }

    fn sty_is_tmcacheable(&self, sty: *SType) -> Bool {
        let c = sty.canonical();
        if !self.sty_needs_runtime_instantiate(c) {
            return false;
        }
        return self.is_context_independent_sty(c, 0_u);
    }

    // 缓存槽名: zn.tmvar.<类型结构 mangle>
    fn tmcache_slot_name_of(&mut self, sty: *SType) -> String {
        let mut name = f"zn.tmvar.";
        self.tmcache_mangle_into(&mut name, sty);
        return name;
    }

    // 用"类型符号的 export_key + 递归实参"做确定性 mangle。
    // 不看生命周期实参 (typemeta 里本来就没有它们), 所以 Foo<'a, Int> 与 Foo<'b, Int> 共用一槽。
    fn tmcache_mangle_into(&mut self, buf: &mut String, sty: *SType) {
        let c = sty.canonical();
        buf.push_str(c.type_symbol.export_key().as_str().deref());
        buf.push_str("(");
        let mut i: UInt = 0;
        for a in c.args.ty_args {
            if i > 0_u {
                buf.push_str(",");
            }
            self.tmcache_mangle_into(buf, a);
            i += 1;
        }
        buf.push_str(")");
    }

    // 本 component 的 typemeta 缓存初始化函数 (每个编译单元一个, internal linkage)。
    // 没有可缓存实例化时就是一个空函数 (照样生成, 让 ZnComponent.cache_init_fn 永远有效)。
    fn cg_tmcache_init_fn(&mut self) -> CgFunc {
        if self.tmcache_init_fn is Some(f) {
            return f;
        }

        let mut name = f"zn.component.";
        name.push_str(self.comp_name.as_str().deref());
        name.push_str(".tmcache_init");
        let fnty = self.llds.type_function(self.llds.type_void(), &[] as Slice<CgType>);
        let f = self.llds.create_internal_fn(fnty, name.as_str().deref());
        self.tmcache_init_fn = Some(f);

        let saved_insert_point = self.llds.save_ip();
        let entry_bb = self.llds.create_bb("entry", f);
        self.llds.set_insert_point(entry_bb);

        // 按 tmcache_entries 的顺序赋值 (实参的槽一定在前面, 见 get_or_insert_tmcache_slot)
        let len = self.tmcache_entries.len();
        let mut i: UInt = 0;
        while i < len {
            let sty: *SType = *self.tmcache_entries.index(i).deref();
            let v = self.concrete_instantiated_typemeta(sty);
            let gv = self.get_or_insert_tmcache_slot(sty);
            self.llds.create_store(v, gv.as_value());
            i += 1;
        }
        // get_or_insert_tmcache_slot 的后序保证: 走到这里不应该再新增槽
        if self.tmcache_entries.len() != len {
            panic "BUG: tmcache entries grew while emitting the init function";
        }
        self.llds.create_retvoid();

        self.llds.verify_function(f);
        self.llds.restore_ip(saved_insert_point);
        return f;
    }

    // 发射 zinc_core_instantiated(...) 调用 (实参都是编译期常量)
    fn concrete_instantiated_typemeta(&mut self, sty: *SType) -> CgValue {
        let c = sty.canonical();
        let generic_typemeta = self.cg_generic_typemeta(c.type_symbol).as_value();
        let len = c.args.ty_args.len();
        let argc = self.llds.get_const_int8(len as UInt8).as_value();

        // Array 特殊处理: [T; N] 的 ty_args 是 N 个重复的 T, 逐个存指针会生成 O(N) 条指令
        // (和 rt_typemeta_of 里 Array 分支的优化一致)
        if c.type_symbol is type *ArraySymbol {
            let elem_tm = if len == 0_u
                then self.llds.get_const_null().as_value()
                else self.concrete_typemeta_of(c.args.ty_arg(0));
            let callee = self.llds.get_ext_fn_in_core("zinc_core_instantiate_array");
            return self.llds.create_call(callee, &[generic_typemeta, argc, elem_tm] as Slice<CgValue>);
        }

        let argv = self.llds.create_alloca_sized(self.llds.type_ptr_array(len));
        let mut i: UInt32 = 0;
        for arg in c.args.ty_args {
            let a = self.concrete_typemeta_of(arg);
            let elem_ptr = self.llds.create_gep(
                self.llds.type_thin_ptr(),
                argv,
                self.llds.get_const_int32(i).as_value()
            );
            self.llds.create_store(a, elem_ptr);
            i += 1;
        }

        let callee = self.llds.get_ext_fn_in_core("zinc_core_instantiated");
        return self.llds.create_call(callee, &[generic_typemeta, argc, argv] as Slice<CgValue>);
    }

    // 具体类型实参的 typemeta: 全局量, 或者另一个缓存槽的 load
    // (调用者保证 sty 是上下文无关的, 且它的缓存槽已经建好)
    fn concrete_typemeta_of(&mut self, sty: *SType) -> CgValue {
        let c = sty.canonical();
        if self.sty_needs_runtime_instantiate(c) && self.is_context_independent_sty(c, 0_u) {
            return self.tmcache_load(c);
        }
        // 可调用类型 / fn 指针 / Fn / FnMut 的 TypeMeta 是按需生成的
        if c.type_symbol is type *FnLowerTypeSymbol ||
            c.type_symbol is type *FnUpperTypeSymbol ||
            c.type_symbol is type *FnUpperMutTypeSymbol ||
            c.type_symbol is type *FuncSymbol ||
            c.type_symbol is type *LambdaSymbol {
            return self.cg_typemeta(c.type_symbol).as_value();
        }
        return self.get_typemeta_global(c.type_symbol).as_value();
    }
}