    // 函数项 / 闭包这些"可调用类型"的 TypeMeta。
    // 它们都是零大小类型, 没有字段, 也不需要 copy/dtor。
    // kind 用 ZnTypeMetaKind::TM_Func / TM_Lambda。
    fn cg_callable_typemeta(&mut self, sym: *TypeSymbol, kind: UInt8) -> CgGlobal {
        let gv_name = self.typemeta_name_of(sym);
        if self.is_imported(sym) {
            return self.llds.get_or_insert_global(gv_name.as_str().deref(), self.llds.type_ZnTypeMeta());
        }

        let gv = self.llds.get_or_insert_global(gv_name.as_str().deref(), self.llds.type_ZnTypeMeta());
        if gv.has_initializer() {
            return gv; // 已经生成了
        }

        let cg_ty = self.cgtype_of(sym.to_sty()).get_or_panic();

        let name = self.llds.get_const_string(sym.export_key().as_str().deref());
        let kind_c = self.llds.get_const_int8(kind);
        let ty_param_count = self.llds.get_const_int8(0_u8);
        let ty_argc = self.llds.get_const_int8(0_u8);
        let align = self.llds.get_const_int8(self.llds.alignment_of(cg_ty) as UInt8);
        let size = self.llds.get_const_int64(self.llds.storage_size_of(cg_ty) as UInt64);
        let copyfn = self.cg_empty_copyfn();
        let dtorfn = self.cg_empty_dtorfn();
        let ty_argv = self.llds.get_const_null();
        let instantiated_from = self.llds.get_const_null();
        let hashmap = self.llds.get_null_value_of(self.llds.type_byte_array(56_u)); // sizeof(HashMap)

        let agg = self.llds.get_const_struct(
            self.llds.type_ZnTypeMeta(),
            &[
                name, kind_c, ty_param_count, ty_argc, align, size, copyfn.as_const(), dtorfn.as_const(), ty_argv, instantiated_from, hashmap
            ] as Slice<CgConst>
        );
        gv.set_initializer(agg);
        return gv;
    }

    fn cg_struct_generic_typemeta(&mut self, struct_sym: *StructSymbol) -> CgGlobal {
        // 先看缓存
        let gv_name = self.typemeta_name_of(struct_sym);
        if self.is_imported(struct_sym) {
            return self.llds.get_or_insert_global(gv_name.as_str().deref(), self.llds.type_ZnGenericTypeMeta());
        }

        let gv = self.llds.get_or_insert_global(gv_name.as_str().deref(), self.llds.type_ZnGenericTypeMeta());
        if gv.has_initializer() {
            return gv; // 已经生成了
        }

        let name = self.llds.get_const_string(struct_sym.export_key().as_str().deref());
        let kind = self.llds.get_const_int8(25_u8); // ZnTypeMetaKind::TM_Struct
        let ty_param_count = self.llds.get_const_int8(struct_sym.generics.ty_params.len() as UInt8);
        let size_fn = self.cg_struct_sizefn(struct_sym).as_const();
        let align_fn = self.cg_typemeta_alignfn(struct_sym as *TypeSymbol).as_const();
        let copy_fn = self.cg_struct_copyfn(struct_sym).as_const();
        let dtor_fn = self.cg_struct_dtorfn(struct_sym).as_const();
        let where_cond_fn = self.llds.get_const_null(); // FIXME
        let related_impl_cap = self.llds.get_const_int64(0);
        let related_impls = self.llds.get_const_null();
        let hashmap = self.llds.get_null_value_of(self.llds.type_byte_array(56_u)); // sizeof(HashMap)

        
        let agg = self.llds.get_const_struct(
            self.llds.type_ZnGenericTypeMeta(),
            &[
                name, kind, ty_param_count, size_fn, align_fn, copy_fn, dtor_fn, where_cond_fn, related_impl_cap, related_impls, hashmap
            ] as Slice<CgConst>
        );
        gv.set_initializer(agg);
        return gv;
    }

