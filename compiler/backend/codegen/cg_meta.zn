use super::*;
use super::data_structures::*;

use ::self::frontend::semantic::hir::ir::*;
use ::self::frontend::semantic::hir::checker::type_utils::*;

use std::meta::Type;

extern fn codegen_builtin_typemeta(ds: Ptr, name: Ptr, len: UInt, byte_size: UInt) -> Ptr;
extern fn codegen_tuple_generictypemeta(ds: Ptr) -> Ptr;
extern fn codegen_array_generictypemeta(ds: Ptr) -> Ptr;

extern fn empty_copy_fn(ds: Ptr) -> Ptr;
extern fn empty_dtor_fn(ds: Ptr) -> Ptr;
extern fn codegen_tuple_array_sizefn(ds: Ptr) -> Ptr;
extern fn codegen_tuple_array_alignfn(ds: Ptr) -> Ptr;

struct CgTypeMetaData {
    kind: UInt8,
    ty_param_count: UInt8,
    ty_argc: UInt8,
    align: UInt8,
    size_byte: UInt64,
}

impl CodeGenerator {

    // 返回的是 ZnTypeMeta*
    fn cg_typemeta(&mut self, sym: *TypeSymbol) -> CgGlobal {
        let res = self.do_cg_typemeta(move sym);
        if res.has_initializer() {
            let tm_int = res.value as UInt;
            self.all_typemeta.insert(tm_int);
        }
        return res;
    }

    fn do_cg_typemeta(&mut self, sym: *TypeSymbol) -> CgGlobal {

        match sym {
            type *BoolSymbol => return self.cg_builtin_typemeta("Bool", 1);
            type *CharSymbol => return self.cg_builtin_typemeta("Char", 4);
            int_sym: *IntegerSymbol => {
                match int_sym.kind {
                    IntegerKind::I8 => return self.cg_builtin_typemeta("Int8", 1);
                    IntegerKind::I16 => return self.cg_builtin_typemeta("Int16", 2);
                    IntegerKind::I32 => return self.cg_builtin_typemeta("Int32", 4);
                    IntegerKind::I64 => return self.cg_builtin_typemeta("Int64", 8);
                    IntegerKind::Isize => return self.cg_builtin_typemeta("Int", 8);
                    IntegerKind::Ishort => return self.cg_builtin_typemeta("Short", 4);
                    IntegerKind::U8 => return self.cg_builtin_typemeta("UInt8", 1);
                    IntegerKind::U16 => return self.cg_builtin_typemeta("UInt16", 2);
                    IntegerKind::U32 => return self.cg_builtin_typemeta("UInt32", 4);
                    IntegerKind::U64 => return self.cg_builtin_typemeta("UInt64", 8);
                    IntegerKind::Usize => return self.cg_builtin_typemeta("UInt", 8);
                    IntegerKind::Ushort => return self.cg_builtin_typemeta("UShort", 4);
                }
            }
            float_sym: *FloatSymbol => {
                match float_sym.kind {
                    FloatKind::F32 => return self.cg_builtin_typemeta("F32", 4);
                    FloatKind::F64 => return self.cg_builtin_typemeta("F64", 8);
                }
            }
            struct_sym: *StructSymbol => {
                if struct_sym.generics.ty_params.is_empty() {
                    return self.cg_struct_typemeta(move struct_sym);
                }
            }
            enum_sym: *EnumSymbol => {
                if enum_sym.generics.ty_params.is_empty() {
                    return self.cg_enum_typemeta(move enum_sym);
                }
            }
            union_sym: *UnionSymbol => {
                return self.cg_union_typemeta(move union_sym);
            }
            trait_sym: *TraitSymbol => {
                return self.cg_trait_typemeta(move trait_sym);
            }
            fsym: *FuncSymbol => {
                return self.cg_callable_typemeta(fsym as *TypeSymbol, 32_u8); // TM_Func
            }
            lsym: *LambdaSymbol => {
                return self.cg_callable_typemeta(lsym as *TypeSymbol, 36_u8); // TM_Lambda
            }
            fn_lower: *FnLowerTypeSymbol => {
                // fn 指针: 值就是一个瘦指针
                return self.cg_callable_typemeta(fn_lower as *TypeSymbol, 29_u8); // TM_FnLower
            }
            _ => {
                let meta = Type::of(&*sym as &TypeSymbol as &Any);
                let name = meta.short_name();
                let msg = f"BUG: unhandled case in CodeGenerator::cg_typemeta: $(name)";
                panic msg.as_str().deref();
            }
        }
        panic;
    }

    fn get_typemeta_global(&mut self, sym: *TypeSymbol) -> CgGlobal {
        let gv_name = self.typemeta_name_of(move sym);
        return self.llds.get_or_insert_global(gv_name.as_str().deref(), self.llds.type_ZnTypeMeta());
    }

    // 返回的是 ZnGenericTypeMeta*
    fn cg_generic_typemeta(&mut self, sym: *TypeSymbol) -> CgGlobal {
        let res = self.do_cg_generic_typemeta(move sym);
        if res.has_initializer() {
            let tm_int = res.value as UInt;
            self.all_generic_typemeta.insert(tm_int);
        }
        return res;
    }

    fn do_cg_generic_typemeta(&mut self, sym: *TypeSymbol) -> CgGlobal {
        match sym {
            struct_sym: *StructSymbol => {
                return self.cg_struct_generic_typemeta(move struct_sym);
            }
            enum_sym: *EnumSymbol => {
                return self.cg_enum_generic_typemeta(move enum_sym);
            }
            trait_sym: *TraitSymbol => {
                // unimplemented
                panic "BUG: trait with type generics is unimplemented";
            }
            tup_sym: *TupleSymbol => {
                return self.cg_tuple_generic_typemeta(move tup_sym);
            }
            array_sym: *ArraySymbol => {
                return self.cg_array_generic_typemeta(move array_sym);
            }
            ptr_sym: *PointerLikeSymbol => {
                return self.cg_pointer_generic_typemeta(move ptr_sym);
            }
            _ => {
                let meta = Type::of(&*sym as &TypeSymbol as &Any);
                let name = meta.short_name();
                let msg = f"BUG: unhandled case in CodeGenerator::cg_typemeta: $(name)";
                panic msg.as_str().deref();
            }
        }
        panic;
    }

    fn typemeta_name_of(&mut self, sym: *TypeSymbol) -> String {
        let mut name = f"zn.meta.";
        if is_builtin_type_symbol(sym) {
            name.push_str(sym.short_name().as_str().deref());
        }
        else if sym is alias: *TypeAliasSymbol {
            return self.typemeta_name_of(alias.target_sty.type_symbol);
        }
        else {
            name.push_str(sym.export_key().as_str().deref());
        }
        return name;
    }

    fn codegen_primitives_in_std(&mut self) {
        self.cg_builtin_typemeta("Bool", 1);
        self.cg_builtin_typemeta("Char", 4);
        self.cg_builtin_typemeta("Int8", 1);
        self.cg_builtin_typemeta("Int16", 2);
        self.cg_builtin_typemeta("Int32", 4);
        self.cg_builtin_typemeta("Int64", 8);
        self.cg_builtin_typemeta("Int", 8);
        self.cg_builtin_typemeta("Short", 4);
        self.cg_builtin_typemeta("UInt8", 1);
        self.cg_builtin_typemeta("UInt16", 2);
        self.cg_builtin_typemeta("UInt32", 4);
        self.cg_builtin_typemeta("UInt64", 8);
        self.cg_builtin_typemeta("UInt", 8);
        self.cg_builtin_typemeta("UShort", 4);
        self.cg_builtin_typemeta("F32", 4);
        self.cg_builtin_typemeta("F64", 8);

        self.cg_pointer_generic_typemeta(ArcPointerSymbol::new() as *PointerLikeSymbol);
        self.cg_pointer_generic_typemeta(WeakPointerSymbol::new() as *PointerLikeSymbol);
        self.cg_pointer_generic_typemeta(BorrowImmutSymbol::new() as *PointerLikeSymbol);
        self.cg_pointer_generic_typemeta(BorrowMutSymbol::new() as *PointerLikeSymbol);
        self.cg_pointer_generic_typemeta(RawPointerImmutSymbol::new() as *PointerLikeSymbol);
        self.cg_pointer_generic_typemeta(RawPointerMutSymbol::new() as *PointerLikeSymbol);
        // fn 指针类型的 TypeMeta 由 std 定义 (它的 args 是签名, 其它组件只声明)
        self.cg_callable_typemeta(FnLowerTypeSymbol::new() as *TypeSymbol, 29_u8);
        unsafe {
            codegen_tuple_generictypemeta(self.llds.ds);
            codegen_array_generictypemeta(self.llds.ds);
        }
    }

    fn cg_builtin_typemeta(&mut self, name: Str, byte_size: UInt) -> CgGlobal {
        if !self.comp_name.as_str().deref().eq(&"std") {
            let mut gv_name = f"zn.meta.";
            gv_name.push_str(name);

            if name.eq(&"Tuple") || name.eq(&"Array") {
                return self.llds.get_or_insert_global(gv_name.as_str().deref(), self.llds.type_ZnGenericTypeMeta());
            } else {
                return self.llds.get_or_insert_global(gv_name.as_str().deref(), self.llds.type_ZnTypeMeta());
            }
        }

        unsafe {
            let g = codegen_builtin_typemeta(self.llds.ds, name.raw_ptr(), name.len(), byte_size);
            return {
                .value = g
            }: CgGlobal;
        }
    }

    fn cg_struct_typemeta(&mut self, struct_sym: *StructSymbol) -> CgGlobal {
        // 先看缓存
        let gv_name = self.typemeta_name_of(struct_sym);
        if self.is_imported(struct_sym) {
            return self.llds.get_or_insert_global(gv_name.as_str().deref(), self.llds.type_ZnTypeMeta());
        }
        
        let gv = self.llds.get_or_insert_global(gv_name.as_str().deref(), self.llds.type_ZnTypeMeta());
        if gv.has_initializer() {
            return gv; // 已经生成了
        }

        let cg_struct_ty = self.cgtype_of(struct_sym.to_sty()).get_or_panic();

        let name = self.llds.get_const_string(struct_sym.export_key().as_str().deref());
        let kind = self.llds.get_const_int8(25_u8); // ZnTypeMetaKind::TM_Struct
        let ty_param_count = self.llds.get_const_int8(0_u8);
        let ty_argc = self.llds.get_const_int8(0_u8);
        let align = self.llds.get_const_int8(self.llds.alignment_of(cg_struct_ty) as UInt8);
        let size = self.llds.get_const_int64(self.llds.storage_size_of(cg_struct_ty) as UInt64);
        let copyfn = self.cg_struct_copyfn(struct_sym);
        let dtorfn = self.cg_struct_dtorfn(struct_sym);
        let ty_argv = self.llds.get_const_null();
        let instantiated_from = self.llds.get_const_null();
        let hashmap = self.llds.get_null_value_of(self.llds.type_byte_array(56_u)); // sizeof(HashMap)

        let agg = self.llds.get_const_struct(
            self.llds.type_ZnTypeMeta(),
            &[
                name, kind, ty_param_count, ty_argc, align, size, copyfn.as_const(), dtorfn.as_const(), ty_argv, instantiated_from, hashmap
            ] as Slice<CgConst>
        );
        gv.set_initializer(agg);
        return gv;
    }

    fn cg_enum_typemeta(&mut self, enum_sym: *EnumSymbol) -> CgGlobal {
        // 先看缓存
        let gv_name = self.typemeta_name_of(enum_sym);
