            KeywordKind::KW_ENUM => buf.push_str("enum");
            KeywordKind::KW_EXPORT => buf.push_str("export");
            KeywordKind::KW_EXTERN => buf.push_str("extern");
            KeywordKind::KW_FINAL => buf.push_str("final");
            KeywordKind::KW_FALSE => buf.push_str("false");
            KeywordKind::KW_FN_LOWER => buf.push_str("fn");
            KeywordKind::KW_FN_UPPER => buf.push_str("Fn");
            KeywordKind::KW_FN_UPPER_MUT => buf.push_str("FnMut");
            KeywordKind::KW_FOR => buf.push_str("for");
            KeywordKind::KW_GOTO => buf.push_str("goto");
            KeywordKind::KW_IF => buf.push_str("if");
            KeywordKind::KW_IMPL => buf.push_str("impl");
            KeywordKind::KW_IMPORT => buf.push_str("import");
            KeywordKind::KW_IN => buf.push_str("in");
            KeywordKind::KW_INLINE => buf.push_str("inline");
            KeywordKind::KW_IS => buf.push_str("is");
            KeywordKind::KW_LET => buf.push_str("let");
            KeywordKind::KW_MACRO => buf.push_str("macro");
            KeywordKind::KW_MATCH => buf.push_str("match");
            KeywordKind::KW_MOD => buf.push_str("mod");
            KeywordKind::KW_MOVE => buf.push_str("move");
            KeywordKind::KW_MUT => buf.push_str("mut");
            KeywordKind::KW_OUT => buf.push_str("out");
            KeywordKind::KW_OVERRIDE => buf.push_str("override");
            KeywordKind::KW_PANIC => buf.push_str("panic");
            KeywordKind::KW_PUB => buf.push_str("pub");
            KeywordKind::KW_RAW => buf.push_str("raw");
            KeywordKind::KW_REF => buf.push_str("ref");
            KeywordKind::KW_RETURN => buf.push_str("return");
            KeywordKind::KW_REUSE => buf.push_str("reuse");
            KeywordKind::KW_SEALED => buf.push_str("sealed");
            KeywordKind::KW_SELF_LOWER => buf.push_str("self");
            KeywordKind::KW_SELF_UPPER => buf.push_str("Self");
            KeywordKind::KW_STATIC => buf.push_str("static");
            KeywordKind::KW_STRUCT => buf.push_str("struct");
            KeywordKind::KW_SUPER => buf.push_str("super");
            KeywordKind::KW_THEN => buf.push_str("then");
            KeywordKind::KW_TRAIT => buf.push_str("trait");
            KeywordKind::KW_TRUE => buf.push_str("true");
            KeywordKind::KW_TYPE => buf.push_str("type");
            KeywordKind::KW_UNION => buf.push_str("union");
            KeywordKind::KW_UNSAFE => buf.push_str("unsafe");
            KeywordKind::KW_USE => buf.push_str("use");
            KeywordKind::KW_VIRTUAL => buf.push_str("virtual");
