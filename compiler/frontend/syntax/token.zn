impl ToString for LiteralKind {
    fn to_string_inplace(&self, buf: &mut String) {
        match self {
            LiteralKind::LIT_CHAR => buf.push_str("char literal");
            LiteralKind::LIT_STR => buf.push_str("string literal");
            LiteralKind::LIT_STR_INTERPOLATION => buf.push_str("string interpolation literal");
            LiteralKind::LIT_BYTE => buf.push_str("byte literal");
            LiteralKind::LIT_INT => buf.push_str("integer literal");
            LiteralKind::LIT_FLOAT => buf.push_str("float literal");
            LiteralKind::LIT_RAW_STR => buf.push_str("raw string literal");
            LiteralKind::LIT_CSTR => buf.push_str("C string literal");
        }
    }

    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

impl ToString for PunctuationKind {
    fn to_string_inplace(&self, buf: &mut String) {
        match self {
            PunctuationKind::Semi => buf.push_str(";");
            PunctuationKind::Comma => buf.push_str(",");
            PunctuationKind::Dot => buf.push_str(".");
            PunctuationKind::LParen => buf.push_str("(");
            PunctuationKind::RParen => buf.push_str(")");
            PunctuationKind::LBrace => buf.push_str("{");
            PunctuationKind::RBrace => buf.push_str("}");
            PunctuationKind::LBracket => buf.push_str("[");
            PunctuationKind::RBracket => buf.push_str("]");
            PunctuationKind::At => buf.push_str("@");
            PunctuationKind::Pound => buf.push_str("#");
            PunctuationKind::Tilde => buf.push_str("~");
            PunctuationKind::Question => buf.push_str("?");
            PunctuationKind::Colon => buf.push_str(":");
            PunctuationKind::Dollar => buf.push_str("$");
            PunctuationKind::Assign => buf.push_str("=");
            PunctuationKind::Bang => buf.push_str("!");
            PunctuationKind::Lt => buf.push_str("<");
            PunctuationKind::Gt => buf.push_str(">");
            PunctuationKind::Minus => buf.push_str("-");
            PunctuationKind::Plus => buf.push_str("+");
            PunctuationKind::Star => buf.push_str("*");
            PunctuationKind::Div => buf.push_str("/");
            PunctuationKind::Percent => buf.push_str("%");
            PunctuationKind::Borrow => buf.push_str("&");

            PunctuationKind::NotEq => buf.push_str("!=");
            PunctuationKind::EqEq => buf.push_str("==");
            PunctuationKind::LtEq => buf.push_str("<=");
            PunctuationKind::GtEq => buf.push_str(">=");
            PunctuationKind::AndAnd => buf.push_str("&&");
            PunctuationKind::OrOr => buf.push_str("||");
            PunctuationKind::AddAssign => buf.push_str("+=");
            PunctuationKind::SubAssign => buf.push_str("-=");
            PunctuationKind::MulAssign => buf.push_str("*=");
            PunctuationKind::DivAssign => buf.push_str("/=");
            PunctuationKind::PercentAssign => buf.push_str("%=");
            PunctuationKind::ThinArrow => buf.push_str("->");
            PunctuationKind::FatArrow => buf.push_str("=>");
            PunctuationKind::ColonColon => buf.push_str("::");
            PunctuationKind::RangeOpen => buf.push_str("..<");
            PunctuationKind::RangeClose => buf.push_str("..=");
            PunctuationKind::Ellipsis => buf.push_str("...");
        }
    }

    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

impl ToString for TokenKind {
    fn to_string_inplace(&self, buf: &mut String) {
        match self {
            TokenKind::Invalid => buf.push_str("TK_Invalid");
            TokenKind::EndOfFile => buf.push_str("TK_EOF");
            TokenKind::Comment => buf.push_str("TK_Comment");
            TokenKind::Identifier => buf.push_str("TK_Ident");
            TokenKind::Lifetime => buf.push_str("TK_Lifetime");
            TokenKind::Keyword(k) => {
                buf.push_str("TK_Keyword(");
                k.to_string_inplace(buf);
                buf.push_str(")");
            }
            TokenKind::Literal(l) => {
                buf.push_str("TK_Literal(");
                l.to_string_inplace(buf);
                buf.push_str(")");
            }
            TokenKind::Punctuation(p) =>{
                buf.push_str("TK_Punct(");
                p.to_string_inplace(buf);
                buf.push_str(")");
            }
            _ => buf.push_str("TK_Unknown");
        }
    }

    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

impl ToString for Token {
    fn to_string_inplace(&self, buf: &mut String) {
        self.token_kind.to_string_inplace(buf);

        if self.token_kind is TokenKind::Identifier || self.token_kind is TokenKind::Lifetime {
            buf.push_str("(");
            self.raw_str().to_string_inplace(buf);
            buf.push_str(")");
        }
    }

    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

impl KeywordKind {
    pub fn from_str(s: Str) -> Option<KeywordKind> {
        if s.eq(&"as") {
            return Some(KeywordKind::KW_AS);
        }
        else if s.eq(&"asm") {
            return Some(KeywordKind::KW_ASM);
