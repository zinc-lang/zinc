use super::super::source_code::{SourceSpan, SourceManager};
use std::cmp::{Eq, PartialEq};
use std::primitives::string::ToString;

pub enum KeywordKind {
    KW_AS,
    KW_ASM, // asm, 新增
    KW_ASYNC,
    KW_AWAIT,
    KW_BREAK,
    KW_BOX,
    KW_CONST,
    KW_CONTINUE,
    KW_DO,  // do-while loop
    KW_ELSE,
    KW_ENUM,
    KW_EXPORT, // 新增 export
    KW_EXTERN,
    KW_FINAL,
    KW_FALSE,
    KW_FN_LOWER, // fn
    KW_FN_UPPER, // Fn, 没有 FnOnce
    KW_FN_UPPER_MUT, // FnMut
    KW_FOR,
    KW_GOTO, // goto, 新增
    KW_IF,
    KW_IMPL,
    KW_IMPORT, // import, 新增, 替代 extern crate
    KW_IN,
    KW_INLINE, // inline, 新增
    KW_IS, // is, 新增
    KW_LET,
    KW_MACRO,
    KW_MATCH,
    KW_MOD,
    KW_MOVE,
    KW_MUT,
    KW_OUT, // out, 新增, 预留
    KW_OVERRIDE, // override, 新增
    KW_PANIC, // panic, 新增
    KW_PUB,
    KW_RAW, // raw, 新增
    KW_REF,
    KW_RETURN,
    KW_REUSE, // reuse, 新增
    KW_SEALED, // sealed, 新增
    KW_SELF_LOWER,
    KW_SELF_UPPER,
    KW_STATIC,
    KW_STRUCT,
    KW_SUPER,
    KW_THEN, // then, 新增 if-then-else 表达式
    KW_TRAIT,
    KW_TRUE,
    KW_TYPE,
    KW_UNION,
    KW_UNSAFE,
    KW_USE,
    KW_VIRTUAL,
    KW_WEAK, // weak, 新增
    KW_WHERE,
    KW_WHILE,
    KW_YIELD,
}

impl PartialEq for KeywordKind {
    fn eq(&self, other: &Self) -> Bool {
        return *self as UInt == *other as UInt;
    }

    fn ne(&self, other: &Self) -> Bool {
        return !self.eq(other);
    }
}

impl Eq for KeywordKind {}

pub enum LiteralKind {
    LIT_CHAR,
    LIT_STR,
    LIT_STR_INTERPOLATION,
    LIT_BYTE,
    LIT_INT,
    LIT_FLOAT,
    LIT_RAW_STR,
    LIT_CSTR,
}

impl PartialEq for LiteralKind {
    fn eq(&self, other: &Self) -> Bool {
        return *self as UInt == *other as UInt;
    }

    fn ne(&self, other: &Self) -> Bool {
        return !self.eq(other);
    }
}

impl Eq for LiteralKind {}

pub enum PunctuationKind {
    Semi, /// `;`
    Comma, /// `,`
    Dot, /// `.`
    LParen, /// `(`
    RParen, /// `)`
    LBrace, /// `{`
    RBrace, /// `}`
    LBracket, /// `[`
    RBracket, /// `]`
    At, /// `@`
    Pound, /// `#`
    Tilde, /// `~`
    Question, /// `?`
    Colon, /// `:`
    Dollar, /// `$`
    Assign, /// `=`
    Bang, /// `!`
    Lt, /// `<`
    Gt, /// `>`
    Minus, /// `-`
    Plus, /// `+`
    Star, /// `*`
    Div, /// `/`
    Percent, /// `%`
    Borrow, /// `&`, `&mut`, `&raw`

    NotEq, /// `!=`
    EqEq, /// `==`
    LtEq, /// `<=`
    GtEq, /// `>=`
    AndAnd, /// `&&`
    OrOr, /// `||`
    AddAssign, /// `+=`
    SubAssign, /// `-=`
    MulAssign, /// `*=`
    DivAssign, /// `/=`
    PercentAssign, /// `%=`
    ThinArrow, /// `->`
    FatArrow, /// `=>`
    ColonColon, /// `::`
    RangeOpen, /// `..<`
    RangeClose, /// `..=`
    Ellipsis, /// `...`
}

impl PartialEq for PunctuationKind {
    fn eq(&self, other: &Self) -> Bool {
        return *self as UInt == *other as UInt;
    }

    fn ne(&self, other: &Self) -> Bool {
        return !self.eq(other);
    }
}

impl Eq for PunctuationKind {}

pub enum TokenKind {
    Invalid,
    EndOfFile,
    Comment,
    Identifier,
    Lifetime,
    Keyword(KeywordKind),
    Literal(LiteralKind),
    Punctuation(PunctuationKind),
}

impl PartialEq for TokenKind {
    fn eq(&self, other: &Self) -> Bool {
        // todo: tuple 模式有 bug, 按道理应该这样写 match(self, other) { ... }
        if self is TokenKind::Keyword(k1) && other is TokenKind::Keyword(k2) {
            return k1.eq(&k2);
        }
        if self is TokenKind::Literal(l1) && other is TokenKind::Literal(l2) {
            return l1.eq(&l2);
        }
        if self is TokenKind::Punctuation(p1) && other is TokenKind::Punctuation(p2) {
            return p1.eq(&p2);
        }
        return *self as UInt == *other as UInt;
    }

    fn ne(&self, other: &Self) -> Bool {
        return !self.eq(other);
    }
}

impl Eq for TokenKind {}

pub struct Token {
    pub source_span: SourceSpan,
    pub token_kind: TokenKind,
}

impl Token {
    pub fn raw_str(&self) -> String {
        if self.token_kind is TokenKind::Invalid {
            return f"<invalid>";
        }
        else if self.token_kind is TokenKind::EndOfFile {
            return f"<eof>";
        }
        else if self.token_kind is TokenKind::Comment {
            return f"<comment>";
        }
        else if self.token_kind is TokenKind::Keyword(k) {
            return k.to_string();
        }
        else if self.token_kind is TokenKind::Literal(_) {
            return SourceManager::get().source_piece_of(self.source_span);
        }
        else if self.token_kind is TokenKind::Punctuation(p) {
            return p.to_string();
        }
        else {
            return SourceManager::get().source_piece_of(self.source_span);
        }
    }

    pub fn span(&self) -> SourceSpan {
        return self.source_span;
    }

    pub fn eof() -> Token {
        return {
            .source_span = SourceSpan::empty(),
            .token_kind = TokenKind::EndOfFile,
        }: Token;
    }

    pub fn invalid(span: SourceSpan) -> Token {
        return {
            .source_span = span,
            .token_kind = TokenKind::Invalid,
        }: Token;
    }

    pub fn is_invalid(&self) -> Bool {
        return self.token_kind is TokenKind::Invalid;
    }

    pub fn is_lifetime(&self) -> Bool {
        return self.token_kind is TokenKind::Lifetime;
    }
}

impl PartialEq for Token {
    fn eq(&self, other: &Self) -> Bool {
        return self.source_span.eq(&other.source_span) && self.token_kind.eq(&other.token_kind);
    }

    fn ne(&self, other: &Self) -> Bool {
        return !self.eq(other);
    }
}

impl Eq for Token {}

