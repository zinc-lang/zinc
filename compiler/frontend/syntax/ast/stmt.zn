impl SyntaxNode for MatchArm {
    fn span(&self) -> SourceSpan {
        let start = self.pattern.span().start;
        let end = self.action.span().end;
        return { .start = start, .end = end }: SourceSpan;
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_match_arm(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        let mut children: Vec<*SyntaxNode> = (type Vec<*SyntaxNode>)::new();
        children.push(self.pattern as *SyntaxNode);
        children.push(self.action as *SyntaxNode);
        return children;
    }

    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node as *weak SyntaxNode);
    }
    fn set_parent(&mut self, parent: *weak SyntaxNode) {
        if parent is p: *weak MatchStmt {
            self.parent_node = move p;
        }
    }
}

impl StatementNode for MatchArm {}

impl SyntaxNode for MatchStmt {
    fn span(&self) -> SourceSpan {
        let start = self.kw_match.span().start;
        let end = self.rbrace.span().end;
        return { .start = start, .end = end }: SourceSpan;
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_match_stmt(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        let mut children: Vec<*SyntaxNode> = (type Vec<*SyntaxNode>)::new();
        children.push(self.match_expr as *SyntaxNode);
        for arm in self.arms {
            children.push(move arm as *SyntaxNode);
        }
        return children;
    }

    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node as *weak SyntaxNode);
    }
    fn set_parent(&mut self, parent: *weak SyntaxNode) {
        self.parent_node = move parent;
    }
}

impl StatementNode for MatchStmt {}

