use super::super::token::{Token, TokenKind, KeywordKind};
use super::super::super::source_code::{SourceSpan, SourceManager};
use super::QualifierList;
use super::{SyntaxNode, StatementNode, DeclNode, PatternNode, TypeNode, ExpressionNode};
use super::visit::{SyntaxVisitor, VisitResult};

pub struct BlockStmt {
    parent_node: *weak SyntaxNode, // 可能是 fn 或 lambda 或 block
    kw_unsafe: Token,
    lbrace: Token,
    stmts: Vec<*StatementNode>,
    decls: Vec<*DeclNode>,
    rbrace: Token,
}

pub struct EmptyStmt {
    parent_node: *weak SyntaxNode,
    semicolon: Token,
}

pub struct LetStmt {
    parent_node: *weak SyntaxNode,
    kw_let: Token,
    pattern: *PatternNode,
    assign: Token,
    init_expr: *ExpressionNode,
    semicolon: Token,
}

pub struct ExprStmt {
    parent_node: *weak SyntaxNode,
    expr: *ExpressionNode,
    semicolon: Token,
}

pub struct IfStmt {
    parent_node: *weak SyntaxNode,
    kw_if: Token,
    condition: *ExpressionNode,
    then_branch: *BlockStmt,
    else_branch: Option<*StatementNode>, // 可能是另外一个 IfStmt 或者一个 BlockStmt
}

pub struct WhileStmt {
    parent_node: *weak SyntaxNode,
    kw_while: Token,
    condition: *ExpressionNode,
    body: *BlockStmt,
}

pub struct DoWhileStmt {
    parent_node: *weak SyntaxNode,
    kw_do: Token,
    body: *BlockStmt,
    kw_while: Token,
    condition: *ExpressionNode,
    semicolon: Token,
}

pub struct ForStmt {
    parent_node: *weak SyntaxNode,
    kw_for: Token,
    pattern: *PatternNode,
    kw_in: Token,
    iterable: *ExpressionNode,
    body: *BlockStmt,
}

pub struct MatchArm {
    parent_node: *weak MatchStmt,
    pattern: *PatternNode,
    fat_arrow: Token,
    action: *StatementNode,
}

pub struct MatchStmt {
    parent_node: *weak SyntaxNode,
    kw_match: Token,
    match_expr: *ExpressionNode,
    lbrace: Token,
    arms: Vec<*MatchArm>,
    rbrace: Token,
}

pub struct ReturnStmt {
    parent_node: *weak SyntaxNode,
    kw_return: Token,
    return_expr: Option<*ExpressionNode>,
    semicolon: Token,
}

pub struct BreakStmt {
    parent_node: *weak SyntaxNode,
    kw_break: Token,
    label: Token,
    semicolon: Token,
}

pub struct ContinueStmt {
    parent_node: *weak SyntaxNode,
    kw_continue: Token,
    semicolon: Token,
}

pub struct GotoStmt {
    parent_node: *weak SyntaxNode,
    kw_goto: Token,
    label: Token,
    semicolon: Token,
}

pub struct PanicStmt {
    parent_node: *weak SyntaxNode,
    kw_panic: Token,
    panic_expr: Option<*ExpressionNode>,
    semicolon: Token,
}

pub struct LabelStmt {
    parent_node: *weak SyntaxNode,
    label: Token,
    colon: Token,
}

impl SyntaxNode for BlockStmt {
    fn span(&self) -> SourceSpan {
        return { .start = self.lbrace.span().start, .end = self.rbrace.span().end }: SourceSpan;
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_block(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        let mut children: Vec<*SyntaxNode> = (type Vec<*SyntaxNode>)::new();
        for stmt in self.stmts {
            children.push(move stmt as *SyntaxNode);
        }
        for decl in self.decls {
            children.push(move decl as *SyntaxNode);
        }
        return children;
    }

    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node as *weak SyntaxNode);
    }
    fn set_parent(&mut self, parent: *weak SyntaxNode) {
        self.parent_node = move parent;
    }
}

impl StatementNode for BlockStmt {}

impl SyntaxNode for EmptyStmt {
    fn span(&self) -> SourceSpan {
        return self.semicolon.span();
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_empty_stmt(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        return (type Vec<*SyntaxNode>)::new();
    }

    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node as *weak SyntaxNode);
    }
    fn set_parent(&mut self, parent: *weak SyntaxNode) {
        self.parent_node = move parent;
    }
}

impl StatementNode for EmptyStmt {}

impl SyntaxNode for LetStmt {
    fn span(&self) -> SourceSpan {
        let start = self.kw_let.span().start;
        let end = self.semicolon.span().end;
        return { .start = start, .end = end }: SourceSpan;
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_let_stmt(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        let mut children: Vec<*SyntaxNode> = (type Vec<*SyntaxNode>)::new();
        children.push(self.pattern as *SyntaxNode);
        children.push(self.init_expr as *SyntaxNode);
        return children;
    }

    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node as *weak SyntaxNode);
    }
    fn set_parent(&mut self, parent: *weak SyntaxNode) {
        self.parent_node = move parent;
    }
}

impl StatementNode for LetStmt {}

impl SyntaxNode for ExprStmt {
    fn span(&self) -> SourceSpan {
        let start = self.expr.span().start;
        let end = self.semicolon.span().end;
        return { .start = start, .end = end }: SourceSpan;
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_expr_stmt(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        let mut children: Vec<*SyntaxNode> = (type Vec<*SyntaxNode>)::new();
        children.push(self.expr as *SyntaxNode);
        return children;
    }

    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node as *weak SyntaxNode);
    }
    fn set_parent(&mut self, parent: *weak SyntaxNode) {
        self.parent_node = move parent;
    }
}

impl StatementNode for ExprStmt {}

impl SyntaxNode for IfStmt {
    fn span(&self) -> SourceSpan {
        let start = self.kw_if.span().start;
        if self.else_branch is Some(e) {
            let p = e as *SyntaxNode;
            return { .start = start, .end = p.span().end }: SourceSpan;
        } else {
            return { .start = start, .end = self.then_branch.span().end }: SourceSpan;
        }
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_if_stmt(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        let mut children: Vec<*SyntaxNode> = (type Vec<*SyntaxNode>)::new();
        children.push(self.condition as *SyntaxNode);
        children.push(self.then_branch as *SyntaxNode);
        if self.else_branch is Some(e) {
            children.push(move e as *SyntaxNode);
        }
        return children;
    }

    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node as *weak SyntaxNode);
    }
    fn set_parent(&mut self, parent: *weak SyntaxNode) {
        self.parent_node = move parent;
    }
}

impl StatementNode for IfStmt {}

