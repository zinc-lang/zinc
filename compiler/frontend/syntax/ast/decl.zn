impl SyntaxNode for ImplDecl {
    fn span(&self) -> SourceSpan {
        return self.kw_impl.source_span;
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_impl(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        let mut all: Vec<*SyntaxNode> = (type Vec<*SyntaxNode>)::with_capacity(2 + self.generic_params.len() + self.where_conds.len() + self.body_items.len());
        for p in self.generic_params {
            all.push(move p as *SyntaxNode);
        }
        if self.trait_ty is Some(tt) {
            all.push(move tt as *SyntaxNode);
        }
        all.push(self.target_ty as *SyntaxNode);
        for wc in self.where_conds {
            all.push(move wc as *SyntaxNode);
        }
        for bi in self.body_items {
            all.push(move bi as *SyntaxNode);
        }
        return all;
    }
    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node as *weak SyntaxNode);
    }
