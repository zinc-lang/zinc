pub enum UseDeclSegPart {
    Empty(Token),
    Word(Token), // ident
    WordAs(Token, Token), // ident + as-ident
    Star(Token), // 代表 use foo::*
    Brace(Token, Vec<UseDeclBody>, Token), // 代表 use foo::{a, b, c}
}

pub struct UseDeclBody {
    children: Vec<*UseDeclSegPart>,
}

pub struct UseDecl {
    parent_node: *weak SyntaxNode,
    kw_use: Token,
    use_decl_body: UseDeclBody,
    desugared_paths: Vec<UseDeclPath>,
}

pub struct GenericTypeParamDecl {
    parent_node: *weak SyntaxNode,
    name: Token,
    upper_bounds: Vec<*TypeNode>,
}

pub struct WhereCondDecl {
    parent_node: *weak SyntaxNode,
    lhs: *TypeNode,
    upper_bounds: Vec<*TypeNode>,
}

pub struct ReceiverParamDecl {
    punct: Token,
    kind: ReceiverKind,
    lifetime: Token,
    modifier1: Token,
    modifier2: Token,
    kw_self: Token,
}

pub enum ReceiverKind {
    Value, // self
    Borrow, // &self
    BorrowMut, // &mut self
    Arc, // *self
    Weak, // *weak self
    Raw, // *raw self
    RawMut, // *raw mut self
}

pub enum FnParamDeclKind {
    Receiver(*ReceiverParamDecl),
    Named(Token, *TypeNode, Option<*ExpressionNode>), // 命名参数
    Normal(Token, *TypeNode, Option<*ExpressionNode>), // name, type, default value
    Ellipsis(Token),
}

pub struct FnParamDecl {
    parent_node: *weak SyntaxNode,
    decl_kind: FnParamDeclKind,
}

impl FnParamDecl {
    pub fn name(&self) -> String {
        match self.decl_kind {
            FnParamDeclKind::Receiver(_) => return "self".to_string();
            FnParamDeclKind::Named(name1, _, _) => {
                let n = name1.raw_str();
                if n.as_str().deref().eq(&"_") { // 下划线跟空字符串都不算有效的参数名，直接当成没有名字
                    return String::new();
                } else {
                    return n;
                }
            }
            FnParamDeclKind::Normal(name2, _, _) => {
                let n = name2.raw_str();
                if n.as_str().deref().eq(&"_") { // 下划线跟空字符串都不算有效的参数名，直接当成没有名字
                    return String::new();
                } else {
                    return n;
                }
            }
            FnParamDeclKind::Ellipsis(_) => return String::new();
        }
    }

    pub fn span(&self) -> SourceSpan {
        match self.decl_kind {
            FnParamDeclKind::Receiver(r) => return r.kw_self.source_span;
            FnParamDeclKind::Named(name1, _, _) => return name1.source_span;
            FnParamDeclKind::Normal(name2, _, _) => return name2.source_span;
            FnParamDeclKind::Ellipsis(tok) => return tok.source_span;
        }
    }
}

