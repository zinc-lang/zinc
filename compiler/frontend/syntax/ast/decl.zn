impl SyntaxNode for EnumDecl {
    fn span(&self) -> SourceSpan {
        return self.name.source_span;
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_enum(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        let mut all: Vec<*SyntaxNode> = (type Vec<*SyntaxNode>)::with_capacity(2 + self.generic_params.len() + self.where_conds.len() + self.variants.len());
        for p in self.generic_params {
            all.push(move p as *SyntaxNode);
        }
        if self.repr_int.is Some(ri) {
            all.push(move ri as *SyntaxNode);
        }
        for wc in self.where_conds {
            all.push(move wc as *SyntaxNode);
        }
        for v in self.variants {
            all.push(move v as *SyntaxNode);
        }
        return all;
    }
    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node as *weak SyntaxNode);
    }
    fn set_parent(&mut self, parent: *weak SyntaxNode) {
        self.parent_node = move parent;
    }
}

