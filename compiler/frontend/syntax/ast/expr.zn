}

impl SyntaxNode for LambdaExpr {
    fn span(&self) -> SourceSpan {
        let start = self.lambda_start.span().start;
        let end = if self.body_expr is Some(e) 
                    then (e as *SyntaxNode).span().end
                    else if self.body_block is Some(b)
                        then (b as *SyntaxNode).span().end
                        else start;
        return { .start = start, .end = end }: SourceSpan;
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_lambda_expr(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        let mut arr: Vec<*SyntaxNode> = (type Vec<*SyntaxNode>)::new();
        for param in self.params {
            arr.push(move param as *SyntaxNode);
        }
        if self.return_type is Some(rt) {
            arr.push(move rt as *SyntaxNode);
        }
        if self.body_expr is Some(e) {
            arr.push(move e as *SyntaxNode);
        }
        if self.body_block is Some(b) {
            arr.push(move b as *SyntaxNode);
        }
        return arr;
    }

    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node);
    }
    fn set_parent(&mut self, parent: *weak SyntaxNode) {
        self.parent_node = move parent;
    }
}

impl ExpressionNode for LambdaExpr {
}

impl SyntaxNode for StructInitExpr {
    fn span(&self) -> SourceSpan {
        let start = self.lbrace.span().start;
        let end = self.rbrace.span().end;
        return { .start = start, .end = end }: SourceSpan;
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_struct_init_expr(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        let mut arr: Vec<*SyntaxNode> = (type Vec<*SyntaxNode>)::new();
        for ref field in self.fields_init {
            match field {
                FieldInitializer::Named(_, _, _, init1) => arr.push(move init1 as *SyntaxNode);
                FieldInitializer::Default(_, init2) => {
                    if init2 is Some(i) {
                        arr.push(move i as *SyntaxNode);
                    }
                }
            }
        }
        return arr;
    }

    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node);
    }
    fn set_parent(&mut self, parent: *weak SyntaxNode) {
        self.parent_node = move parent;
    }
}

impl ExpressionNode for StructInitExpr {
}

