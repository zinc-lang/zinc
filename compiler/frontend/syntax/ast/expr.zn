    parent_node: *weak SyntaxNode, 
    lhs: *ExpressionNode,
    assign_op: Token,
    rhs: *ExpressionNode,
}

pub struct BinaryExpr {
    parent_node: *weak SyntaxNode, 
    lhs: *ExpressionNode,
    op: Token,
    rhs: *ExpressionNode,
}

pub struct IsExpr {
    parent_node: *weak SyntaxNode, 
    lhs: *ExpressionNode,
    kw_is: Token,
    rhs: *PatternNode,
}

pub struct AsExpr {
    parent_node: *weak SyntaxNode, 
    lhs: *ExpressionNode,
    kw_as: Token,
    rhs: *TypeNode,
}

// 前缀单目运算符
// '-', '!'
// '&', '&mut', '&raw', '&raw mut'
// '*'
// 'box', 'move', 'await', 'yield'
enum UnaryExprKind {
    Neg,
    Not,
    Ref,
    RefMut,
    RefRaw,
    RefRawMut,
    Deref,
    Box,
    Move,
    Await,
    Yield,
}

pub struct UnaryExpr {
    parent_node: *weak SyntaxNode, 
    op1: Token,
    op2: Token, // optional
    op3: Token, // optional
    operand: *ExpressionNode,
    kind: UnaryExprKind,
}

pub struct QuestionExpr {
    parent_node: *weak SyntaxNode, 
    expr: *ExpressionNode,
    question: Token,
}

pub struct IndexExpr {
    parent_node: *weak SyntaxNode, 
    base: *ExpressionNode,
    lbracket: Token,
    index: *ExpressionNode,
    rbracket: Token,
}

pub struct ParenExpr {
    parent_node: *weak SyntaxNode, 
    lparen: Token,
    expr: *ExpressionNode,
    rparen: Token,
}

pub struct MemberAccessExpr {
    parent_node: *weak SyntaxNode, 
    base: *ExpressionNode,
    dot: Token,
    member: Token,
}

pub struct FnArg {
    parent_node: *weak SyntaxNode, 
    named: Token,
    value: *ExpressionNode,
}

impl FnArg {
    pub fn is_named(&self) -> Bool {
        return self.named.token_kind is TokenKind::Identifier;
    }
    pub fn span(&self) -> SourceSpan {
        if self.is_named() {
            let start = self.named.span().start;
            let end = self.value.span().end;
            return { .start = start, .end = end }: SourceSpan;
        } else {
            return self.value.span();
        }
    }
}

pub struct FnCallExpr {
    parent_node: *weak SyntaxNode, 
    callee: *ExpressionNode,
    type_args: Vec<*TypeNode>,
    lparen: Token,
    args: Vec<FnArg>,
    rparen: Token,
}

pub enum LambdaCaptureItem {
    Ident(Token), // by value capture
    Move(Token, Token), // by value capture with move
    Ref(Token, Token), // by reference capture
    RefMut(Token, Token, Token), // by mutable reference capture
    Weak(Token, Token), // weak capture
}

// 名字刻意与 hir 里的 LambdaCapture 区分开, 避免两个类型在 glob 导入后重名
impl LambdaCaptureItem {
    pub fn ident(&self) -> Token {
        match self {
            LambdaCaptureItem::Ident(t) => return t;
            LambdaCaptureItem::Move(_, t) => return t;
            LambdaCaptureItem::Ref(_, t) => return t;
            LambdaCaptureItem::RefMut(_, _, t) => return t;
            LambdaCaptureItem::Weak(_, t) => return t;
        }
    }
    pub fn is_ref(&self) -> Bool {
        if self is LambdaCaptureItem::Ref(_, _) {
            return true;
        }
        return false;
    }
    pub fn is_ref_mut(&self) -> Bool {
        if self is LambdaCaptureItem::RefMut(_, _, _) {
            return true;
        }
        return false;
    }
    pub fn is_weak(&self) -> Bool {
        if self is LambdaCaptureItem::Weak(_, _) {
            return true;
        }
        return false;
    }
}

pub struct LambdaExpr {
    parent_node: *weak SyntaxNode, 
    lambda_start: Token,
    qualifier_list: QualifierList,
    captures: Vec<LambdaCaptureItem>,
    generic_params: Vec<*GenericTypeParamDecl>,
    params: Vec<*FnParamDecl>,
    return_type: Option<*TypeNode>,
    where_conds: Vec<*WhereCondDecl>,
    fat_arrow: Token,
    body_expr: Option<*ExpressionNode>,
    body_block: Option<*BlockStmt>,
}

