// 中间有泛型参数
// (type mod1::S<T> as TR<U>)::method
// (type mod1::S<T>)::method
// (type mod1::S<T>::AssociatedType)::method
// 注: 类型命名没能表现出该语法的特点，想不出更好的名字
pub struct QualifiedPathExpr {
    parent_node: *weak SyntaxNode, 
    lparen: Token,
    kw_type: Token,
    ty: *TypeNode,
    kw_as: Token,
    trait_ty: Option<*TypeNode>,
    rparen: Token,
    rest_parts: *SegmentedName,
}

impl SyntaxNode for TernaryExpr {
    fn span(&self) -> SourceSpan {
        let start = self.kw_if.span().start;
        let end = self.else_branch.span().end;
        return { .start = start, .end = end }: SourceSpan;
    }
    fn visit(*self, visitor: &mut SyntaxVisitor) -> VisitResult  {
        return visitor.visit_ternary_expr(self);
    }
    fn children(&self) -> Vec<*SyntaxNode> {
        let mut vec = (type Vec<*SyntaxNode>)::with_capacity(3);
        vec.push(self.condition as *SyntaxNode);
        vec.push(self.then_branch as *SyntaxNode);
        vec.push(self.else_branch as *SyntaxNode);
        return vec;
    }

    fn parent(&self) -> Option<*weak SyntaxNode> {
        return Some(self.parent_node);
    }
    fn set_parent(&mut self, parent: *weak SyntaxNode) {
        self.parent_node = move parent;
    }
}

impl ExpressionNode for TernaryExpr {
}

