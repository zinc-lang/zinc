// todo 可以考虑让 then_branch 和 else_branch 也支持单个的跳转 statement
// 包括 return & panic 等，很多时候会比较方便
// 但是不要支持语句块。
pub struct TernaryExpr {
    parent_node: *weak SyntaxNode, 
    kw_if: Token,
    condition: *ExpressionNode,
    kw_then: Token,
    then_branch: *ExpressionNode,
    kw_else: Token,
    else_branch: *ExpressionNode,
}

pub struct ContextExpr {
    parent_node: *weak SyntaxNode, 
    kw_context: Token,
    lparen: Token,
    expr: *ExpressionNode,
    rparen: Token,
}

