    fn emit_where_clause_not_allowed(&mut self, span: SourceSpan) {
        self.emit({
            .span = span,
            .severity = Severity::Error,
            .msg_zn = f"不允许使用 where 子句",
            .msg_en = f"Where clause is not allowed",
        }: DiagItem);
    }

    fn emit_string_interpolation_inner_expr(&mut self, span: SourceSpan) {
        self.emit({
            .span = span,
            .severity = Severity::Error,
            .msg_zn = f"未完成特性: 目前插值字符串内部表达式只支持一个变量名不支持复杂表达式",
            .msg_en = f"incomplete feature: expression in string interpolation only surpport a single identifier for now",
        }: DiagItem);
    }

    fn emit_duplicate_name(&mut self, span: SourceSpan, name: String) {
        self.emit({
            .span = span,
            .severity = Severity::Error,
            .msg_zn = f"重复的名字: $(name)",
            .msg_en = f"Duplicate name: $(name)",
        }: DiagItem);
    }

    fn emit_jump_not_in_loop(&mut self, span: SourceSpan, name: Str) {
        self.emit({
            .span = span,
            .severity = Severity::Error,
            .msg_zn = f"$(name)语句只能出现在循环内部",
            .msg_en = f"$(name) statement can only appear inside a loop",
        }: DiagItem);
    }

    fn emit_default_init_position(&mut self, span: SourceSpan) {
        self.emit({
            .span = span,
            .severity = Severity::Error,
            .msg_zn = f"初始化表达式中的默认值只能在最后一个",
            .msg_en = f"the default initializer must be the last one inside struct initializer",
        }: DiagItem);
    }

    fn emit_name_not_ident_pattern(&mut self, span: SourceSpan) {
        self.emit({
            .span = span,
            .severity = Severity::Error,
            .msg_zn = f"名字模式只能是一个标识符",
            .msg_en = f"Name pattern can only be an identifier",
        }: DiagItem);
    }

    fn emit_rest_pattern_position(&mut self, span: SourceSpan) {
        self.emit({
            .span = span,
            .severity = Severity::Error,
            .msg_zn = f"剩余模式必须在模式列表的最后",
            .msg_en = f"Rest pattern must be the last one in the pattern list",
        }: DiagItem);
    }

    fn emit_pattern_must_be_ident(&mut self, span: SourceSpan) {
        self.emit({
            .span = span,
            .severity = Severity::Error,
            .msg_zn = f"此处只能是标识符模式",
            .msg_en = f"This pattern must be identifier pattern",
        }: DiagItem);
    }

    fn emit_ref_pattern_disallowed(&mut self, span: SourceSpan) {
        self.emit({
            .span = span,
            .severity = Severity::Error,
            .msg_zn = f"enum variant 模式中不允许使用 ref 模式匹配",
            .msg_en = f"ref pattern is not allowed in enum variant pattern",
        }: DiagItem);
    }

    fn emit_conflict_export_and_main(&mut self, span: SourceSpan) {
        self.emit({
            .span = span,
            .severity = Severity::Error,
            .msg_zn = f"一个组件不能既是库也是可执行程序, 但是在顶层模块中同时发现了 export 声明和 main 函数",
            .msg_en = f"a component can not be a library and an executable at the same time, but an export decl and a main function both exist",
        }: DiagItem);
    }

    fn emit_neither_lib_nor_exe(&mut self, span: SourceSpan) {
        self.emit({
            .span = span,
            .severity = Severity::Error,
            .msg_zn = f"一个组件必须是库或者可执行程序, 但是在顶层模块中既没有 export 声明也没有 main 函数",
            .msg_en = f"a component must be a library or an executable, but neither export decl nor main function is found",
        }: DiagItem);
    }

}
