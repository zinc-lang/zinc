mod sentences;
mod values;

use ::self::frontend::semantic::*;
use ::self::frontend::semantic::mir::ir::*;
use ::self::frontend::semantic::hir::ir::*;
use ::self::frontend::semantic::hir::builder::resolver::*;
use ::self::frontend::semantic::hir::checker::type_cast::*;
use ::self::frontend::syntax::ast::*;
use ::self::frontend::syntax::token::*;
use std::collections::hashset::HashSet;

struct CfgBuilder {
    semantic_model: *SemanticModel,
    resolver: Resolver,
    sym: *Symbol, // FuncSymbol 或者 LambdaSymbol
    basic_blocks: Vec<*BasicBlock>,
    block_stack: Vec<*BlockSentence>,
    // 当前语句产生的临时变量 (语句结束时由 record_temps_drop_point 登记析构点后移出)
    temps: Vec<*TempVar>,
    // 本函数所有临时变量, 以及按符号查找的表
    all_temps: Vec<*TempVar>,
    temp_map: HashMap<UInt, *TempVar>,
    cached_lvalue: HashMap<UInt, *LValue>,
    cached_rvalue: HashMap<UInt, *RValue>,

    // 循环开始的地方和结束的地方, key 是 *LoopSentence
    loop_start: HashMap<UInt, *BasicBlock>,
    loop_end: HashMap<UInt, *BasicBlock>,
}

struct BasicBlockChunk {
    start: *BasicBlock,
    end: *BasicBlock,
}

impl CfgBuilder {
    fn new(sm: *SemanticModel, sym: *Symbol, r: Resolver) -> Self {
        return {
            .semantic_model = move sm,
            .resolver = move r,
            .sym = move sym,
            .basic_blocks = (type Vec<*BasicBlock>)::new(),
            .block_stack = (type Vec<*BlockSentence>)::new(),
            .temps = (type Vec<*TempVar>)::new(),
            .all_temps = (type Vec<*TempVar>)::new(),
            .temp_map = (type HashMap<UInt, *TempVar>)::new(),
            .cached_lvalue = (type HashMap<UInt, *LValue>)::new(),
            .cached_rvalue = (type HashMap<UInt, *RValue>)::new(),
            .loop_start = (type HashMap<UInt, *BasicBlock>)::new(),
            .loop_end = (type HashMap<UInt, *BasicBlock>)::new(),
        }: CfgBuilder;
    }

    fn params(&self) -> Vec<*VarSymbol> {
        if self.sym is fsym: *FuncSymbol {
            return fsym.params;
        }
        if self.sym is lsym: *LambdaSymbol {
            return lsym.params;
        }
        panic "BUG: CfgBuilder::params with an unexpected symbol";
    }

    fn build(&mut self) -> Option<*CFG> {
        if self.sym is fsym: *FuncSymbol {
            if fsym.body is None {
                return None;
            }
            let body = fsym.body.get_or_panic();
            let bb_pair = self.trans_block(body);
            self.flush_all_temps(bb_pair.end);
            // drop params
            for p in self.params() {
                self.drop_var_sym(move p, bb_pair.end);
            }
            return Some(box {
                .sym = self.sym,
                .basic_blocks = bb_pair.topological_order(),
                .temps = self.all_temps,
                .temp_map = self.temp_map,
            }: CFG);
        }

        if self.sym is lsym: *LambdaSymbol {
            if lsym.body_block is None {
                return None;
            }
            let body = lsym.body_block.get_or_panic();

            if lsym.body_expr is Some(expr) {
                // 表达式体: 翻译成"块的末尾隐式 return 这个表达式"。
                // 仍然把 body_block 压栈, 这样产生的临时变量会挂在它上面,
                // 供代码生成阶段分配局部变量。
                self.block_stack.push(body);
                let bb = self.new_bb();
                let (rv, end_bb) = self.trans_rvalue(expr, bb);
                end_bb.terminator = Some(box {
                    .ret_val = Some(rv)
                }: BrRet as *Terminator);
                self.flush_all_temps(end_bb);
                self.block_stack.pop();

                let bb_pair = { .start = move bb, .end = move end_bb }: BasicBlockChunk;
                for p in self.params() {
                    self.drop_var_sym(move p, bb_pair.end);
                }
                return Some(box {
                    .sym = self.sym,
                    .basic_blocks = bb_pair.topological_order(),
                    .temps = self.all_temps,
                    .temp_map = self.temp_map,
                }: CFG);
            }

            let bb_pair = self.trans_block(body);
            self.flush_all_temps(bb_pair.end);
            for p in self.params() {
                self.drop_var_sym(move p, bb_pair.end);
            }
            return Some(box {
                .sym = self.sym,
                .basic_blocks = bb_pair.topological_order(),
                .temps = self.all_temps,
                .temp_map = self.temp_map,
            }: CFG);
        }

        return None;
    }

    fn new_bb(&mut self) -> *BasicBlock {
        let bb = box {
            .index = 0_u,
            .debug_string = String::new(),
            .outside_block = self.nearest_block(),
            .steps = (type Vec<Step>)::new(),
            .terminator = None,
            .incomings = (type Vec<*BasicBlock>)::new(),
        }: BasicBlock;
        return bb;
    }

    fn new_bb(&mut self, name: String) -> *BasicBlock {
        let bb = box {
            .index = 0_u,
            .debug_string = move name,
            .outside_block = self.nearest_block(),
            .steps = (type Vec<Step>)::new(),
            .terminator = None,
            .incomings = (type Vec<*BasicBlock>)::new(),
        }: BasicBlock;
        return bb;
    }

    fn new_temp(&mut self, v: *RValue, bb: *BasicBlock) -> *LocalVar {

        let sty = v.get_stype();
        if sty.is_invalid() {
            panic;
        }
        let var_sym = VarSymbol::create(v.expr_node().span(), sty);
        self.nearest_block().add_local(var_sym);

        // 登记临时变量: 默认在语句结束时析构 (析构标记由 record_temps_drop_point 插入)
        let temp = box {
            .sym = var_sym,
            .drop_step = (type Option<*DtorValue>)::None,
            .extended = false,
        }: TempVar;
        self.temps.push(temp);
        self.all_temps.push(temp);
        self.temp_map.insert(var_sym as *raw VarSymbol as UInt, move temp);

        let local = LocalVar::create(v.expr_node().span(), var_sym);
        if has_copy_fn(sty) && !self.rvalue_owns_value(v) {
            let copy = CopyValue::create(v.expr_node(), v);
            bb.add_step(move copy as *XValue);
        }

        bb.add_step(WriteValue::create(v, local as *LValue));
        return local;
    }

    // 判据: 源右值是否"自己已经持有一份强引用"。
    fn rvalue_owns_value(&self, v: *RValue) -> Bool {
        match v {
            // 拥有型: 结果自带一次强引用
            type *FnCallValue => return true;
            type *MethodCallValue => return true;
            type *AggregateValue => return true;
            type *TupleValue => return true;
            type *ArrayLiteralValue => return true;
            type *RepeatValue => return true;
            type *BinaryExprValue => return true;
            type *UnaryExprValue => return true;
            type *MovedValue => return true;

            // 视图型: 只读已有存储, 读本身不 retain
            type *ReadValue => return false;
            type *FieldRValue => return false;
            type *IndexRValue => return false;
            type *TupleAccessRValue => return false;
            type *DerefRValue => return false;
            type *VariantPayloadValue => return false;
            type *LiteralValue => return false;
            type *AddressofValue => return false;
            type *ReBorrowValue => return false;

            // 透明: 所有权在操作数/内层上
            ctx_rv: *ContextValue => return self.rvalue_owns_value(ctx_rv.inner);
            ty_asc_rv: *TypeAscriptionValue => return self.rvalue_owns_value(ty_asc_rv.inner);
            alloca_rv: *AllocaValue => return self.rvalue_owns_value(alloca_rv.src);
            load_rv: *LoadValue => return self.rvalue_owns_value(load_rv.src);

            cast_rv: *CastValue => {
                match cast_rv.resolved_kind {
                    ResolvedCastKind::Err => return true;
                    ResolvedCastKind::GenericFunctionToFnLower => return true;
                    ResolvedCastKind::CaptureLambdaToFnLower => return true;
                    ResolvedCastKind::MutCaptureLambdaToFn => return true;
                    ResolvedCastKind::OwnedFnUpperErasesLifetime => return true;
                    ResolvedCastKind::OwnedTraitObjectErasesLifetime => return true;

                    ResolvedCastKind::SameType => return self.rvalue_owns_value(cast_rv.operand);
                    ResolvedCastKind::BoolToInt => return false;
                    ResolvedCastKind::IntToInt => return false;
                    ResolvedCastKind::IntToFloat => return false;
                    ResolvedCastKind::EnumToInt => return false;
                    ResolvedCastKind::FloatExt => return false;
                    ResolvedCastKind::FloatTrunc => return false;
                    ResolvedCastKind::FloatToInt => return false;
                    ResolvedCastKind::CharToUInt32 => return false;
                    ResolvedCastKind::UInt32ToChar => return false;
                    ResolvedCastKind::ArrayRefToSlice => return false;
                    ResolvedCastKind::FunctionToFnLower => return false;
                    ResolvedCastKind::FunctionToFnUpperBorrow => return false;
                    ResolvedCastKind::FnLowerToFnUpperBorrow => return false;
                    ResolvedCastKind::LambdaToFnLower => return false;
                    ResolvedCastKind::LambdaToFnUpperPtr => return false;
                    ResolvedCastKind::MutBorrowToImmut => return false;
                    ResolvedCastKind::PointerSafeToUnsafe => return false;

                    ResolvedCastKind::ArcToWeak => return true;
                    ResolvedCastKind::TypedPtrToUnitPtr => return true;
                    ResolvedCastKind::PointerUnsafeToSafe => return true;
                    ResolvedCastKind::UnsafePointerToUnsafePointer => return false;
                    ResolvedCastKind::UnsafePointerToUInt => return false;
                    ResolvedCastKind::UIntToUnsafePointer => return false;
                    ResolvedCastKind::ThinPtrUpToFatPtr => return true;
                    ResolvedCastKind::FatPtrDownToThinPtr => return true;
                    ResolvedCastKind::FatPtrToFatPtr => return true;
                    ResolvedCastKind::DerefCast(_) => return true;
                    ResolvedCastKind::DerefMutCast(_) => return true;
                    ResolvedCastKind::LifetimeCast => return self.rvalue_owns_value(cast_rv.operand);
                    _ => return self.rvalue_owns_value(cast_rv.operand);
                }
            }
            // 保守回退 (PhiValue / SelectValue / 未列出): 当作需要 copy
            _ => return false;
        }
        return false;
    }

    fn nearest_block(&self) -> *BlockSentence {
        if self.block_stack.is_empty() {
            panic "BUG: block_stack is empty in CfgBuilder::nearest_block.";
        }
        let len = self.block_stack.len();
        return *self.block_stack.index(len-1).deref();
    }

    fn drop_lvalue(&mut self, lvar: *LValue, bb: *BasicBlock) {
        // if access by raw pointer, ignore dtor
        if lvar is d: *DerefLValue {
            let sty = d.operand.get_stype();
            if sty.type_symbol is type *RawPointerImmutSymbol ||
                sty.type_symbol is type *RawPointerMutSymbol {
                return;
            }
        }

        if has_destructor(lvar.get_stype()) {
            let d = DtorValue::create(lvar.expr_node().span(), move lvar);
            bb.add_step(move d as *XValue);
        }
    }

    fn drop_var_sym(&mut self, vs: *VarSymbol, bb: *BasicBlock) {
        // 没有析构函数的类型也会生成一条 is_trivial 的指令:
        // 它依然承担"变量存储期到此结束"的语义, 存活分析依赖它判断变量的死亡点。
        bb.add_step(make_dtor_value(vs) as *XValue);
    }

    fn drop_locals_when_exit_block(&mut self, blk: *BlockSentence, bb: *BasicBlock) {
        // 如果 block 包含 return/panic 则不需要执行了
        if blk.contains_return_or_panic() {
            return;
        }
        // 逆序遍历
        let mut i: UInt = blk.local_vars.len();
        while i > 0 {
            let var: *VarSymbol = *blk.local_vars.index(i - 1).deref();
            self.drop_var_sym(move var, bb);
            i -= 1;
        }
    }

    fn drop_locals_until_exit_block(&mut self, blk: UInt, bb: *BasicBlock) {
        // 逆序遍历
        let mut i: UInt = self.block_stack.len();
        while i > 0 {
            let block: *BlockSentence = *self.block_stack.index(i - 1).deref();
            self.drop_locals_when_exit_block(block, bb);
            if block as *raw BlockSentence as UInt == blk {
                return;
            }
            i -= 1;
        }
        panic "BUG: [drop_locals_until_exit_block] target block does not found in block_stack";
    }

    fn drop_all_except(&mut self, except_var: Option<*VarSymbol>, bb: *BasicBlock) {

        let mut except_var_i: UInt = 0;
        if except_var is Some(v) {
            except_var_i = v as *raw VarSymbol as UInt;
        }
        // 逆序遍历
        let mut i: UInt = self.block_stack.len();
        while i > 0 {
            let block: *BlockSentence = *self.block_stack.index(i - 1).deref();

            let mut j: UInt = block.local_vars.len();
            while j > 0 {
                let var: *VarSymbol = *block.local_vars.index(j - 1).deref();
                let var_int = var as *raw VarSymbol as UInt;
                if var_int != except_var_i {
                    self.drop_var_sym(var, bb);
                }
                j -= 1;
            }
            i -= 1;
        }

        for p in self.params() {
            if p as *raw VarSymbol as UInt != except_var_i {
                self.drop_var_sym(move p, bb);
            }
        }
    }

    fn insert_copy(&mut self, rval: *RValue, bb: *BasicBlock) {
        if !has_copy_fn(rval.get_stype()) {
            return;
        }
        let copy = CopyValue::create(rval.expr_node(), rval);
        bb.add_step(move copy as *XValue);
    }

    fn insert_copy_if_needed(&mut self, rval: *RValue, bb: *BasicBlock) {
        if !has_copy_fn(rval.get_stype()) {
            return;
        }

        // 临时变量是不需要 copy 的
        match rval {
            cast_rv: *CastValue => {
                match cast_rv.resolved_kind {
                    // 这些都不需要做 拷贝
                    ResolvedCastKind::ArcToWeak => return;
                    ResolvedCastKind::BoolToInt => return;
                    ResolvedCastKind::IntToInt => return;
                    ResolvedCastKind::IntToFloat => return;
                    ResolvedCastKind::EnumToInt => return;
                    ResolvedCastKind::FloatExt => return;
                    ResolvedCastKind::FloatTrunc => return;
                    ResolvedCastKind::FloatToInt => return;
                    ResolvedCastKind::CharToUInt32 => return;
                    ResolvedCastKind::UInt32ToChar => return;
                    ResolvedCastKind::ArrayRefToSlice => return;
                    ResolvedCastKind::MutBorrowToImmut => return;
                    ResolvedCastKind::PointerSafeToUnsafe => return;
                    ResolvedCastKind::PointerUnsafeToSafe => return;
                    ResolvedCastKind::UnsafePointerToUnsafePointer => return;
                    ResolvedCastKind::UnsafePointerToUInt => return;
                    ResolvedCastKind::UIntToUnsafePointer => return;
                    ResolvedCastKind::DerefCast(_) => return;
                    ResolvedCastKind::DerefMutCast(_) => return;
                    ResolvedCastKind::ArcToWeak => {
                        let copy = CopyValue::create(rval.expr_node(), rval);
                        bb.add_step(move copy as *XValue);
                        return;
                    }
                    _ => {
                        self.insert_copy_if_needed(cast_rv.operand, bb);
                        return;
                    }
                }
            }
            type *QualifiedPathValue => return;
            type *LambdaValue => return;
            type *WriteValue => return;
            type *LiteralValue => return;
            type *AggregateValue => return;
            type *TupleValue => return;
            type *ArrayLiteralValue => return;
            type *RepeatValue => return;
            type *BinaryExprValue => return;
            type *UnaryExprValue => return;
            type *AddressofValue => return;
            type *PatternMatchValue => return;
            type *FnCallValue => return;
            type *MethodCallValue => return;
            type *InterpolationValue => return;
            type *CompileTimeValue => return;
            type *DtorValue => return;
            type *CopyValue => return;
            type *ReBorrowValue => return;
            type *MovedValue => return;
            ctx_rv: *ContextValue => return self.insert_copy_if_needed(ctx_rv.inner, bb);
            ty_asc_rv: *TypeAscriptionValue => return self.insert_copy_if_needed(ty_asc_rv.inner, bb);

            deref_rv: *DerefRValue => {
                // deref 的结果需要 copy, raw pointer 除外
                let op_sty = deref_rv.operand.get_stype();
                if op_sty.type_symbol is type *RawPointerImmutSymbol ||
                    op_sty.type_symbol is type *RawPointerMutSymbol {
                    return;
                } else {
                    let copy = CopyValue::create(rval.expr_node(), rval);
                    bb.add_step(move copy as *XValue);
                }
            }
            _ => {
                let copy = CopyValue::create(rval.expr_node(), rval);
                bb.add_step(move copy as *XValue);
            }
        }
    }

    // 语句翻译完了: 给 watermark 之后新增的临时变量在 bb 上插入析构标记。
    // 如果之后发现它的借用活得比语句长, checker 里的 place_temp_drops 会把它标成 skipped。
    //
    // 注意这里插入的是一条 step (而不是只记下 bb): 记 bb 等于要求"语句结束时所在的块
    // 以后一直是同一个块对象", 而语句的块之后还可能被拆分/合并; 插入 step 则跟着块一起走。
    fn record_temps_drop_point(&mut self, watermark: UInt, bb: *BasicBlock) {
        let mut i = watermark;
        while i < self.temps.len() {
            let t = *self.temps.index(i).deref();
            let dtor = make_dtor_value(t.sym);
            bb.add_step(dtor as *XValue);
            t.drop_step = Some(dtor);
            i += 1;
        }
        while self.temps.len() > watermark {
            self.temps.pop();
        }
    }

    // 把当前所有还没登记的临时变量都登记到 bb (函数/闭包体翻译完之后的兜底)
    fn flush_all_temps(&mut self, bb: *BasicBlock) {
        self.record_temps_drop_point(0_u, bb);
    }

}

impl BasicBlockChunk {

    fn topological_order(&self) -> Vec<*BasicBlock> {
        let mut all = (type HashSet<UInt>)::new();
        setup_incomings(self.start, &mut all);

        let mut ordered = (type Vec<*BasicBlock>)::new();

        let mut to_be_visit = (type Vec<*BasicBlock>)::new();
        to_be_visit.push(self.start);

        while !to_be_visit.is_empty() {
            let first: Option<*BasicBlock> = to_be_visit.pop_front();
            if first is Some(cur) {
                ordered.push(cur);
                if cur.terminator is Some(terminator) {
                    if !(terminator is type *BrBackward) {
                        let successors = terminator.successors();
                        for s in successors {
                            s.index += 1;
                            if s.index == s.incomings.len() {
                                to_be_visit.push(move s);
                            }
                        }
                    }
                }
            } else {
                break;
            }
        }

        // 设置 index
        let mut i: UInt = 0;
        for bb in ordered {
            bb.index = i;
            i += 1;
        }
        return ordered;
    }

    fn dump(&self) {
        let bbs = self.topological_order();
        for bb in bbs {
            bb.dump();
        }
    }
}

fn setup_incomings(bb: *BasicBlock, visited: &mut HashSet<UInt>) {
    let bb_i = bb as *raw BasicBlock as UInt;
    if visited.contains(&bb_i) {
        return;
    }
    visited.insert(bb_i);

    if bb.terminator is Some(terminator) {
        if !(terminator is type *BrBackward) {
            let successors = terminator.successors();
            for s in successors {
                s.incomings.push(bb);
                setup_incomings(move s, visited);
            }
        }
    }
}

fn extract_logical_and_chain(v: *RValue) -> Option<Vec<*RValue>> {
    let mut res = (type Vec<*RValue>)::new();
    if rec_extract_logical_and_chain(v, &mut res) {
        return Some(move res);
    } else {
        return None;
    }
}

fn rec_extract_logical_and_chain(v: *RValue, res: &mut Vec<*RValue>) -> Bool {
    if v is be: *BinaryExprValue {
        if be.op.token_kind is TokenKind::Punctuation(PunctuationKind::AndAnd) {
            return rec_extract_logical_and_chain(be.lhs, res) && rec_extract_logical_and_chain(be.rhs, res);
        }
        else if be.op.token_kind is TokenKind::Punctuation(PunctuationKind::OrOr) {
            return false;
        }
        else {
            res.push(be as *RValue);
        }
    } else {
        res.push(v);
    }
    return true;
}