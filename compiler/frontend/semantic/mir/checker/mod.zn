use super::ir::*;
use ::self::frontend::source_code::*;
use ::self::frontend::diagnostic::*;
use ::self::frontend::semantic::hir::ir::*;

mod drop_place;
mod liveness;
mod loan;
mod uint_set;
mod verify;

use liveness::*;
use uint_set::*;

impl CFG {
    fn check(*self) {
        self.check_unterminated_bb();

        self.check_liveness();
    }

    // 检查哪个 bb 没有 terminator
    fn check_unterminated_bb(*self) {
        let mut return_unit = true;
        if self.return_sty() is Some(t) {
            return_unit = t.is_unit();
        }

        for bb in self.basic_blocks {
            if bb.terminator is None {
                if return_unit {
                    bb.terminator = Some(box {
                        .ret_val = None
                    }: BrRet as *Terminator);
                } else {
                    let mut span = self.name_span();
                    if !bb.steps.is_empty() {
                        let last = *bb.steps.index(bb.steps.len() - 1).deref();
                        span = last.value.expr_node().span();
                    }
                    DiagnosticEngine::get().emit_func_missing_return(move span);
                }
            }
        }
    }

    fn check_liveness(*self) {
        let mut liveness_checker = LivenessChecker::new(self);
        liveness_checker.determine_origins();
        // 唯一的析构插入点
        liveness_checker.place_temp_drops();
        liveness_checker.determine_local_liveness();
        // 所有权自检 (防回归): 漏析构 / 重复析构 / use-after-drop / 右值层所有权
        let drop_counts = liveness_checker.verify_drops();
        liveness_checker.verify_rvalue_ownership(&drop_counts);
        // 外部接手方 (实参/返回值/写目标基址) 核对
        liveness_checker.verify_transfers();
        liveness_checker.check_lifetime();
    }
}

// todo: 对 'a 和 'b 这种命名生命周期做检查

// 一个指针值可能的来源集合 (may-origin)。
// 与 liveness 的"确定存活"相反, 这是一个 may 分析, 汇合点取并集。
struct OriginSet {
    locals: UIntSet,   // 可能指向的局部变量 (*VarSymbol)
    has_static: Bool,  // 可能指向 static/const
    has_raw: Bool,     // 可能是原始指针, 不做生命周期约束
    has_unknown: Bool, // 来源无法解析
}

struct LivenessChecker {
    cfg: *CFG,
    alive_locals_at_point: HashMap<LivePoint, UIntSet>, // 通过 LivePoint 查找哪些 *VarSymbol 在这里是活的
    may_alive_locals_at_point: HashMap<LivePoint, UIntSet>, // 同上, 但取并集 (may)
    local_liveness: HashMap<UInt, UIntSet>, // 通过 *VarSymbol 查找它在哪些 LivePoint 上是活的
    origin_in_states: HashMap<UInt, HashMap<UInt, OriginSet>>, // bb -> (局部变量 -> 它可能指向的来源)
}
