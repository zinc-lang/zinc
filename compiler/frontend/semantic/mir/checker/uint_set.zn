use std::collections::hashset::HashSet;
use std::collections::hashset::HashSetIter;

// HashSet<UInt> 以前在 liveness 这种「大量 insert/remove 不同指针 key」的负载下
// 会卡死, 所以这里曾经手写过一个排序数组版。根因不在 UInt 的 Hash/Eq, 也不在泛型,
// 而在 HashMap: (1) lookup 只跳墓碑、只在 Vacant 退出, 表被墓碑填满就死循环;
// (2) insert 先占 Tombstone 会写出重复 key, size 虚高后每次插入都 resize。
// HashMap 修好之后就可以包一层 HashSet。
struct UIntSet {
    inner: HashSet<UInt>,
}

impl UIntSet {
    fn new() -> Self {
        return {
            .inner = (type HashSet<UInt>)::new(),
        }: UIntSet;
    }

    fn len(&self) -> UInt {
        return self.inner.len();
    }

    fn dump(&self) {
        let keys = self.inner.keys();
        let mut i: UInt = 0;
        while i < keys.len() {
            let value = keys.at(i).get_or_panic();
            print(value);
            print(" ");
            i += 1_u;
        }
        println();
    }

    fn to_unique(&mut self) {
        self.inner.to_unique();
    }

    fn insert(&mut self, value: UInt) {
        self.inner.insert(value);
    }

    fn remove(&mut self, value: UInt) {
        self.inner.remove(&value);
    }

    fn contains(&self, value: UInt) -> Bool {
        return self.inner.contains(&value);
    }

    fn intersect_set(&mut self, other: &UIntSet) {
        let mut res = UIntSet::new();
        let keys = self.inner.keys();
        let mut i: UInt = 0;
        while i < keys.len() {
            let value = keys.at(i).get_or_panic();
            if other.contains(value) {
                res.insert(value);
            }
            i += 1_u;
        }
        *self = move res;
    }

    fn union_set(&mut self, other: &UIntSet) {
        let keys = other.inner.keys();
        let mut j: UInt = 0;
        while j < keys.len() {
            let value = keys.at(j).get_or_panic();
            self.insert(value);
            j += 1_u;
        }
    }

    fn is_superset_of(&self, other: &UIntSet) -> Bool {
        let keys = other.inner.keys();
        let mut j: UInt = 0;
        while j < keys.len() {
            let value = keys.at(j).get_or_panic();
            if !self.contains(value) {
                return false;
            }
            j += 1_u;
        }
        return true;
    }

    fn is_subset_of(&self, other: &UIntSet) -> Bool {
        let keys = self.inner.keys();
        let mut i: UInt = 0;
        while i < keys.len() {
            let value = keys.at(i).get_or_panic();
            if !other.contains(value) {
                return false;
            }
            i += 1_u;
        }
        return true;
    }
}

impl Iterable for UIntSet {
    type Iter<'i> = HashSetIter<'i, UInt>;

    fn iter<'a>(&'a self) -> HashSetIter<'a, UInt> {
        return self.inner.iter();
    }
}
