use ::self::frontend::semantic::mir::ir::*;
use ::self::frontend::semantic::hir::ir::*;
use std::cmp::{Eq, PartialEq};
use std::hash::{Hash, Hasher};

use super::uint_set::UIntSet;
use super::*;

use ::self::frontend::source_code::*;
use ::self::frontend::diagnostic::*;

// 1. 搜集所有 lvalue 的 liveness
//    1.1 检查变量 use before initialization (暂时强制要求变量定义必须初始化)
//    1.2 检查变量 use after move
// 2. 搜集借用的指向关系, 比较借用变量 r 和 被借用变量的 liveness
//    2.1 检查借用类型的 liveness 小于等于被指向的对象的 liveness
//    注意借用指针的指向不是一成不变的，它会更改指向目标
// 3. drop check
//    3.1 分辨哪些地方要调用析构函数、哪些地方不能调用，以及最特别的是哪些地方需要 drop flag

impl LivenessChecker {
    fn new(cfg: *CFG) -> Self {
        return {
            .cfg = move cfg,
            .alive_locals_at_point = (type HashMap<LivePoint, UIntSet>)::new(),
            .may_alive_locals_at_point = (type HashMap<LivePoint, UIntSet>)::new(),
            .local_liveness = (type HashMap<UInt, UIntSet>)::new(),
            .origin_in_states = (type HashMap<UInt, HashMap<UInt, OriginSet>>)::new(),
        }: LivenessChecker;
    }

    // "可能还活着" (may-alive) 的数据流: 汇合点取**并集**, 迭代到不动点。
    // 与 alive_locals_at_point ("确定存活", 交集) 相对。
    // origin 是 may 分析, 判断"引用是不是悬垂"时只有在一个来源于所有路径上都不再
    // 存活时才能报错: 例如一个临时量只在 if 的 then 分支上创建, 汇合点的
    // "确定存活"集合 (交集) 里没有它, 但它的析构点其实还在使用点之后。
    fn determine_may_liveness(&mut self) {
        let mut in_states = (type HashMap<UInt, UIntSet>)::new();
        for bb in self.cfg.basic_blocks {
            let mut s = UIntSet::new();
            if bb.index == 0 {
                for param in self.cfg.params() {
                    s.insert(param as *raw VarSymbol as UInt);
                }
                if self.cfg.sym is lsym: *LambdaSymbol {
                    for c in lsym.captures {
                        s.insert(c.outer_var as *raw VarSymbol as UInt);
                        s.insert(c.local_var as *raw VarSymbol as UInt);
                    }
                }
            }
            in_states.insert(bb as *raw BasicBlock as UInt, move s);
        }

        let first = *self.cfg.basic_blocks.index(0).deref();
        let mut work = (type Vec<*BasicBlock>)::new();
        work.push(first);
        while !work.is_empty() {
            let bb = work.pop().get_or_panic();
            let bb_key = bb as *raw BasicBlock as UInt;
            let entry = in_states.at(&bb_key).get_or_panic();
            let out_state = self.may_alive_out(bb, &entry);
            if bb.terminator is Some(term) {
                for succ in term.successors() {
                    let succ_key = succ as *raw BasicBlock as UInt;
                    if in_states.get_mut(&succ_key) is Some(mut succ_in) {
                        if !succ_in.deref().is_superset_of(&out_state) {
                            succ_in.deref_mut().union_set(&out_state);
                            work.push(succ);
                        }
                    }
                }
            }
        }

        // 用收敛后的入口状态在块内重放, 记录每个程序点上的集合
        for bb in self.cfg.basic_blocks {
            let bb_key = bb as *raw BasicBlock as UInt;
            let mut cur = UIntSet::new();
            cur.union_set(&in_states.at(&bb_key).get_or_panic());
            let mut step_idx: UInt = 0;
            for step in bb.steps {
                self.may_alive_locals_at_point.insert(LivePoint::new(bb.index, step_idx), cur);
                self.may_apply(step.value, &mut cur);
                step_idx += 1;
            }
            self.may_alive_locals_at_point.insert(LivePoint::new(bb.index, step_idx), move cur);
        }
    }

    // 一条指令对 may-alive 集合的影响 (与 visit_bb 里对 alived 的更新一致)
    fn may_apply(&self, value: *XValue, set: &mut UIntSet) {
        if value is w: *WriteValue {
            if extract_local(w.dst as *XValue) is Some(vs) {
                set.insert(vs as *raw VarSymbol as UInt);
            }
        } else if value is d: *DtorValue {
            // 被取消的"语句末析构"完全失效, 变量继续存活
            if !d.skipped {
                if extract_local(d.src as *XValue) is Some(vs) {
                    set.remove(vs as *raw VarSymbol as UInt);
                }
            }
        } else if value is m: *MovedValue {
            if extract_local(m.src as *XValue) is Some(vs) {
                set.remove(vs as *raw VarSymbol as UInt);
            }
        }
    }

    fn may_alive_out(&self, bb: *BasicBlock, in_state: &UIntSet) -> UIntSet {
        let mut state = UIntSet::new();
        state.union_set(in_state);
        for step in bb.steps {
            self.may_apply(step.value, &mut state);
        }
        return state;
    }

    // 查询某个程序点上"可能存活"的变量集合
    fn may_alive_at(&self, bb_idx: UInt, step_idx: UInt) -> UIntSet {
        let p = LivePoint::new(bb_idx, step_idx);
        if self.may_alive_locals_at_point.at(&p) is Some(s) {
            return s;
        }
        return UIntSet::new();
    }

    // 注意: 需要第二轮遍历, 确保循环的时候 use after move 可以报错
    fn determine_local_liveness(&mut self) {
        for bb in self.cfg.basic_blocks {
            self.visit_bb(move bb);
        }
        for bb in self.cfg.basic_blocks {
            // 如果存在循环, 要保证被 move 后的变量没有被继续使用
            if bb.terminator is Some(back: *BrBackward) {
                self.handle_move_in_loop(back.target, bb);
            }
        }

        // 遍历完毕, 已知每个点上活着哪些变量, 就可以得出每个变量在哪些点上活着
        for ref kv in self.alive_locals_at_point {
            let lp = kv.0;
            let vars = &kv.1;

            for var in vars {
                if self.local_liveness.get_mut(&var) is Some(mut points) {
                    points.deref_mut().insert(lp.to_uint());
                } else {
                    let mut points = UIntSet::new();
                    points.insert(lp.to_uint());
                    self.local_liveness.insert(var, move points);
                }
            }
        }
    }

    // 查询某个程序点上"确定存活"的变量集合 (供 loan 检查使用, 避免它直接依赖 LivePoint)
    fn alive_at(&self, bb_idx: UInt, step_idx: UInt) -> UIntSet {
        let p = LivePoint::new(bb_idx, step_idx);
        if self.alive_locals_at_point.at(&p) is Some(s) {
            return s;
        }
        return UIntSet::new();
    }

    fn visit_bb(&mut self, bb: *BasicBlock) {
        let mut alived: UIntSet = UIntSet::new(); // 保存的是 *VarSymbol
        let mut dead: UIntSet = UIntSet::new(); // 保存的是 *VarSymbol

        if bb.index == 0 {
            // 入口, 用参数初始化
            for param in self.cfg.params() {
                let p = param as *raw VarSymbol as UInt;
                alived.insert(p);
            }
            // 闭包体里引用的外层变量既不是这个 CFG 的参数也不是它的局部变量,
            // 它们的存储期属于外层函数, 这里当作一开始就活着。
            // (否则闭包体里读一个捕获变量会被误报成 use after move)
            if self.cfg.sym is lsym: *LambdaSymbol {
                for c in lsym.captures {
                    alived.insert(c.outer_var as *raw VarSymbol as UInt);
                    alived.insert(c.local_var as *raw VarSymbol as UInt);
                }
            }
        } else {
            // 用 incoming 初始化
            let mut is_first = true;
            for incoming in bb.incomings {
                let lp = last_live_point(incoming);
                let mut a = self.alive_locals_at_point.at(&lp).get_or_panic();
                if is_first {
                    alived = move a;
                    is_first = false;
                } else {
                    alived.intersect_set(&a); // 求集合的 交集
                }
            }
        }

        // 遍历所有 step, 关注 write/move/dtor
        let mut step_idx: UInt = 0;
        for step in bb.steps {
            match step.value {
                w: *WriteValue => {
                    if extract_local(w.dst as *XValue) is Some(vsym) {
                        let i = vsym as *raw VarSymbol as UInt;
                        alived.insert(i);
                        dead.remove(i);
                    }
                }
                d: *DtorValue => {
                    // 被放置 pass 取消的"语句末析构"完全失效: 既不算存储期结束, 也不调用析构
                    if d.skipped {
                        // do nothing
                    }
                    else if extract_local(d.src as *XValue) is Some(vsym) {
                        let j = vsym as *raw VarSymbol as UInt;
                        // 这个点上变量是否还活着 (在同一个 bb 里刚写过也算活着)
                        let was_alive = alived.contains(j);
                        // 无论是有析构函数的真正析构, 还是无析构函数(is_trivial)的存储期结束标记,
                        // 该变量在此刻都不再存活
                        alived.remove(j);
                        if d.is_trivial {
                            // 类型没有析构函数: 只需要结束存储期, 不需要做 drop flag 分析
                            dead.insert(j);
                        } else {
                            // 只有"该点上变量已经不活着"时才需要判断这条析构是不是不可达的:
                            //   - 没有任何前驱 (入口 bb), 或者所有前驱都不活着 -> 这条析构是多余的
                            //   - 前驱里有的活有的不活 -> 需要 drop flag
                            // 如果该点上变量还活着 (包括在同一个 bb 里刚初始化), 直接析构即可。
                            // (以前没看 was_alive, 会把入口 bb 里的析构全部标成 no_need, 析构被跳过)
                            if !was_alive && vsym.drop_flag is None {
                                // 这个变量现在本来就不是 alived 状态, 有两种可能:
                                // 1. 变量已经析构
                                // 2. 变量来自多个分支，其中某些分支中已经析构
                                // 分析 incomings
                                let incoming_liveness = self.preceding_liveness_of(bb, j);
                                if incoming_liveness.len() == 0 {
                                    d.no_need = true;
                                } else if incoming_liveness.len() == 1 && incoming_liveness.contains(0_u) {
                                    d.no_need = true;
                                } else if incoming_liveness.len() == 2 {
                                    // 添加 drop flag
                                    if vsym.drop_flag is None {
                                        let df = VarSymbol::create(vsym.var_node.span(), SType::sty_bool());
                                        vsym.drop_flag = Some(move df);
                                    }
                                }
                            }
                            if dead.contains(j) {
                                d.no_need = true;
                            } else {
                                dead.insert(j);
                            }
                        }
                    }
                }
                m: *MovedValue => {
                    if extract_local(m.src as *XValue) is Some(vsym) {
                        let ri = vsym as *raw VarSymbol as UInt;
                        alived.remove(ri);
                        dead.insert(ri);
                    }
                }
                rv: *ReadValue => {
                    if extract_local(rv as *XValue) is Some(vsym) {
                        let ri = vsym as *raw VarSymbol as UInt;
                        let is_alive = alived.contains(ri);
                        if !is_alive {
                            let var_name = vsym.short_name();
                            DiagnosticEngine::get().emit_use_after_dead(move var_name, rv.expr.span());
                        }
                    }
                }
                _ => { }
            }

            // 把所有现存依然存活的变量，都在这个点上记录下来。 todo: 生命周期检查
            let current_point = LivePoint::new(bb.index, step_idx);
            self.alive_locals_at_point.insert(move current_point, alived);
            step_idx += 1;
        }

        // 在 terminator 这个点上的活着的变量也记录, 因为有些 BasicBlock 没有 steps 只有 terminator
        let current_point = LivePoint::new(bb.index, step_idx);
        self.alive_locals_at_point.insert(move current_point, move alived);
    }

    fn preceding_liveness_of(&self, bb: *BasicBlock, j: UInt) -> UIntSet {
        let mut preceding_liveness = UIntSet::new();
        for incoming in bb.incomings {
            let last_lp = last_live_point(incoming);
            if self.alive_locals_at_point.at(&last_lp) is Some(a) {
                preceding_liveness.insert(a.contains(j) as UInt);
            } else {
                preceding_liveness.insert(0_u);
            }
        }
        return preceding_liveness;
    }

    fn handle_move_in_loop(&self, from: *BasicBlock, to: *BasicBlock) {
        let mut moved_vars = (type HashMap<UInt, UIntSet>)::new();
        // 第一轮
        let mut i = from.index;
        while i <= to.index {
            let bb = self.cfg.basic_blocks.at(i).get_or_panic();
            self.revisit_loop_body(bb, &mut moved_vars);
            i += 1;
        }
        // 第二轮
        from.incomings.push(to);
        i = from.index;
        while i <= to.index {
            let bb = self.cfg.basic_blocks.at(i).get_or_panic();
            self.revisit_loop_body(bb, &mut moved_vars);
            i += 1;
        }
    }

    fn revisit_loop_body(&self, bb: *BasicBlock, moved_vars: &mut HashMap<UInt, UIntSet>) {

        let mut moved = UIntSet::new();
        for incoming in bb.incomings {
            let i = incoming as *raw BasicBlock as UInt;
            if moved_vars.at(&i) is Some(a) {
                moved.union_set(&a);
            }
        }
        for step in bb.steps {
            if step.value is w: *WriteValue {
                if w.dst is local: *LocalVar {
                    let i = local.sym_var as *raw VarSymbol as UInt;
                    moved.remove(i);
                }
            } else if step.value is d: *DtorValue {
            } else if step.value is m: *MovedValue {
                if m.src is rv: *ReadValue {
                    let ri = rv.sym_var as *raw VarSymbol as UInt;
                    moved.insert(ri);
                }
            } else if step.value is rv: *ReadValue {
                let ri = rv.sym_var as *raw VarSymbol as UInt;
                if !rv.sym_var.is_const() && !rv.sym_var.is_static() && moved.contains(ri) {
                    let var_name = rv.sym_var.short_name();
                    DiagnosticEngine::get().emit_use_after_dead(move var_name, rv.expr.span());
                }
            }
        }

        let bbi = bb as *raw BasicBlock as UInt;
        moved_vars.insert(bbi, move moved);
    }
}

fn last_live_point(bb: *BasicBlock) -> LivePoint {
    let len = bb.steps.len();
    return LivePoint::new(bb.index, len);
}

struct LivePoint {
    bb_idx: UShort,
    step_idx: UShort,
}

impl LivePoint {
    fn new(bb_idx: UInt, step_idx: UInt) -> Self {
        if bb_idx > 0xFFFF_FFFF { panic; }
        if step_idx > 0xFFFF_FFFF { panic; }

        return {
            .bb_idx = bb_idx as UShort,
            .step_idx = step_idx as UShort,
        }: LivePoint;
    }

    fn from_uint(value: UInt) -> Self {
        let bb_idx = value.bit_shr(32).bit_and(0xFFFF_FFFF);
        let step_idx = value.bit_and(0xFFFF_FFFF);
        return LivePoint::new(bb_idx as UInt, step_idx as UInt);
    }

    fn to_uint(&self) -> UInt {
        let bb_idx = self.bb_idx as UInt;
        let step_idx = self.step_idx as UInt;
        return bb_idx.bit_shl(32) + step_idx;
    }
}

impl PartialEq for LivePoint {
    fn eq(&self, other: &Self) -> Bool {
        return self.bb_idx == other.bb_idx && self.step_idx == other.step_idx;
    }

    fn ne(&self, other: &Self) -> Bool {
        return !(self.bb_idx == other.bb_idx && self.step_idx == other.step_idx);
    }
}

impl Eq for LivePoint {}

impl Hash for LivePoint {
    fn hash(&self, state: &mut Hasher) {
        self.bb_idx.hash(state);
        self.step_idx.hash(state);
    }
}

fn extract_local(rv: *XValue) -> Option<*VarSymbol> {
    match rv {
        local_var: *LocalVar => {
            if !local_var.sym_var.is_static() && !local_var.sym_var.is_const() {
                return Some(local_var.sym_var);
            } else {
                return None;
            }
        }
        read_val: *ReadValue => {
            if !read_val.sym_var.is_static() && !read_val.sym_var.is_const() {
                return Some(read_val.sym_var);
            } else {
                return None;
            }
        }
        cast_rv: *CastValue => {
            return extract_local(cast_rv.operand as *XValue);
        }
        ctx_rv: *ContextValue => {
            return extract_local(ctx_rv.inner as *XValue);
        }
        ty_asc_rv: *TypeAscriptionValue => {
            return extract_local(ty_asc_rv.inner as *XValue);
        }
        moved_rv: *MovedValue => {
            return extract_local(moved_rv.src as *XValue);
        }
        _ => return None;
    }
    return None;
}
