    fn set_parent_scope(&mut self, ss: *ScopeSymbol) {
    }

    fn get_stype(&self) -> *SType {
        return self.src.get_stype();
    }

    fn set_stype(&mut self, sty: *SType) {
        self.src.set_stype(move sty);
    }

    fn dump(&self) {
        self.src.dump();
    }
}

impl RValue for MovedValue {

