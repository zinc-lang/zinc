use ::self::frontend::semantic::hir::ir::*;
use ::self::frontend::source_code::*;
use ::self::frontend::diagnostic::*;

struct TypeMapping {
    ty_mapping: HashMap<UInt, *SType>,   // key 是 *TypeParamSymbol
    lt_mapping: HashMap<UInt, Lifetime>, // key 是 *LifetimeSymbol
}

impl TypeMapping {
    fn new() -> Self {
        return {
            .ty_mapping = (type HashMap<UInt, *SType>)::new(),
            .lt_mapping = (type HashMap<UInt, Lifetime>)::new(),
        }: TypeMapping;
    }

    fn unify(&mut self, formal: *SType, actual: *SType) -> Bool {
        if actual as *raw SType as UInt == formal as *raw SType as UInt {
            return true;
        }

        if actual.is_invalid() || formal.is_invalid() {
            return false;
        }

        let mut aty = actual.canonical();
        if aty.type_symbol is assoc: *AssociatedTypeSymbol {
            aty = assoc.target_sty;
        }
        let mut fty = formal.canonical();
        if fty.type_symbol is assoc: *AssociatedTypeSymbol {
            fty = assoc.target_sty;
        }

        if fty.type_symbol is ts: *TypeParamSymbol {
            let key = ts as *raw TypeParamSymbol as UInt;
            self.ty_mapping.insert(key, move aty);
            return true;
        }

        if fty.type_symbol is assoc: *AssociatedTypeSymbol {
            return self.unify(assoc.target_sty, actual);
        }

        if fty.type_symbol as *raw TypeSymbol as UInt == aty.type_symbol as *raw TypeSymbol as UInt {
            if aty.args.ty_args.len() == fty.args.ty_args.len() {
                let len = aty.args.ty_args.len();
                let mut i: UInt = 0;
                while i < len {
                    let a = aty.args.ty_arg(i);
                    let f = fty.args.ty_arg(i);
                    let r = self.unify(f, a);
                    if !r {
                        return false;
                    }
                    i += 1;
                }
            }

            // 记录生命周期形参 -> 实参 的替换关系
            let len1 = aty.args.lt_args.len();
            let len2 = fty.args.lt_args.len();
            let mut j: UInt = 0;
            while j < len1 && j < len2 {
                let a = aty.args.lt_arg(j);
                let f = fty.args.lt_arg(j);
                self.unify_lt(f, a);
                j += 1;
            }
            return true;
        }
        return false;
    }

    fn unify_all(&mut self, formal: &Vec<*TypeParamSymbol>, actual: &Vec<*SType>, span: SourceSpan) {
        let actual_count = actual.len();
        let formal_count = formal.len();
        if actual_count != formal_count {
            DiagnosticEngine::get().emit_generic_args_count_mismatch(f"fn call", formal_count, actual_count, span);
            return;
        }
        let mut i: UInt = 0;
        while i < actual_count {
            let arg_ty: *SType = *actual.index(i).deref();
            let param: *TypeParamSymbol = *formal.index(i).deref();
            let param_ty = param.to_sty();
            self.unify(param_ty, arg_ty);

            i += 1;
        }
    }

    fn unify_lt(&mut self, formal: Lifetime, actual: Lifetime) -> Bool {
        // 只有形参侧确实是一个生命周期形参(具名, 或者生命周期省略规则补全出来的匿名形参)时才记录
        if formal.resolved is Some(lt_sym) {
            let key = lt_sym as *raw LifetimeSymbol as UInt;
            self.lt_mapping.insert(key, move actual);
            return true;
        }
        return false;
    }

    fn subst(&self, sty: *SType) -> *SType {
        if sty.type_symbol is ts: *TypeParamSymbol {
            let key = ts as *raw TypeParamSymbol as UInt;
            if self.ty_mapping.at(&key) is Some(r) {
                return self.subst(r);
            } else {
                return sty;
            }
        }

        if sty.type_symbol is assoc: *AssociatedTypeSymbol {
            if assoc.is_self_ty() && assoc.target_sty.type_symbol is type *TraitSymbol {
                return sty; // 在 trait 上下文中的 Self 类型, 不要做替换
            }
            return self.subst(assoc.target_sty);
        }

        let mut new_args = GenericArgs::new();
        for t in sty.args.ty_args {
            new_args.ty_args.push(self.subst(t));
        }
        {
            let mut i: UInt = 0;
            let len = sty.args.lt_args.len();
            while i < len {
                let l: Lifetime = sty.args.lt_arg(i);
                let substituted = self.subst_lt(l);
                new_args.lt_args.push(move substituted);
                i += 1;
            }
        }
        return sty.type_symbol.to_sty(move new_args);
    }

    fn subst_lt(&self, lt: Lifetime) -> Lifetime {
        if lt.resolved is Some(lt_sym) {
            let key = lt_sym as *raw LifetimeSymbol as UInt;
            if self.lt_mapping.at(&key) is Some(replacement) {
                return replacement;
            }
        }
        return lt;
    }

}
