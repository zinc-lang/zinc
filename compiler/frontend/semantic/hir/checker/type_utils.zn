use ::self::frontend::semantic::hir::ir::*;
use ::self::frontend::source_code::*;
use ::self::frontend::diagnostic::*;
use ::self::frontend::syntax::token::*;

use super::type_mapping::*;
use std::collections::hashset::HashSet;

fn bind_generic_args(
    mappings: &mut TypeMapping,
    formal_ty_params: &Vec<*TypeParamSymbol>,
    formal_lt_params: &Vec<*LifetimeSymbol>,
    actual: &GenericArgs,
) {
    let mut ty_len = formal_ty_params.len();
    if actual.ty_args.len() < ty_len {
        ty_len = actual.ty_args.len();
    }
    let mut i: UInt = 0;
    while i < ty_len {
        let formal: *TypeParamSymbol = *formal_ty_params.index(i).deref();
        let actual_ty: *SType = actual.ty_arg(i);
        mappings.unify(formal.to_sty(), move actual_ty);
        i += 1;
    }

    let mut lt_len = formal_lt_params.len();
    if actual.lt_args.len() < lt_len {
        lt_len = actual.lt_args.len();
    }
    let mut j: UInt = 0;
    while j < lt_len {
        let formal_lt_ptr: *LifetimeSymbol = *formal_lt_params.index(j).deref();
        let formal_lt: Lifetime = formal_lt_ptr.to_lifetime();
        let actual_lt: Lifetime = actual.lt_arg(j);
        mappings.unify_lt(move formal_lt, move actual_lt);
        j += 1;
    }
}

fn type_contains_by_value(sty: *SType, target: UInt, on_stack: &mut HashSet<UInt>) -> Bool {
    let ts = sty.type_symbol;
    let ts_key = ts as *raw TypeSymbol as UInt;
    if ts_key == target {
        return true;
    }

    // 间接层: 不会造成无限大小
    if ts is type *PointerLikeSymbol {
        return false;
    }

    // 类型别名: 展开后继续 (递归别名已经被 check_typealias 拒绝, 这里再防一手死循环)
    if ts is alias: *TypeAliasSymbol {
        if on_stack.contains(&ts_key) {
            return false;
        }
        on_stack.insert(ts_key);
        let res = type_contains_by_value(sty.canonical(), target, on_stack);
        on_stack.remove(&ts_key);
        return res;
    }

    let mut is_composite = false;
    if ts is type *StructSymbol {
        is_composite = true;
    }
    if ts is type *EnumSymbol {
        is_composite = true;
    }
    if ts is type *UnionSymbol {
        is_composite = true;
    }
    if is_composite {
        if on_stack.contains(&ts_key) {
            return false;
        }
        on_stack.insert(ts_key);

        if ts is s: *StructSymbol {
            let mut mappings = TypeMapping::new();
            bind_generic_args(&mut mappings, &s.generics.ty_params, &s.generics.lt_params, &sty.args);
            for f in s.fields {
                if type_contains_by_value(mappings.subst(f.stype), target, on_stack) {
                    return true;
                }
            }
        }
        if ts is e: *EnumSymbol {
            let mut mappings = TypeMapping::new();
            bind_generic_args(&mut mappings, &e.generics.ty_params, &e.generics.lt_params, &sty.args);
            for v in e.variants {
                for fty in v.fields {
                    if type_contains_by_value(mappings.subst(fty), target, on_stack) {
                        return true;
                    }
                }
            }
        }
        if ts is u: *UnionSymbol {
            // union 不支持泛型参数, 不需要代入实参
            for f in u.fields {
                if type_contains_by_value(f.stype, target, on_stack) {
                    return true;
                }
            }
        }

        on_stack.remove(&ts_key);
        return false;
    }

    // 元组/数组: 元素内联
    let mut is_seq = false;
    if ts is type *TupleSymbol {
        is_seq = true;
    }
    if ts is type *ArraySymbol {
        is_seq = true;
    }
    if is_seq {
        for a in sty.args.ty_args {
            if type_contains_by_value(a, target, on_stack) {
                return true;
            }
        }
    }

    return false;
}

impl SType {

    // 去掉 type alias
    pub fn canonical(*self) -> *SType {
        if self.type_symbol is alias: *TypeAliasSymbol {
            if alias.generics.ty_params.is_empty() && alias.generics.lt_params.is_empty() {
                return alias.target_sty;
            } else {
                let mut mappings = TypeMapping::new();
                bind_generic_args(&mut mappings, &alias.generics.ty_params, &alias.generics.lt_params, &self.args);
                return mappings.subst(alias.target_sty);
            }
        }
        if self.type_symbol is assoc: *AssociatedTypeSymbol {
            if assoc.is_self_ty() && assoc.target_sty.type_symbol is type *TraitSymbol {
                return self; // 在 trait 上下文中的 Self 类型, 不要做替换
            }
            let mut mappings = TypeMapping::new();
            bind_generic_args(&mut mappings, &assoc.generics.ty_params, &assoc.generics.lt_params, &self.args);
            return mappings.subst(assoc.target_sty);
        }

        let mut args = GenericArgs::new();
        for a in self.args.ty_args {
            args.ty_args.push(a.canonical());
        }
        {
            // 生命周期实参不做归一化, 但要原样保留, 否则生命周期信息会在 canonical 之后丢失
            let mut i: UInt = 0;
            let len = self.args.lt_args.len();
            while i < len {
                let l: Lifetime = self.args.lt_arg(i);
                args.lt_args.push(move l);
                i += 1;
            }
        }

        return self.type_symbol.to_sty(move args);
    }

    pub fn is_unsigned_int(*self) -> Bool {
        return self.type_symbol is isym: *IntegerSymbol &&
            isym.kind is IntegerKind::Usize;
    }

    pub fn is_builtin_comparable(*self) -> Bool {
        match self.type_symbol {
            type *BoolSymbol => return true;
            type *IntegerSymbol => return true;
            type *CharSymbol => return true;
            type *FloatSymbol => return true;
            type *RawPointerImmutSymbol => return true;
            type *RawPointerMutSymbol => return true;
            type *FuncSymbol => return true;

            type *TupleSymbol => {
                for a in self.args.ty_args {
                    if !a.is_builtin_comparable() {
                        return false;
                    }
                }
                return true;
            }

            type *ArraySymbol => {
                return self.args.ty_arg(0).is_builtin_comparable();
            }

            esym: *EnumSymbol => {
                for c in esym.variants {
                    if !c.fields.is_empty() {
                        return false;
                    }
                }
                return true;
            }

            _ => return false;
        }
    }

    pub fn is_thin_pointer(&self) -> Bool {
        if self.type_symbol is type *PointerLikeSymbol {
            let arg0: *SType = self.args.ty_arg(0);
            if arg0.type_symbol is type *TraitSymbol ||
                arg0.type_symbol is type *FnUpperTypeSymbol ||
                arg0.type_symbol is type *FnUpperMutTypeSymbol {
                return false;
            } else {
                return true;
            }
        }
        return false;
    }

    pub fn is_fat_pointer(&self) -> Bool {
        if self.type_symbol is type *PointerLikeSymbol {
            let arg0: *SType = self.args.ty_arg(0);
            if arg0.type_symbol is type *TraitSymbol ||
                arg0.type_symbol is type *FnUpperTypeSymbol ||
                arg0.type_symbol is type *FnUpperMutTypeSymbol {
                return true;
            } else {
                return false;
            }
        }
        return false;
    }

    fn strip_pointer(*self) -> *SType {
        if self.type_symbol is type *PointerLikeSymbol {

            let arg = self.args.ty_arg(0);
            return arg.strip_pointer();
        }
        return self as *SType;
    }
}

fn is_borrow_to_array(sty: *SType) -> Bool {
    if sty.type_symbol is b: *BorrowImmutSymbol {
        let arg0: *SType = sty.args.ty_arg(0);
        if arg0.type_symbol is type *ArraySymbol {
            return true;
        }
    }
    return false;
}

fn is_mutborrow_to_array(sty: *SType) -> Bool {
    if sty.type_symbol is b: *BorrowMutSymbol {
        let arg0: *SType = sty.args.ty_arg(0);
        if arg0.type_symbol is type *ArraySymbol {
            return true;
        }
    }
    return false;
}

fn is_slice(sty: *SType) -> Bool {
    return sty.type_symbol.export_key().as_str().deref().eq(&"::std::primitives::slice::Slice");
}

fn is_slicemut(sty: *SType) -> Bool {
    return sty.type_symbol.export_key().as_str().deref().eq(&"::std::primitives::slice::SliceMut");
}

fn is_safe_pointer(sty: *SType) -> Bool {
    if sty.type_symbol is type *ArcPointerSymbol {
        return true;
    }
    if sty.type_symbol is type *WeakPointerSymbol {
        return true;
    }
    if sty.type_symbol is type *BorrowImmutSymbol {
        return true;
    }
    if sty.type_symbol is type *BorrowMutSymbol {
        return true;
    }
    return false;
}

fn is_unsafe_pointer(sty: *SType) -> Bool {
    if sty.type_symbol is type *RawPointerImmutSymbol {
        return true;
    }
    if sty.type_symbol is type *RawPointerMutSymbol {
        return true;
    }
    return false;
}

fn stype_eq_regardless_lifetime(ty1: *SType, ty2: *SType) -> Bool {
    let t1 = ty1.canonical();
    let t2 = ty2.canonical();

    let i1 = t1 as *raw SType as UInt;
    let i2 = t2 as *raw SType as UInt;
    if i1 == i2 {
        return true;
    }

    let s1 = t1.type_symbol as *raw TypeSymbol as UInt;
    let s2 = t2.type_symbol as *raw TypeSymbol as UInt;
    if s1 != s2 {
        return false;
    }

    let len = t1.args.ty_args.len();
    let mut i: UInt = 0;
    while i < len {
        let arg1 = t1.args.ty_arg(i);
        let arg2 = t2.args.ty_arg(i);
        if !stype_eq_regardless_lifetime(move arg1, move arg2) {
            return false;
        }
        i += 1;
    }

    return true;
}

fn expect_type_eq(ty1: *SType, ty2: *SType, span: SourceSpan) {
    if !stype_eq_regardless_lifetime(ty1, ty2) {
        DiagnosticEngine::get().emit_type_mismatch(
            ty1.to_string(), ty2.to_string(), move span
        );
    }
}

fn contains_invalid(sty: *SType) -> Bool {
    if sty.type_symbol is type *InvalidSymbol {
        return true;
    }
    for a in sty.args.ty_args {
        if contains_invalid(move a) {
            return true;
        }
    }
    return false;
}

fn ensure_type_valid(sty: *SType, span: SourceSpan) -> Bool {
    if contains_invalid(sty) {
        DiagnosticEngine::get().emit_type_infer_failed(span);
        return false;
    } else {
        // 检查泛型实参个数是不是等于泛型形参个数
        // (Tuple / Array / fn 类型的 args 不是泛型实参: 分别是元素列表、元素+长度、签名)
        if !(sty.type_symbol is type *TupleSymbol) &&
            !(sty.type_symbol is type *ArraySymbol) &&
            !sty.is_fn_type() {

            let formal_params = sty.type_symbol.to_sty().args.ty_args.len();
            let actual_args = sty.args.ty_args.len();
            if formal_params != actual_args {
                DiagnosticEngine::get().emit_generic_args_count_mismatch(sty.type_symbol.short_name(), formal_params, actual_args, span);
                return false;
            }
        }
        return true;
    }
}


fn strip_pointer_except_weak(sty: *SType) -> *SType {
    if sty.type_symbol is type *PointerLikeSymbol &&
        !(sty.type_symbol is type *WeakPointerSymbol) {
        
        let arg = sty.args.ty_arg(0);
        return strip_pointer_except_weak(move arg);
    }
    return sty;
}

fn strip_lifetime(sty: *SType) -> *SType {
    let mut args = GenericArgs::new();

    for a in sty.args.ty_args {
        args.ty_args.push(strip_lifetime(a));
    }

    return sty.type_symbol.to_sty(move args);
}

fn is_raw_pointer(sty: *SType) -> Bool {
    return sty.type_symbol is type *RawPointerImmutSymbol ||
        sty.type_symbol is type *RawPointerMutSymbol;
}

fn find_field(sty: *SType, name: String) -> Option<*VarSymbol> {

    let ty = strip_pointer_except_weak(sty);
    if ty.type_symbol is alias: *TypeAliasSymbol {
        return find_field(alias.target_sty, move name);
    }
    else if ty.type_symbol is assoc: *AssociatedTypeSymbol {
        return find_field(assoc.target_sty, move name);
    }
    else if ty.type_symbol is struct_sym: *StructSymbol {
        for f in struct_sym.fields {
            if f.short_name().eq(&name) {
                return Some(move f);
            }
        }
    }
    else if ty.type_symbol is union_sym: *UnionSymbol {
        for f in union_sym.fields {
            if f.short_name().eq(&name) {
                return Some(move f);
            }
        }
    }

    return None;
}

fn find_method(receiver_ty: *SType, method_token: Token, arg_count: UInt, cur_fsym: Option<*FuncSymbol>, cur_lambda: Option<*LambdaSymbol>) -> Option<*FuncSymbol> {

    if !ensure_type_valid(receiver_ty, method_token.source_span) {
        return None;
    }

    if receiver_ty.type_symbol is assoc: *AssociatedTypeSymbol {
        return find_method(assoc.target_sty, move method_token, arg_count, move cur_fsym, move cur_lambda);
    }

    let method = method_token.raw_str();
    
    if receiver_ty.type_symbol is trait_sym: *TraitSymbol {
        let results = trait_sym.find_method(method_token, arg_count);

        if results.len() > 1 {
            DiagnosticEngine::get().emit_multiple_candidate_methods(method_token.source_span);
            return None;
        }
        else if results.len() == 1 {
            let r = *results.index(0).deref();
            return Some(move r);
        }
        else {
            DiagnosticEngine::get().emit_overload_not_found(method_token.source_span, arg_count);
            return None;
        }
    }

    // 这里要考虑, 当同一个类型对不同 trait 做 impl 时, 是允许存在同签名的两个成员函数的
    // 先到 inherent impl 里面找, 这边的优先级高
    let mut results = (type Vec<*FuncSymbol>)::new();
    for isym in receiver_ty.type_symbol.related_impls() {
        if isym.trait_sty is Some(_) {
            continue;
        }
        if isym.find_method(method, arg_count) is Some(m) {
            results.push(move m);
        }
    }
    if results.len() > 1 {
        DiagnosticEngine::get().emit_multiple_candidate_methods(method_token.source_span);
        return None;
    }
    if results.len() == 1 {
        let r = *results.index(0).deref();
        return Some(move r);
    }

    // 再到 impl with trait 里面找
    for isym in receiver_ty.type_symbol.related_impls() {
        if isym.trait_sty is None {
            continue;
        }
        if isym.find_method(method, arg_count) is Some(m) {
            results.push(move m);
        }
    }

    if results.len() > 1 {
        DiagnosticEngine::get().emit_multiple_candidate_methods(method_token.source_span);
        return None;
    }
    if results.len() == 1 {
        let r = *results.index(0).deref();
        return Some(move r);
    }

    // 还要考虑泛型参数及其 constraints 的情况
    if receiver_ty.type_symbol is tps: *TypeParamSymbol {
        let key = tps as *raw TypeParamSymbol as UInt;
        let mut unique = (type HashSet<UInt>)::new();

        let mut constraints = GenericConstraints::new();
        if cur_fsym is Some(out_fsym) {
            constraints.merge(&out_fsym.generics.constraints);
            if out_fsym.parent_sym is Some(isym: *ImplSymbol) {
                constraints.merge(&isym.generics.constraints);
            }
        }
        // 闭包自己声明的泛型参数及其 where 约束
        if cur_lambda is Some(lsym) {
            constraints.merge(&lsym.generics.constraints);
        }

        let upper_bounds = constraints.upper_bounds(&key);
        for ub in upper_bounds {
            if ub.type_symbol is trait_sym: *TraitSymbol {
                let r = trait_sym.find_method(method_token, arg_count);
                for f in r {
                    let fi = f as *raw FuncSymbol as UInt;
                    if !unique.contains(&fi) {
                        results.push(move f);
                        unique.insert(fi);
                    }
                }
            }
        }
    }

    if results.len() > 1 {
        DiagnosticEngine::get().emit_multiple_candidate_methods(method_token.source_span);
        return None;
    }
    if results.len() == 1 {
        let r = *results.index(0).deref();
        return Some(move r);
    }

    DiagnosticEngine::get().emit_overload_not_found(method_token.source_span, arg_count);
    return None;
}

struct DerefMethodInfo {
    receiver_sty: *SType,
    target_sty: *SType,
    method_sym: *FuncSymbol,
}

// 由 trait 的约束 (T: TR<...>) 找到方法时, 把 trait 签名里的 Self 和 trait 自己的
// 泛型参数绑定到 receiver / 约束上:
//   - Self -> receiver_ty  (即 T)
//   - trait 的形参 -> 约束里写的实参 (trait TR<A> + T: TR<Int> => A = Int)
//
// 只有"泛型参数 + 该 trait 的约束"这一种接收者才做绑定:
//   - 具体类型的方法会先在 related_impls 里找到 impl 里的方法, 走不到这里;
//   - trait 对象接收者 (*TR) 不绑定: 把 Self 绑成 TR 会得到 unsized 的 trait 类型,
//     所以保持原来的"抽象 Self"行为。
// 只能在"调用点"用 (receiver 已知); 检查 trait 自己的方法体时不要调。
fn bind_trait_method_generics(
    mappings: &mut TypeMapping,
    trsym: *TraitSymbol,
    receiver_ty: *SType,
    cur_fsym: Option<*FuncSymbol>,
    cur_lambda: Option<*LambdaSymbol>,
) {
    if receiver_ty.type_symbol is tps: *TypeParamSymbol {
        mappings.unify(trsym.self_ty.to_sty(), receiver_ty);

        let key = tps as *raw TypeParamSymbol as UInt;

        let mut constraints = GenericConstraints::new();
        if cur_fsym is Some(out_fsym) {
            constraints.merge(&out_fsym.generics.constraints);
            if out_fsym.parent_sym is Some(isym: *ImplSymbol) {
                constraints.merge(&isym.generics.constraints);
            }
        }
        if cur_lambda is Some(lsym) {
            constraints.merge(&lsym.generics.constraints);
        }

        for ub in constraints.upper_bounds(&key) {
            if ub.type_symbol is bound_trait: *TraitSymbol
                && bound_trait as *raw TraitSymbol as UInt == trsym as *raw TraitSymbol as UInt {
                // 注: 泛型 trait (trait TR<A>) 目前前端还没实现
                // (会报 "未实现特性: trait declaration with generics"),
                // 所以下面这段现在跑不到; 等泛型 trait 支持之后它就会生效。
                let formal_count = trsym.generics.ty_params.len();
                let actual_count = ub.args.ty_args.len();
                let mut i: UInt = 0;
                while i < formal_count && i < actual_count {
                    mappings.unify(trsym.generics.ty_param(i).to_sty(), ub.args.ty_arg(i));
                    i += 1;
                }
            }
        }
    }
}

// 限定路径 Type::method(recv, ...) 的解析与检查。
//
// callee 是 trait 里的方法 (parent 是 trait) 而接收者是**具体类型**时, 实际要调用的是
// 该类型对这个 trait 的 impl 里的方法; 如果这个类型根本没有实现该 trait, 就在这里报
// 编译错误 (以前会一路走到 codegen, 变成空函数指针/断言失败)。
// impl 里没覆盖但 trait 里给了默认实现时, 用默认实现。
//
// 接收者是泛型参数 (T: TR) 或 trait 对象 (*TR) 时走运行期 vtable 派发, 不做编译期解析,
// 原样返回 callee。
// 返回 None 表示已经报错 (调用方应该返回 invalid)。
fn resolve_trait_method_call(
    callee_fsym: *FuncSymbol,
    receiver_ty: *SType,
    arg_count: UInt,
    span: SourceSpan,
) -> Option<*FuncSymbol> {
    if callee_fsym.parent_sym is Some(trait_sym: *TraitSymbol) {
        // 泛型参数 / trait 对象: 运行期按 vtable 派发
        if receiver_ty.type_symbol is type *TypeParamSymbol ||
            receiver_ty.type_symbol is type *TraitSymbol {
            return Some(callee_fsym);
        }

        let method_name = callee_fsym.short_name();
        for isym in receiver_ty.type_symbol.related_impls() {
            if isym.trait_sty is Some(itrait_sty) {
                if itrait_sty.type_symbol as *raw TypeSymbol as UInt == trait_sym as *raw TraitSymbol as UInt {
                    for m in isym.methods {
                        if m.short_name().eq(&method_name) && m.accept_params(arg_count) {
                            return Some(m);
                        }
                    }
                    if callee_fsym.body is Some(_) {
                        // impl 里没有覆盖, 用 trait 里的默认实现
                        return Some(callee_fsym);
                    }
                    DiagnosticEngine::get().emit_missing_method(method_name, isym.impl_node.kw_impl.source_span);
                    return None;
                }
            }
        }

        let type_name = receiver_ty.to_string();
        let trait_name = trait_sym.short_name();
        DiagnosticEngine::get().emit_type_not_impl_trait(type_name, trait_name, span);
        return None;
    }

    return Some(callee_fsym);
}

fn implemented_deref_trait(sty: *SType) -> Option<DerefMethodInfo> {
    for i in sty.type_symbol.related_impls() {
        if i.trait_sty is Some(trait_sty) {
            let key = trait_sty.type_symbol.export_key();
            if key.as_str().deref().eq(&"::std::ops::deref::Deref") {
                // 获取 impl 里面的 Target 关联类型
                let target_str = String::from_str("Target");
                let target_assoc_sym = i.associated_types.at(&target_str).get_or_panic();

                let mut mappings = TypeMapping::new();
                mappings.unify(i.target_sty.type_symbol.to_sty(), i.target_sty);
                mappings.unify(i.target_sty, sty);
                let target_sty = mappings.subst(target_assoc_sym.target_sty);

                for m in i.methods {
                    if m.short_name().as_str().deref().eq(&"deref") {
                        let mut ga = GenericArgs::new();
                        ga.ty_args.push(move sty);
                        let info = {
                            .receiver_sty = BorrowImmutSymbol::new().to_sty(move ga),
                            .target_sty = move target_sty,
                            .method_sym = m,
                        }: DerefMethodInfo;
                        return Some(move info);
                    }
                }
            }
        }
    }
    return None;
}

fn implemented_derefmut_trait(sty: *SType) -> Option<DerefMethodInfo> {
    for i in sty.type_symbol.related_impls() {
        if i.trait_sty is Some(trait_sty) {
            let key = trait_sty.type_symbol.export_key();
            if key.as_str().deref().eq(&"::std::ops::deref::DerefMut") {
                // 获取 impl 里面的 TargetMut 关联类型
                let target_mut_str = String::from_str("TargetMut");
                let target_assoc_sym = i.associated_types.at(&target_mut_str).get_or_panic();

                let mut mappings = TypeMapping::new();
                mappings.unify(i.target_sty.type_symbol.to_sty(), i.target_sty);
                mappings.unify(i.target_sty, sty);
                let target_sty = mappings.subst(target_assoc_sym.target_sty);

                for m in i.methods {
                    if m.short_name().as_str().deref().eq(&"deref_mut") {
                        let mut ga = GenericArgs::new();
                        ga.ty_args.push(move sty);
                        let info = {
                            .receiver_sty = BorrowMutSymbol::new().to_sty(move ga),
                            .target_sty = move target_sty,
                            .method_sym = m,
                        }: DerefMethodInfo;
                        return Some(move info);
                    }
                }
            }
        }
    }
    return None;
}

fn implemented_step_trait(sty: *SType) -> Bool {
    for i in sty.type_symbol.related_impls() {
        if i.trait_sty is Some(trait_sty) {
            let key = trait_sty.type_symbol.export_key();
            if key.as_str().deref().eq(&"::std::primitives::range::Step") {
                return true;
            }
        }
    }
    return false;
}

fn auto_ref_and_deref(formal_ty: *SType, actual_ty: *SType, rv: *RValue) -> *RValue {
    let span = rv.expr_node().span();
    if !ensure_type_valid(rv.get_stype(), span) {
        return rv;
    }

    if stype_eq_regardless_lifetime(formal_ty, actual_ty) {
        return rv;
    }

    if actual_ty.type_symbol is type *TypeParamSymbol &&
        formal_ty.type_symbol is type *TraitSymbol {
        return rv;
    }

    if formal_ty.type_symbol is ftr: *TraitSymbol &&
        actual_ty.type_symbol is atr: *TraitSymbol {
        // 如果 atr 继承自 ftr, 也是可以的
        // todo 这里还应该考虑 trait 的泛型参数
        if atr.is_inherited_from(ftr) {
            return rv;
        }
    }

    if actual_ty.type_symbol is assoc: *AssociatedTypeSymbol {
        return auto_ref_and_deref(move formal_ty, assoc.target_sty, move rv);
    }

    if formal_ty.type_symbol is type *ArcPointerSymbol {
        if actual_ty.type_symbol is type *ArcPointerSymbol {
            let inner = auto_ref_and_deref(formal_ty.args.ty_arg(0), actual_ty.args.ty_arg(0), rv);
            return inner;
        } else {
            DiagnosticEngine::get().emit_receiver_type_mismatch(formal_ty.to_string(), actual_ty.to_string(), span);
            return rv;
        }
    }

    if formal_ty.type_symbol is type *BorrowMutSymbol {
        if actual_ty.type_symbol is type *ArcPointerSymbol {
            let inner = auto_ref_and_deref(formal_ty.args.ty_arg(0), actual_ty.args.ty_arg(0), rv);
            // reborrow
            let deref = DerefRValue::create(span, move inner);
            let borrow = AddressofValue::create(span, AddressofKind::RefMut, move deref as *RValue);
            return borrow;
        }
        else if actual_ty.type_symbol is type *BorrowMutSymbol {
            let inner = auto_ref_and_deref(formal_ty.args.ty_arg(0), actual_ty.args.ty_arg(0), rv);
            return inner;
        }
        else if !(actual_ty.type_symbol is type *PointerLikeSymbol) {
            let borrow = AddressofValue::create(span, AddressofKind::RefMut, rv);
            return borrow;
        }
        else {
            DiagnosticEngine::get().emit_receiver_type_mismatch(formal_ty.to_string(), actual_ty.to_string(), span);
            return rv;
        }
    }

    if formal_ty.type_symbol is type *BorrowImmutSymbol {
        if actual_ty.type_symbol is type *ArcPointerSymbol {
            let inner = auto_ref_and_deref(formal_ty.args.ty_arg(0), actual_ty.args.ty_arg(0), rv);
            // reborrow
            let deref = DerefRValue::create(span, move inner);
            let borrow = AddressofValue::create(span, AddressofKind::Ref, move deref as *RValue);
            return borrow;
        }
        else if actual_ty.type_symbol is type *BorrowMutSymbol {
            let inner = auto_ref_and_deref(formal_ty.args.ty_arg(0), actual_ty.args.ty_arg(0), rv);
            // reborrow
            let deref = DerefRValue::create(span, move inner);
            let borrow = AddressofValue::create(span, AddressofKind::Ref, move deref as *RValue);
            return borrow;
        }
        else if actual_ty.type_symbol is type *BorrowImmutSymbol {
            let inner = auto_ref_and_deref(formal_ty.args.ty_arg(0), actual_ty.args.ty_arg(0), rv);
            return inner;
        }
        else if !(actual_ty.type_symbol is type *PointerLikeSymbol) {
            let borrow = AddressofValue::create(span, AddressofKind::Ref, rv);
            return borrow;
        }
        else {
            DiagnosticEngine::get().emit_receiver_type_mismatch(formal_ty.to_string(), actual_ty.to_string(), span);
            return rv;
        }
    }

    if formal_ty.type_symbol is assoc: *AssociatedTypeSymbol &&  assoc.is_self_ty() {
        if actual_ty.type_symbol is type *ArcPointerSymbol ||
            actual_ty.type_symbol is type *BorrowMutSymbol ||
            actual_ty.type_symbol is type *BorrowImmutSymbol {

            let inner = auto_ref_and_deref(formal_ty, actual_ty.args.ty_arg(0), rv);
            let deref = DerefRValue::create(span, move inner);
            return deref;
        }
        else if actual_ty.type_symbol is type *WeakPointerSymbol ||
            actual_ty.type_symbol is type *RawPointerImmutSymbol ||
            actual_ty.type_symbol is type *RawPointerMutSymbol {
            DiagnosticEngine::get().emit_receiver_type_mismatch(formal_ty.to_string(), actual_ty.to_string(), span);
            return rv;
        }
        else {
            return rv;
        }
    }

    // todo 上面仅考虑了内置指针类型的 deref, 需要额外考虑自定义类型的 Deref trait 方法调用的场景

    DiagnosticEngine::get().emit_receiver_type_mismatch(formal_ty.to_string(), actual_ty.to_string(), span);
    return rv;
}

struct MethodIterInfo {
    iterable_arg_sty: *SType,
    iterable_param_sty: *SType,
    iter_sty: *SType,
    iter_method: *FuncSymbol,
}

// 还需要考虑 TypeParamSymbol 和 Constraints 的场景
fn extract_iter_in_iterable(sty: *SType) -> Option<MethodIterInfo> {
    let stripped_sty = strip_pointer_except_weak(sty);

    for isym in stripped_sty.type_symbol.related_impls() {
        if isym.trait_sty is Some(trait_sty) {
            let key = trait_sty.type_symbol.export_key();
            if key.as_str().deref().eq(&"::std::iter::Iterable") {
                let iter_str = String::from_str("Iter");
                let iter_assoc_sym = isym.associated_types.at(&iter_str).get_or_panic();

                let mut mappings = TypeMapping::new();
                mappings.unify(isym.target_sty, stripped_sty);
                mappings.unify(isym.target_sty.type_symbol.to_sty(), isym.target_sty);

                let iter_sty = mappings.subst(iter_assoc_sym.target_sty);

                for m in isym.methods {
                    if m.short_name().as_str().deref().eq(&"iter") {
                        let param = m.params.at(0).get_or_panic();
                        let info = {
                            .iterable_arg_sty = move stripped_sty,
                            .iterable_param_sty = mappings.subst(param.stype),
                            .iter_sty = move iter_sty,
                            .iter_method = move m,
                        }: MethodIterInfo;
                        return Some(move info);
                    }
                }
            }
        }
    }
    return None;
}

struct MethodNextInfo {
    iterator_arg_sty: *SType,
    iterator_param_sty: *SType,
    item_sty: *SType,
    next_method: *FuncSymbol,
}

// 还需要考虑 TypeParamSymbol 和 Constraints 的场景
fn extract_item_in_iterator(sty: *SType) -> Option<MethodNextInfo> {
    let stripped_sty = strip_pointer_except_weak(sty);

    for isym in stripped_sty.type_symbol.related_impls() {
        if isym.trait_sty is Some(trait_sty) {
            let key = trait_sty.type_symbol.export_key();
            if key.as_str().deref().eq(&"::std::iter::Iterator") {
                let item_str = String::from_str("Item");
                let item_assoc_sym = isym.associated_types.at(&item_str).get_or_panic();

                let mut mappings = TypeMapping::new();
                mappings.unify(isym.target_sty, stripped_sty);
                mappings.unify(isym.target_sty.type_symbol.to_sty(), isym.target_sty);

                let item_sty = mappings.subst(item_assoc_sym.target_sty);

                for m in isym.methods {
                    if m.short_name().as_str().deref().eq(&"next") {
                        let param = m.params.at(0).get_or_panic();
                        let info = {
                            .iterator_arg_sty = move stripped_sty,
                            .iterator_param_sty = mappings.subst(param.stype),
                            .item_sty = move item_sty,
                            .next_method = move m,
                        }: MethodNextInfo;
                        return Some(move info);
                    }
                }
            }
        }
    }
    return None;
}

fn contains_trait_symbol(sty: *SType) -> Bool {
    let ts = sty.type_symbol;
    if ts is type *TraitSymbol ||
        ts is type *FnUpperTypeSymbol ||
        ts is type *FnUpperMutTypeSymbol {
        return true;
    }
    for a in sty.args.ty_args {
        if contains_trait_symbol(a) {
            return true;
        }
    }
    return false;
}

fn contains_type_param(sty: *SType) -> Bool {
    let ts = sty.type_symbol;
    if ts is type *TypeParamSymbol {
        return true;
    }
    for a in sty.args.ty_args {
        if contains_type_param(a) {
            return true;
        }
    }
    return false;
}

fn contains_associated_type(sty: *SType) -> Bool {
    let ts = sty.type_symbol;
    if ts is type *AssociatedTypeSymbol {
        return true;
    }
    for a in sty.args.ty_args {
        if contains_associated_type(a) {
            return true;
        }
    }
    return false;
}

fn unnamed_lifetime_count(sty: *SType) -> UInt {

    let mut formal_count = sty.type_symbol.to_sty().args.lt_args.len();
    if sty.type_symbol is type *BorrowImmutSymbol ||
        sty.type_symbol is type *BorrowMutSymbol {
        formal_count = 1;
    }

    let mut named_arg: UInt = 0;
    for lt in sty.args.lt_args {
        if lt.is_named() {
            named_arg += 1;
        }
    }
    if formal_count < named_arg {
        panic "BUG: actual lifetime args are more than formal lifetime param in semantic type";
    }

    return formal_count - named_arg;
}

// FIXME: 还需要考虑泛型参数 及其 泛型约束 之间的关系
// Fn / FnMut (FnUpper / FnUpperMut) 有 trait 语义: 闭包类型相当于给它们做 impl。
// 和 trait 不同的是, 闭包是唯一的 "实现者", 并且按捕获方式区分 Fn 和 FnMut:
//   - 没有捕获 / 只有 Ref, Value 捕获的闭包 -> Fn   (可以只拿共享借用调用)
//   - 有 RefMut 捕获的闭包                 -> FnMut (调用时需要一个可变借用)
fn is_fn_upper(sty: *SType) -> Bool {
    let c = sty.canonical();
    if c.type_symbol is type *FnUpperTypeSymbol {
        return true;
    }
    if c.type_symbol is type *FnUpperMutTypeSymbol {
        return true;
    }
    return false;
}

fn is_fn_upper_mut(sty: *SType) -> Bool {
    return sty.canonical().type_symbol is type *FnUpperMutTypeSymbol;
}

// 闭包能不能以 Fn (共享借用) 的形式被调用: 有 RefMut 捕获的闭包需要 &mut, 只能转成 FnMut
fn lambda_can_impl_fn(lsym: *LambdaSymbol) -> Bool {
    for c in lsym.captures {
        if c.mode is LambdaCaptureKind::RefMut {
            return false;
        }
    }
    return true;
}

// 指针的"所有权种类": 借用 / Arc / Weak / 裸指针。
// Fn/FnMut 的胖指针第一个字是环境指针, 只有同种类的指针之间才能互转 ——
// 借用变成拥有所有权的 Arc 之后, Arc 归零会把栈上的环境指针当引用计数块, 直接崩。
enum PointerKind {
    BorrowImmut,
    BorrowMut,
    Arc,
    Weak,
    RawImmut,
    RawMut,
    Other,
}

fn pointer_kind_of(sty: *SType) -> PointerKind {
    let c = sty.canonical();
    if c.type_symbol is type *BorrowImmutSymbol { return PointerKind::BorrowImmut; }
    if c.type_symbol is type *BorrowMutSymbol { return PointerKind::BorrowMut; }
    if c.type_symbol is type *ArcPointerSymbol { return PointerKind::Arc; }
    if c.type_symbol is type *WeakPointerSymbol { return PointerKind::Weak; }
    if c.type_symbol is type *RawPointerImmutSymbol { return PointerKind::RawImmut; }
    if c.type_symbol is type *RawPointerMutSymbol { return PointerKind::RawMut; }
    return PointerKind::Other;
}

fn pointer_kinds_compatible(src: PointerKind, dst: PointerKind) -> Bool {
    if src is PointerKind::BorrowImmut {
        // 共享借用可以借出更弱的权限 (共享/裸), 但不能凭空得到可变或所有权
        return dst is PointerKind::BorrowImmut ||
            dst is PointerKind::RawImmut || dst is PointerKind::RawMut;
    }
    if src is PointerKind::BorrowMut {
        return dst is PointerKind::BorrowImmut || dst is PointerKind::BorrowMut ||
            dst is PointerKind::RawImmut || dst is PointerKind::RawMut;
    }
    if src is PointerKind::Arc {
        return dst is PointerKind::Arc || dst is PointerKind::Weak;
    }
    if src is PointerKind::Weak {
        return dst is PointerKind::Weak;
    }
    if src is PointerKind::RawImmut {
        return dst is PointerKind::RawImmut || dst is PointerKind::RawMut;
    }
    if src is PointerKind::RawMut {
        return dst is PointerKind::RawMut;
    }
    return false;
}

// 形参是不是"指向 Fn/FnMut 的借用" (&Fn / &mut FnMut)
fn is_borrow_of_fn_upper(sty: *SType) -> Bool {
    if !sty.is_fat_pointer() {
        return false;
    }
    if !is_fn_upper(sty.args.ty_arg(0)) {
        return false;
    }
    if sty.type_symbol is type *BorrowImmutSymbol {
        return true;
    }
    if sty.type_symbol is type *BorrowMutSymbol {
        return true;
    }
    return false;
}

// 类型里是否含"会丢失的生命周期信息" (会悬垂的借用, 或者带了非 'static 生命周期实参的类型)。
//
// 注意: 显式写成 'static 的生命周期不算 —— S<'static> / &'static T 都不会悬垂,
// 装箱成 *TR / *Fn 之后也不可能活得比被借用的对象更长, 所以照常允许。
//
// Fn/FnMut 和 trait 对象这两种"胖指针"不携带被指向类型自己的生命周期实参:
// Arc<S<'a>> -> Arc<TR> 之后, 'a 就丢了, 于是这个 Arc 可能活得比 S 里借用的
// 对象更长。所以拥有所有权的指针 (Arc / Weak) 向这类胖指针转换时要先查一下。
//
// 结果按类型指针缓存: SType 是 interning 过的 (TypeSymbol::to_sty 对同一组泛型
// 实参返回同一个指针), 所以指针可以当 key。缓存是必须的 —— 编译器源码里有 1400+
// 处 `x as *Trait` 转型, 每一处都会走一次这里的字段递归 (而且 infer 没有缓存,
// 同一个转型会被反复推导), 不缓存的话整个前端检查会慢 5 倍以上。
unsafe static mut MentionsLifetimeCache: Option<HashMap<UInt, Bool>> = None;

fn mentions_lifetime(sty: *SType) -> Bool {
    let key = sty as *raw SType as UInt;
    unsafe {
        match MentionsLifetimeCache {
            Some(ref mut m) => {
                if m.at(&key) is Some(cached) {
                    return cached;
                }
            }
            None => {
                MentionsLifetimeCache = Some((type HashMap<UInt, Bool>)::new());
            }
        }
    }
    let res = mentions_lifetime_at(sty, 0_u);
    unsafe {
        if MentionsLifetimeCache is Some(ref mut m) {
            m.insert(key, res);
        }
    }
    return res;
}

// 单个生命周期是不是 'static。省略/没解析出来的生命周期按"非 static"处理 (保守)。
fn lifetime_is_static(lt: Lifetime) -> Bool {
    if lt.resolved is Some(lt_sym) {
        return lt_sym.is_static();
    }
    return false;
}

// 这组生命周期实参里有没有非 'static 的
fn has_non_static_lifetime(args: &GenericArgs) -> Bool {
    let mut i: UInt = 0;
    while i < args.lt_args.len() {
        if !lifetime_is_static(args.lt_arg(i)) {
            return true;
        }
        i += 1;
    }
    return false;
}

fn mentions_lifetime_at(sty: *SType, depth: UInt) -> Bool {
    // 类型可以是递归的 (例如 struct S { next: *raw S }), 限深避免无限展开
    if depth > 16_u {
        return false;
    }
    let c = sty.canonical();
    // canonical 会保留生命周期实参 (见 SType::canonical 的注释)。
    // 只有非 'static 的生命周期才算会丢失的信息: S<'static> 可以装箱。
    if has_non_static_lifetime(&c.args) {
        return true;
    }
    let ts = c.type_symbol;
    if ts is lt_sym: *LifetimeSymbol {
        // 生命周期本身作为类型出现时同理: 只有非 'static 的才算信息
        return !lt_sym.is_static();
    }
    if ts is type *BorrowImmutSymbol || ts is type *BorrowMutSymbol {
        // 借用: 上面的检查已经放过了显式 &'static T; 省略生命周期时 lt_args 是空的
        // (&T, 由推断决定), 这种按"会悬垂"保守处理。
        return c.args.lt_args.is_empty();
    }
    if ts is type *TypeParamSymbol {
        // 类型参数可能被实例化成带生命周期的类型 (泛型参数上没有生命周期约束),
        // 所以当成"可能含生命周期"保守处理: 泛型函数里 *T -> *TR 也要拒绝。
        return true;
    }
    for a in c.args.ty_args {
        if mentions_lifetime_at(a, depth + 1_u) {
            return true;
        }
    }
    if ts is s: *StructSymbol {
        for f in s.fields {
            if field_mentions_lifetime(f.stype, &s.generics, &c.args, depth) {
                return true;
            }
        }
        return false;
    }
    if ts is u: *UnionSymbol {
        // union 不支持泛型, 字段类型直接看 (字段里可能有会悬垂的借用)
        for f in u.fields {
            if mentions_lifetime_at(f.stype, depth + 1_u) {
                return true;
            }
        }
        return false;
    }
    if ts is e: *EnumSymbol {
        for v in e.variants {
            for f in v.fields {
                if field_mentions_lifetime(f, &e.generics, &c.args, depth) {
                    return true;
                }
            }
        }
        return false;
    }
    if ts is lam: *LambdaSymbol {
        // 闭包类型: 环境里按值/按引用捕获的字段都可能带生命周期
        for cap in lam.captures {
            if mentions_lifetime_at(cap.local_var.stype, depth + 1_u) {
                return true;
            }
        }
        return false;
    }
    return false;
}

// 成员变量 (struct / enum / union 的字段) 的类型里有没有"没写出来"的生命周期。
//
// zinc 要求类型定义里的生命周期必须显式写出:
//   struct S<'a> { r: &'a Int }   合法
//   struct S     { r: &Int }      非法 (字段的生命周期没有任何地方可以推导)
// 判定依据:
//   1. 生命周期实参比类型声明的少 —— 借用符号声明 1 个, struct/enum 声明 lt_params 个;
//   2. 写出来的生命周期是匿名的 (比如 '_ , 或编译器生成的匿名生命周期);
// 然后递归到类型实参 (Vec<&Int>、(&Int, Int) 这类)。
//
// fn 类型 (fn(&T) -> T / *Fn(&T)) 的签名不递归: 那里的生命周期是"每次调用"的,
// 成员变量不需要声明它们 (std 里的 Vec<*Fn(&T)> 就是合法的)。
fn member_field_has_elided_lifetime(sty: *SType) -> Bool {
    return member_field_elided_at(sty, 0_u);
}

fn member_field_elided_at(sty: *SType, depth: UInt) -> Bool {
    // 类型可以是递归的 (struct S { next: *raw S }), 限深避免无限展开
    if depth > 16_u {
        return false;
    }
    let c = sty.canonical();
    if c.args.lt_args.len() < c.type_symbol.lifetime_count() {
        return true;
    }
    let mut i: UInt = 0;
    while i < c.args.lt_args.len() {
        let lt = c.args.lt_arg(i);
        // 显式写出来的生命周期是具名的 (普通的 'a, 或者 'static);
        // '_ 和编译器生成的匿名生命周期都会落到这里被拒绝
        if !(lt.resolved is Some(lt_sym) && lt_sym.is_named()) {
            return true;
        }
        i += 1;
    }
    let ts = c.type_symbol;
    if ts is type *FnLowerTypeSymbol ||
        ts is type *FnUpperTypeSymbol ||
        ts is type *FnUpperMutTypeSymbol {
        return false;
    }
    for a in c.args.ty_args {
        if member_field_elided_at(a, depth + 1_u) {
            return true;
        }
    }
    return false;
}

// 检查结构体/枚举/联合体的一个字段。字段类型里可能还带着类型定义自己的类型形参
// (例如 Vec<T> 的字段是 *raw T), 必须先把实际的泛型实参代进去再判断,
// 否则任何泛型类型都会被误判成"含生命周期"。
fn field_mentions_lifetime(field_sty: *SType, generics: &GenericParams, args: &GenericArgs, depth: UInt) -> Bool {
    if generics.ty_params.is_empty() && generics.lt_params.is_empty() {
        return mentions_lifetime_at(field_sty, depth + 1_u);
    }
    let mut mappings = TypeMapping::new();
    bind_generic_args(&mut mappings, &generics.ty_params, &generics.lt_params, args);
    let substituted = mappings.subst(field_sty);
    return mentions_lifetime_at(move substituted, depth + 1_u);
}

// 闭包的捕获环境里有没有借用 (或别的生命周期信息)
fn lambda_captures_mention_lifetime(lsym: *LambdaSymbol) -> Bool {
    for c in lsym.captures {
        if mentions_lifetime(c.local_var.stype) {
            return true;
        }
    }
    return false;
}

// 两个函数类型 (fn / Fn / FnMut) 的签名是否一致
fn fn_sig_matches(a: *SType, b: *SType) -> Bool {
    if a.fn_param_count() != b.fn_param_count() {
        return false;
    }
    let mut i: UInt = 0;
    while i < a.fn_param_count() {
        if !stype_eq_regardless_lifetime(a.fn_param_sty(i), b.fn_param_sty(i)) {
            return false;
        }
        i += 1;
    }
    return stype_eq_regardless_lifetime(a.fn_return_sty(), b.fn_return_sty());
}

// 把 Fn / FnMut 类型换成签名相同的 fn 指针类型 (fn 指针是 Fn/FnMut 的"薄"版本)
fn to_fn_lower_sty(fn_sty: *SType) -> *SType {
    if !fn_sty.is_fn_type() || fn_sty.type_symbol is type *FnLowerTypeSymbol {
        return fn_sty;
    }
    let mut args = GenericArgs::new();
    for a in fn_sty.args.ty_args {
        args.ty_args.push(move a);
    }
    return FnLowerTypeSymbol::new().to_sty(move args);
}

// 闭包 -> Fn/FnMut 的一致性判断 (签名 + 捕获方式)
fn lambda_impls_fn_upper(lsym: *LambdaSymbol, fn_upper_sty: *SType) -> Bool {
    if !lambda_sig_matches(lsym, fn_upper_sty) {
        return false;
    }
    if is_fn_upper_mut(fn_upper_sty) {
        return true;
    }
    return lambda_can_impl_fn(lsym);
}

// 闭包的签名是否和 fn 类型一致; 参数类型没标注 (invalid) 或者还是抽象的, 都不算一致
fn lambda_sig_matches(lsym: *LambdaSymbol, dst: *SType) -> Bool {
    if lsym.params.len() != dst.fn_param_count() {
        return false;
    }
    let mut i: UInt = 0;
    while i < lsym.params.len() {
        let p = *lsym.params.index(i).deref();
        if p.stype.is_invalid() || contains_type_param(p.stype) || contains_associated_type(p.stype) {
            return false;
        }
        if !stype_eq_regardless_lifetime(p.stype, dst.fn_param_sty(i)) {
            return false;
        }
        i += 1;
    }
    let mut ret_sty: *SType = SType::sty_unit();
    if lsym.return_sty is Some(r) {
        ret_sty = move r;
    }
    if contains_type_param(ret_sty) || contains_associated_type(ret_sty) {
        return false;
    }
    return stype_eq_regardless_lifetime(ret_sty, dst.fn_return_sty());
}

fn is_subtype(sub: *SType, base: *SType) -> Bool {
    let c_sub = sub.canonical();
    let c_base = base.canonical();

    if c_sub.type_symbol is type *PointerLikeSymbol &&
        c_base.type_symbol is type *PointerLikeSymbol {

        // 它们俩必须是同类型的指针
        if c_sub.type_symbol as *raw TypeSymbol as UInt !=
            c_base.type_symbol as *raw TypeSymbol as UInt {
            return false;
        }

        let sub_arg = c_sub.args.ty_arg(0);
        let base_arg = c_base.args.ty_arg(0);
        return is_subtype(move sub_arg, move base_arg);
    }

    // Fn / FnMut 也有 trait 语义: 闭包类型和 fn 指针都相当于给它们做 impl
    if is_fn_upper(c_base) {
        // FnMut 不能当 Fn 用 (FnMut 少了"共享借用也能调用"的保证); 反过来可以
        if !is_fn_upper_mut(c_base) && is_fn_upper_mut(c_sub) {
            return false;
        }
        if c_sub.type_symbol is lsym: *LambdaSymbol {
            return lambda_impls_fn_upper(move lsym, move c_base);
        }
        // fn 指针 (FnLower) 的签名一致时也能当 Fn/FnMut 用
        // (调用入口会额外包一个 thunk: fn 的调用不带环境指针)
        if c_sub.is_fn_type() {
            return fn_sig_matches(move c_sub, move c_base);
        }
        return false;
    }

    if c_base.type_symbol is base_trait: *TraitSymbol {
        let base_trait_mangle_name = base_trait.mangle_name().as_str().deref();
        if base_trait_mangle_name.eq(&"::std::primitives::Any") {
            return true;
        }
        if base_trait_mangle_name.eq(&"::std::marker::Send") {
            return is_send_type(move c_sub);
        }
        if base_trait_mangle_name.eq(&"::std::marker::Sync") {
            return is_sync_type(move c_sub);
        }

        if c_sub.type_symbol is sub_trait: *TraitSymbol {
            // 检查 trait 继承关系
            // FIXME: 显然这里要考虑 trait 的泛型参数, 需要用 TypeMapping 做类型替换
            return sub_trait.is_inherited_from(base_trait);
        } else {
            // 检查 类型 impl 关系
            // FIXME: 显然这里也要考虑 泛型参数的替换
            for isym in sub.type_symbol.related_impls() {
                if isym.trait_sty is Some(itrait_sty) {
                    if itrait_sty.type_symbol as *raw TypeSymbol as UInt == base_trait as *raw TraitSymbol as UInt {
                        return true;
                    }
                }
            }
            return false;
        }
    } else {
        return false;
    }
}

// 把 sty 里"指定的那个 Self"替换成 self_ty。
// 注意: 必须按符号 identity 判断, 只替换 self_sym 这一个 Self 类型 ——
// 以前是所有 is_self_ty() 一律替换, 会把别的 trait 的 Self (例如通过 T: TR
// 调用方法时拿到的 trait Self) 也换成当前 impl 的 Self。
fn subst_self_ty(sty: *SType, self_sym: *AssociatedTypeSymbol, self_ty: *SType) -> *SType {
    if sty.type_symbol is assoc: *AssociatedTypeSymbol
        && assoc as *raw AssociatedTypeSymbol as UInt == self_sym as *raw AssociatedTypeSymbol as UInt {
        return self_ty;
    }

    let mut args = GenericArgs::new();
    args.lt_args = sty.args.lt_args;
    for a in sty.args.ty_args {
        let na = subst_self_ty(a, self_sym, self_ty);
        args.ty_args.push(move na);
    }

    return sty.type_symbol.to_sty(move args);
}

fn resolve_trait_assoc_types(sty: *SType, trait_sym: *TraitSymbol, impl_sym: *ImplSymbol) -> *SType {
    let mut args = GenericArgs::new();
    args.lt_args = sty.args.lt_args;
    for a in sty.args.ty_args {
        let na = resolve_trait_assoc_types(a, trait_sym, impl_sym);
        args.ty_args.push(move na);
    }

    if sty.type_symbol is assoc: *AssociatedTypeSymbol {
        let mut is_trait_assoc = false;
        for at in trait_sym.associated_types {
            if at as *raw AssociatedTypeSymbol as UInt == assoc as *raw AssociatedTypeSymbol as UInt {
                is_trait_assoc = true;
            }
        }
        if is_trait_assoc {
            let name = assoc.short_name();
            if impl_sym.associated_types.at(&name) is Some(alias) {
                return SType::from(alias as *TypeSymbol, move args);
            }
        }
    }

    return sty.type_symbol.to_sty(move args);
}

// 把 trait 侧的方法签名类型规范化到 impl 侧, 供 compare_method_signature 使用:
//   1) 关联类型投影 Self::Assoc<...> -> impl 里的 type 别名 (见上)
//   2) Self -> impl 的目标类型, 方法级类型参数按位置对应 (由 TypeMapping 完成)
fn normalize_trait_method_ty(
    sty: *SType,
    fn_in_trait: *FuncSymbol,
    fn_in_impl: *FuncSymbol,
    mapping: &TypeMapping,
) -> *SType {
    let mut ty = sty;
    if fn_in_trait.parent_sym is Some(trsym: *TraitSymbol) {
        if fn_in_impl.parent_sym is Some(isym: *ImplSymbol) {
            ty = resolve_trait_assoc_types(ty, trsym, isym);
        }
    }
    return mapping.subst(ty);
}

fn has_impl_drop(ts: *TypeSymbol) -> Bool {
    for i in ts.related_impls() {
        if i.trait_sty is Some(trait_sty) {
            let key = trait_sty.type_symbol.export_key();
            if key.as_str().deref().eq(&"::std::ops::drop::Drop") {
                return true;
            }
        }
    }
    return false;
}

// 是否实现了 std::marker::UnSized: std 里 File / Atomic* 这类"大小不可知、只能通过指针
// 使用"的类型就是靠实现这个标记 trait 来声明的 (见 library/zinc_std/marker.zn)。
fn has_impl_unsized(ts: *TypeSymbol) -> Bool {
    for i in ts.related_impls() {
        if i.trait_sty is Some(trait_sty) {
            let key = trait_sty.type_symbol.export_key();
            if key.as_str().deref().eq(&"::std::marker::UnSized") {
                return true;
            }
        }
    }
    return false;
}

// 这个类型的大小是否无法确定 (unsized):
//   - 裸 trait 类型 (trait 对象只能通过指针/引用使用);
//   - Fn / FnMut (同样只能通过指针/引用使用);
//   - extern type (C 侧的不完整类型);
//   - 显式实现了 std::marker::UnSized 的类型。
// 类型别名先展开; 元组/数组的元素是内联的, 元素 unsized 时整体也 unsized。
// 注意: 泛型参数 (TypeParamSymbol) 不做判断 —— Zinc 目前不要求泛型参数满足 Sized,
// struct Wrap<T> { v: T } / fn f<T>(x: T) 都是合法的。
fn is_unsized_type(sty: *SType) -> Bool {
    let t = sty.canonical();
    let ts = t.type_symbol;
    if ts is type *TraitSymbol {
        return true;
    }
    // Fn / FnMut 和裸 trait 类型一样: 大小不确定, 只能通过指针使用
    if ts is type *FnUpperTypeSymbol || ts is type *FnUpperMutTypeSymbol {
        return true;
    }
    if ts is type *ExternTypeSymbol {
        return true;
    }
    if has_impl_unsized(ts) {
        return true;
    }

    let mut is_seq = false;
    if ts is type *TupleSymbol {
        is_seq = true;
    }
    if ts is type *ArraySymbol {
        is_seq = true;
    }
    if is_seq {
        for a in t.args.ty_args {
            if is_unsized_type(a) {
                return true;
            }
        }
    }
    return false;
}

fn type_alias_contains(sty: *SType, target: *TypeAliasSymbol, visited: &mut HashSet<UInt>) -> Bool {
    if sty.type_symbol is alias: *TypeAliasSymbol {
        let key = alias as *raw TypeAliasSymbol as UInt;
        if key == target as *raw TypeAliasSymbol as UInt {
            return true;
        }
        if !visited.contains(&key) {
            visited.insert(key);
            if type_alias_contains(alias.target_sty, target, visited) {
                return true;
            }
        }
    }

    for a in sty.args.ty_args {
        if type_alias_contains(a, target, visited) {
            return true;
        }
    }
    return false;
}

// copy 和 dtor 都不需要做任何额外事情的类型, 叫做 trivial type
fn is_trivial_type(sty: *SType) -> Bool {
    match sty.type_symbol {
        type *LifetimeSymbol => return true;
        type *ExternTypeSymbol => return true;
        type *FuncSymbol => return true;
        type *TypeParamSymbol => return false;

        type *BoolSymbol => return true;
        type *CharSymbol => return true;
        type *IntegerSymbol => return true;
        type *FloatSymbol => return true;

        type *ArcPointerSymbol => return false;
        type *WeakPointerSymbol => return false;
        type *BorrowImmutSymbol => return true;
        type *BorrowMutSymbol => return true;
        type *RawPointerImmutSymbol => return true;
        type *RawPointerMutSymbol => return true;
        type *TraitSymbol => return false;
        type *UnionSymbol => return true;

        alias: *TypeAliasSymbol => {
            let mut mappings = TypeMapping::new();
            bind_generic_args(&mut mappings, &alias.generics.ty_params, &alias.generics.lt_params, &sty.args);

            let target = mappings.subst(alias.target_sty);
            return is_trivial_type(move target);
        }
        assoc: *AssociatedTypeSymbol => {
            let mut mappings = TypeMapping::new();
            bind_generic_args(&mut mappings, &assoc.generics.ty_params, &assoc.generics.lt_params, &sty.args);

            let target = mappings.subst(assoc.target_sty);
            return is_trivial_type(move target);
        }
        type *TupleSymbol => {
            for a in sty.args.ty_args {
                if !is_trivial_type(move a) {
                    return false;
                }
            }
            return true;
        }
        type *ArraySymbol => {
            if sty.args.ty_args.is_empty() {
                return true;
            } else {
                let arg = sty.args.ty_arg(0);
                return is_trivial_type(move arg);
            }
        }
        struct_sym: *StructSymbol => {
            if has_impl_drop(struct_sym as *TypeSymbol) {
                return false;
            }
            let mut mappings = TypeMapping::new();
            mappings.unify(struct_sym.to_sty(), sty);
            for field in struct_sym.fields {
                let fty = mappings.subst(field.stype);
                if !is_trivial_type(move fty) {
                    return false;
                }
            }
            return true;
        }
        enum_sym: *EnumSymbol => {
            if has_impl_drop(enum_sym as *TypeSymbol) {
                return false;
            }
            let mut mappings = TypeMapping::new();
            mappings.unify(enum_sym.to_sty(), sty);
            for ev in enum_sym.variants {
                for field in ev.fields {
                    let fty = mappings.subst(move field);
                    if !is_trivial_type(move fty) {
                        return false;
                    }
                }
            }
            return true;
        }
    }
    return false;
}

fn conform_upper_bounds(sty: *SType, constraints: &GenericConstraints, mappings: &TypeMapping) -> Bool {
    let type_symbols = constraints.constraints.keys();
    for ts in type_symbols {
        let upper_bounds = constraints.constraints.at(&ts).get_or_panic();
        let actual_sty = mappings.ty_mapping.at(&ts).get_or_panic();

        for ub in upper_bounds {
            let ub_sty = mappings.subst(ub);
            if !is_subtype(actual_sty, ub_sty) {
                return false;
            }
        }
    }
    return true;
}

fn is_send_type(sty: *SType) -> Bool {
    if implemented_trait(sty.type_symbol, "::std::marker::Send") is Some(isym) {

        let mut mappings = TypeMapping::new();
        mappings.unify(sty.type_symbol.to_sty(), isym.target_sty);
        mappings.unify(isym.target_sty, sty);

        // 检查 constraints 是否满足
        if isym.impl_node.bang.is_invalid() { // 检查是不是 negative impl
            return conform_upper_bounds(sty, &isym.generics.constraints, &mappings);
        } else {
            if conform_upper_bounds(sty, &isym.generics.constraints, &mappings) {
                return false;
            }
        }
    }

    match sty.type_symbol {
        type *BoolSymbol => return true;
        type *CharSymbol => return true;
        type *IntegerSymbol => return true;
        type *FloatSymbol => return true;
        type *TypeAliasSymbol => return is_send_type(sty.canonical());
        type *TypeParamSymbol => { return false; } // todo 考虑泛型约束
        type *AssociatedTypeSymbol => { return false; } // todo 考虑泛型约束
        type *LifetimeSymbol => return false;
        type *ExternTypeSymbol => return false;
        type *FuncSymbol => return true;
        type *EnumVariantSymbol => return true;

        type *PointerLikeSymbol => {
            let pointee = sty.args.ty_arg(0);
            return is_sync_type(move pointee);
        }
        type *TupleSymbol => {
            for e in sty.args.ty_args {
                if !is_send_type(move e) {
                    return false;
                }
            }
            return true;
        }
        type *ArraySymbol => {
            if sty.args.ty_args.is_empty() {
                return true;
            } else {
                let elem = sty.args.ty_arg(0);
                return is_send_type(move elem);
            }
        }
        struct_sym: *StructSymbol => {
            for f in struct_sym.fields {
                if !is_send_type(f.stype) {
                    return false;
                }
            }
            return true;
        }
        enum_sym: *EnumSymbol => {
            for ev in enum_sym.variants {
                for f in ev.fields {
                    if !is_send_type(f) {
                        return false;
                    }
                }
            }
            return true;
        }
        union_sym: *UnionSymbol => {
            for f in union_sym.fields {
                if !is_send_type(f.stype) {
                    return false;
                }
            }
            return true;
        }
        _ => return false;
    }
    return false;
}

fn is_sync_type(sty: *SType) -> Bool {
    if implemented_trait(sty.type_symbol, "::std::marker::Sync") is Some(isym) {
        let mut mappings = TypeMapping::new();
        mappings.unify(sty.type_symbol.to_sty(), isym.target_sty);
        mappings.unify(isym.target_sty, sty);

        // 检查 constraints 是否满足
        if isym.impl_node.bang.is_invalid() { // 检查是不是 negative impl
            return conform_upper_bounds(sty, &isym.generics.constraints, &mappings);
        }
    }
    return false;
}

fn implemented_trait(ts: *TypeSymbol, name: Str) -> Option<*ImplSymbol> {
    for i in ts.related_impls() {
        if i.trait_sty is Some(trait_sty) {
            let key = trait_sty.type_symbol.export_key();
            if key.as_str().deref().eq(&name) {
                return Some(move i);
            }
        }
    }
    return None;
}
