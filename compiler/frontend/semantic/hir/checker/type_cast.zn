
use ::self::frontend::semantic::hir::ir::*;
use ::self::frontend::source_code::*;
use ::self::frontend::diagnostic::*;

use super::type_mapping::*;
use super::type_utils::*;

use std::primitives::string::ToString;

enum ResolvedCastKind {
    Err,
    SameType,
    BoolToInt,
    IntToInt,
    IntToFloat,
    EnumToInt,
    FloatExt,
    FloatTrunc,
    FloatToInt,
    CharToUInt32,
    UInt32ToChar,
    ArrayRefToSlice,
    FunctionToFnLower,
    // 带泛型的函数/方法不能转换成 fn 类型
    GenericFunctionToFnLower,
    // 捕获了外部变量的闭包不能转换成 fn 类型
    CaptureLambdaToFnLower,
    FunctionToFnUpperBorrow,
    FnLowerToFnUpperBorrow,
    LambdaToFnLower,
    LambdaToFnUpperPtr,
    // 捕获了 &mut 的闭包只能用 &mut FnMut 调用, 不能转换成 &Fn
    MutCaptureLambdaToFn,
    // 借用捕获的闭包装箱成 *Fn / *FnMut / *weak Fn: 环境里的借用会丢生命周期
    OwnedFnUpperErasesLifetime,
    // 带生命周期参数的类型装箱成拥有所有权的 trait 对象指针 (*TR)
    OwnedTraitObjectErasesLifetime,
    ArcToWeak, // 指针转换注意分 Fat/Thin 两种不同情况做代码生成
    MutBorrowToImmut,
    PointerSafeToUnsafe,
    TypedPtrToUnitPtr,
    // 在 unsafe 上下文中允许 raw 转换回 Arc/Borrow
    PointerUnsafeToSafe,
    UnsafePointerToUnsafePointer, // 被指向类型可以不同
    UnsafePointerToUInt,
    UIntToUnsafePointer,
    // 这两种情况都是 Ptr<Sub> 到 Ptr<Base> 的转换
    ThinPtrUpToFatPtr,
    FatPtrDownToThinPtr,
    FatPtrToFatPtr,
    // 如果 U: Deref<V> 则 U 可以转换为 V
    DerefCast(DerefMethodInfo),
    DerefMutCast(DerefMethodInfo),
    // 在 unsafe 上下文中允许 lifetime cast
    LifetimeCast
}

// 判断能否从 from 类型转换为 to
fn resolve_type_cast_kind(from: *SType, to: *SType) -> ResolvedCastKind {

    if from.is_invalid() {
        return ResolvedCastKind::Err;
    }
    if to.is_invalid() {
        return ResolvedCastKind::Err;
    }

    let src = from.canonical();
    let dst = to.canonical();

    // 定长数组的元素个数也是类型的一部分: [T; 2] 和 [T; 3] 不是同一个类型。
    // stype_eq_regardless_lifetime 只按较短的一边比较元素, 这里必须先挡掉长度不一致的情况。
    if src.type_symbol is type *ArraySymbol && dst.type_symbol is type *ArraySymbol {
        if src.args.ty_args.len() != dst.args.ty_args.len() {
            return ResolvedCastKind::Err;
        }
    }

    if src as *raw SType as UInt == dst as *raw SType as UInt {
        return ResolvedCastKind::SameType;
    }

    if stype_eq_regardless_lifetime(src, dst) {
        return ResolvedCastKind::LifetimeCast;
    }

    // Bool 转换为整数
    if src.type_symbol is type *BoolSymbol && dst.type_symbol is type *IntegerSymbol {
        return ResolvedCastKind::BoolToInt;
    }

    // 整数、浮点数之间的转换
    if src.type_symbol is type *IntegerSymbol && dst.type_symbol is type *IntegerSymbol {
        return ResolvedCastKind::IntToInt;
    }

    if src.type_symbol is type *IntegerSymbol && dst.type_symbol is type *FloatSymbol {
        return ResolvedCastKind::IntToFloat;
    }

    if src.type_symbol is type *FloatSymbol && dst.type_symbol is type *IntegerSymbol {
        return ResolvedCastKind::FloatToInt;
    }

    if src.type_symbol is src_sym: *FloatSymbol && dst.type_symbol is dst_sym: *FloatSymbol {
        if src_sym.kind.eq(&dst_sym.kind) {
            return ResolvedCastKind::SameType;
        }
        else if src_sym.kind.lt(&dst_sym.kind) {
            return ResolvedCastKind::FloatExt;
        }
        else {
            return ResolvedCastKind::FloatTrunc;
        }
    }

    // 整数、Char 之间的转换
    if src.type_symbol is src_sym: *IntegerSymbol && dst.type_symbol is type *CharSymbol
        && src_sym.kind is IntegerKind::U32 {
        return ResolvedCastKind::UInt32ToChar;
    }

    if src.type_symbol is type *CharSymbol && dst.type_symbol is dst_sym: *IntegerSymbol
        && dst_sym.kind is IntegerKind::U32 {
        return ResolvedCastKind::CharToUInt32;
    }

    // enum 到整数的转换
    if src.type_symbol is src_sym: *EnumSymbol && dst.type_symbol is dst_sym: *IntegerSymbol {
        if src_sym.variants.len() as UInt64 > dst_sym.kind.max_num() {
            return ResolvedCastKind::Err;
        } else {
            return ResolvedCastKind::EnumToInt;
        }
    }

    // 定长数组的借用, 转换为 Slice
    if (is_borrow_to_array(src) && is_slice(dst)) ||
        (is_borrow_to_array(src) && is_slicemut(dst)) ||
        (is_mutborrow_to_array(src) && is_slicemut(dst)) {
        return ResolvedCastKind::ArrayRefToSlice;
    }

    // 函数类型相关的转换: 函数项 / 方法 / enum variant 构造函数 / 没有捕获的闭包
    // 都可以转换成 fn(A, B) -> C (FnLower); 签名必须一致。
    // 带泛型的函数/方法不能转换 (签名不确定); 捕获了外部变量的闭包要等 Fn/FnMut 支持。
    // (到 Fn/FnMut 的转换暂未实现)
    if dst.type_symbol is type *FnLowerTypeSymbol {
        if src.type_symbol is fsym: *FuncSymbol {
            if fn_item_is_generic(fsym) {
                return ResolvedCastKind::GenericFunctionToFnLower;
            }
            if fn_item_sig_matches(fsym, dst) {
                return ResolvedCastKind::FunctionToFnLower;
            }
            return ResolvedCastKind::Err;
        }

        if src.type_symbol is evsym: *EnumVariantSymbol {
            if enum_ctor_sig_matches(evsym, dst) {
                return ResolvedCastKind::FunctionToFnLower;
            }
            return ResolvedCastKind::Err;
        }

        if src.type_symbol is lsym: *LambdaSymbol {
            if !lsym.captures.is_empty() {
                return ResolvedCastKind::CaptureLambdaToFnLower;
            }
            // 没有捕获的闭包可以退化成裸函数指针, 代码生成阶段会为它生成一个函数
            if lambda_sig_matches(lsym, dst) {
                return ResolvedCastKind::LambdaToFnLower;
            }
            return ResolvedCastKind::Err;
        }
    }

    // 闭包 / 指向闭包的指针 转换成 &Fn / &mut FnMut (胖指针)。
    // Fn/FnMut 有 trait 语义: 闭包类型相当于给它们做 impl, 这里做一致性判断。
    // 这一条必须放在通用的指针转换之前 —— 这两种胖指针的第二个字不是 typemeta,
    // 不能按 "瘦指针转胖指针" 的通用规则来生成。
    if dst.is_fat_pointer() && is_fn_upper(dst.args.ty_arg(0)) {
        let pointee = dst.args.ty_arg(0);
        // 目标指针的所有权种类必须和来源匹配 (借用 ↔ 借用, Arc ↔ Arc/Weak, ...)
        let dst_kind = pointer_kind_of(dst);
        if src.type_symbol is lsym: *LambdaSymbol {
            // 闭包值本身: 只有没有捕获的闭包能直接当借用用 (它不携带数据);
            // 有捕获的闭包值要先绑定到变量再取地址 (resolve_lambda_to_fn_upper 里判断)
            if dst_kind is PointerKind::BorrowImmut || dst_kind is PointerKind::BorrowMut {
                return resolve_lambda_to_fn_upper(move lsym, move pointee, false);
            }
            return ResolvedCastKind::Err;
        }
        if src.type_symbol is type *PointerLikeSymbol {
            let src_kind = pointer_kind_of(src);
            if !pointer_kinds_compatible(src_kind, dst_kind) {
                return ResolvedCastKind::Err;
            }
            let inner = src.args.ty_arg(0);
            if inner.type_symbol is lsym2: *LambdaSymbol {
                // &闭包 / &mut 闭包 -> &Fn / &mut FnMut。
                // 从共享借用里拿不到可变借用, 所以 &闭包 不能转成 &mut FnMut。
                if is_fn_upper_mut(pointee) && src_kind is PointerKind::BorrowImmut {
                    return ResolvedCastKind::Err;
                }
                // Arc<闭包> / Weak<闭包> -> *Fn / *weak Fn: 闭包环境里的借用
                // (按引用捕获, 或者按值捕获了含借用的类型) 不会出现在 Fn 类型里,
                // 装箱之后生命周期信息就丢了 —— 必须报错。
                if (src_kind is PointerKind::Arc || src_kind is PointerKind::Weak) &&
                    lambda_captures_mention_lifetime(lsym2) {
                    return ResolvedCastKind::OwnedFnUpperErasesLifetime;
                }
                return resolve_lambda_to_fn_upper(move lsym2, move pointee, true);
            }
            // &fn 指针 / &mut fn 指针 / Arc<fn 指针> -> &Fn / &mut FnMut / *Fn。
            // fn 指针的调用不带环境指针, 所以代码生成阶段要包一个 thunk:
            // 从指针里 load 出 fn 指针, 再按 fn 的签名调用它。
            if inner.type_symbol is type *FnLowerTypeSymbol {
                if !fn_sig_matches(inner, pointee) {
                    return ResolvedCastKind::Err;
                }
                // &fn 指针 -> &mut FnMut 不行 (需要能替换被指向的 fn 指针的可变借用)
                if is_fn_upper_mut(pointee) && src_kind is PointerKind::BorrowImmut {
                    return ResolvedCastKind::Err;
                }
                return ResolvedCastKind::FnLowerToFnUpperBorrow;
            }
        }
        // 指向同一个 Fn/FnMut 类型的指针之间的转换 (例如 *Fn -> *weak Fn) 布局相同,
        // 交给后面的通用指针规则处理。其他来源一律拒绝: 通用的"瘦指针转胖指针"
        // 构造出来的是 trait 对象的布局 (第二个字是 typemeta, 第三个字是 vtable),
        // 和 Fn 的调用入口完全不同。
        if src.type_symbol is type *PointerLikeSymbol &&
            stype_eq_regardless_lifetime(src.args.ty_arg(0), pointee) {
            // 落到后面的通用指针转换
        } else {
            return ResolvedCastKind::Err;
        }
    }

    // 指针之间的转换
    // 1. Arc 到 weak
    if src.type_symbol is type *ArcPointerSymbol &&
        dst.type_symbol is type *WeakPointerSymbol &&
        stype_eq_regardless_lifetime(src.args.ty_arg(0), dst.args.ty_arg(0)) {
        return ResolvedCastKind::ArcToWeak;
    }
    // 2. Raw 到 UInt
    if (src.type_symbol is type *RawPointerImmutSymbol || src.type_symbol is type *RawPointerMutSymbol) {
        if dst.type_symbol is dst_sym: *IntegerSymbol && dst_sym.kind is IntegerKind::Usize {
            return ResolvedCastKind::UnsafePointerToUInt;
        }
    }
    // 3. UInt 到 Raw
    if (dst.type_symbol is type *RawPointerImmutSymbol || dst.type_symbol is type *RawPointerMutSymbol) {
        if src.type_symbol is src_sym: *IntegerSymbol && src_sym.kind is IntegerKind::Usize &&
            !dst.is_fat_pointer() {
            return ResolvedCastKind::UIntToUnsafePointer;
        }
    }
    // 4. MutBorrow 到 ImmutBorrow
    if src.type_symbol is type *BorrowMutSymbol &&
        dst.type_symbol is type *BorrowImmutSymbol &&
        stype_eq_regardless_lifetime(src.args.ty_arg(0), dst.args.ty_arg(0)) {
        return ResolvedCastKind::MutBorrowToImmut;
    }
    // 5. safe pointer 到 unsafe pointer
    if is_safe_pointer(src) && is_unsafe_pointer(dst) &&
        stype_eq_regardless_lifetime(src.args.ty_arg(0), dst.args.ty_arg(0)) {
        return ResolvedCastKind::PointerSafeToUnsafe;
    }
    // 6. unsafe pointer 到 safe pointer
    if is_unsafe_pointer(src) && is_safe_pointer(dst) &&
        stype_eq_regardless_lifetime(src.args.ty_arg(0), dst.args.ty_arg(0)) {
        return ResolvedCastKind::PointerUnsafeToSafe;
    }
    // 7. pointer 到 unit pointer
    if src.type_symbol is type *PointerLikeSymbol &&
        src.type_symbol as *raw TypeSymbol as UInt == dst.type_symbol as *raw TypeSymbol as UInt &&
        dst.args.ty_arg(0).is_unit() {
        return ResolvedCastKind::TypedPtrToUnitPtr;
    }
    // 8. 瘦指针转胖指针
    if src.is_thin_pointer() && dst.is_fat_pointer() &&
        src.type_symbol as *raw TypeSymbol as UInt == dst.type_symbol as *raw TypeSymbol as UInt {
        // 拥有所有权的指针 (Arc/Weak) 转到胖指针时, 被指向类型会被"擦除"成 trait 对象
        // (第二个字是 typemeta, 第三个字是 vtable), 类型自己的生命周期实参不会保留:
        //   Arc<S<'a>> -> Arc<TR>  之后 'a 就丢了, 这个 Arc 可能活得比 S 借用的对象更长。
        // 所以只允许生命周期无关的类型这么转 (借用 &S<'a> -> &TR 不受影响: 借用本身
        // 还连着 S, 而且 origin 分析会继续盯着 S 里借用的对象)。
        if src.type_symbol is type *ArcPointerSymbol || src.type_symbol is type *WeakPointerSymbol {
            if mentions_lifetime(src.args.ty_arg(0)) {
                return ResolvedCastKind::OwnedTraitObjectErasesLifetime;
            }
        }
        return ResolvedCastKind::ThinPtrUpToFatPtr;
    }
    // 9. 胖指针转瘦指针
    if src.is_fat_pointer() && dst.is_thin_pointer() &&
        src.type_symbol as *raw TypeSymbol as UInt == dst.type_symbol as *raw TypeSymbol as UInt {
        return ResolvedCastKind::FatPtrDownToThinPtr;
    }
    // 10. 胖指针转胖指针
    if src.is_fat_pointer() && dst.is_fat_pointer() &&
        src.type_symbol as *raw TypeSymbol as UInt == dst.type_symbol as *raw TypeSymbol as UInt {
        return ResolvedCastKind::FatPtrToFatPtr;
    }
    // 11. unsafe pointer 到 unsafe pointer
    if is_unsafe_pointer(src) && is_unsafe_pointer(dst) {
        return ResolvedCastKind::UnsafePointerToUnsafePointer;
    }

    // 处理 Self type
    if src.type_symbol is assoc_ty: *AssociatedTypeSymbol {
        let mut subst = TypeMapping::new();
        subst.unify(assoc_ty.to_sty(), src);
        let target = subst.subst(assoc_ty.target_sty);

        return resolve_type_cast_kind(target, dst);
    }
    if dst.type_symbol is assoc_ty: *AssociatedTypeSymbol {
        let mut subst = TypeMapping::new();
        subst.unify(assoc_ty.to_sty(), dst);
        let target = subst.subst(assoc_ty.target_sty);

        return resolve_type_cast_kind(src, target);
    }
    if src.type_symbol is type *PointerLikeSymbol && dst.type_symbol is type *PointerLikeSymbol &&
        src.type_symbol as *raw TypeSymbol as UInt == dst.type_symbol as *raw TypeSymbol as UInt {

        let src_arg0: *SType = src.args.ty_arg(0);
        let mut src_arg0_is_self = false;
        if src_arg0.type_symbol is assoc_ty1: *AssociatedTypeSymbol && assoc_ty1.is_self_ty() { src_arg0_is_self = true; }
        let dst_arg0: *SType = dst.args.ty_arg(0);
        let mut dst_arg0_is_self = false;
        if dst_arg0.type_symbol is assoc_ty2: *AssociatedTypeSymbol && assoc_ty2.is_self_ty() { dst_arg0_is_self = true; }

        if src_arg0_is_self {
            if dst.is_fat_pointer() {
                return ResolvedCastKind::ThinPtrUpToFatPtr;
            } else {
                return ResolvedCastKind::SameType;
            }
        }
        if dst_arg0_is_self {
            if src.is_fat_pointer() {
                return ResolvedCastKind::FatPtrDownToThinPtr;
            } else {
                return ResolvedCastKind::SameType;
            }
        }
    }

    // 处理自动 Deref
    // [todo] 还需要考虑 src 是 TypeParamSymbol 带有 Deref 约束的场景
    // [todo] 还需要考虑多层 auto deref 的场景
    if detect_deref_trait_cast(src, dst) is Some(info) {
        return ResolvedCastKind::DerefCast(move info);
    }
    if detect_derefmut_trait_cast(src, dst) is Some(info) {
        return ResolvedCastKind::DerefMutCast(move info);
    }

    return ResolvedCastKind::Err;
}

fn detect_deref_trait_cast(src: *SType, dst: *SType) -> Option<DerefMethodInfo> {
    if src.type_symbol is type *ArcPointerSymbol {
        let src_arg = src.args.ty_arg(0);
        return detect_deref_trait_cast(src_arg, dst);
    }
    if src.type_symbol is type *BorrowImmutSymbol {
        let src_arg = src.args.ty_arg(0);
        return detect_deref_trait_cast(src_arg, dst);
    }
    if src.type_symbol is type *BorrowMutSymbol {
        let src_arg = src.args.ty_arg(0);
        return detect_deref_trait_cast(src_arg, dst);
    }
    if !(src.type_symbol is type *PointerLikeSymbol) && implemented_deref_trait(src) is Some(info) {
        if stype_eq_regardless_lifetime(info.target_sty, dst) {
            return Some(move info);
        }
    }
    return None;
}

fn detect_derefmut_trait_cast(src: *SType, dst: *SType) -> Option<DerefMethodInfo> {
    if src.type_symbol is type *ArcPointerSymbol {
        let src_arg = src.args.ty_arg(0);
        return detect_derefmut_trait_cast(src_arg, dst);
    }
    if src.type_symbol is type *BorrowMutSymbol {
        let src_arg = src.args.ty_arg(0);
        return detect_derefmut_trait_cast(src_arg, dst);
    }
    if !(src.type_symbol is type *PointerLikeSymbol) &&
        implemented_derefmut_trait(src) is Some(info) && 
        stype_eq_regardless_lifetime(info.target_sty, dst) {
        return Some(move info);
    }
    return None;
}

fn add_implicit_cast(v: *RValue, kind: ResolvedCastKind, dst_ty: *SType) -> *RValue {

    if kind is ResolvedCastKind::Err {
        DiagnosticEngine::get().emit_cast_error(v.get_stype().to_string(), dst_ty.to_string(), v.expr_node().span());
        return v;
    }
    if kind is ResolvedCastKind::SameType {
        return v;
    }
    if kind is ResolvedCastKind::DerefCast(info) {
        let desugared_receiver = auto_ref_and_deref(info.receiver_sty, v.get_stype(), v);
        let method_call = MethodCallValue::create(
            move desugared_receiver, info.method_sym, GenericArgs::new(), (type Vec<*RValue>)::new(), info.target_sty);
        return method_call as *RValue;
    }
    if kind is ResolvedCastKind::DerefMutCast(info) {
        let desugared_receiver = auto_ref_and_deref(info.receiver_sty, v.get_stype(), v);
        let method_call = MethodCallValue::create(
            move desugared_receiver, info.method_sym, GenericArgs::new(), (type Vec<*RValue>)::new(), info.target_sty);
        return method_call as *RValue;
    }
    if kind is ResolvedCastKind::BoolToInt ||
        kind is ResolvedCastKind::IntToInt ||
        kind is ResolvedCastKind::IntToFloat ||
        kind is ResolvedCastKind::FloatExt ||
        kind is ResolvedCastKind::FloatTrunc ||
        kind is ResolvedCastKind::FloatToInt ||
        kind is ResolvedCastKind::CharToUInt32 ||
        kind is ResolvedCastKind::UInt32ToChar ||
        kind is ResolvedCastKind::EnumToInt ||
        kind is ResolvedCastKind::PointerSafeToUnsafe ||
        kind is ResolvedCastKind::PointerUnsafeToSafe ||
        kind is ResolvedCastKind::UnsafePointerToUnsafePointer ||
        kind is ResolvedCastKind::UnsafePointerToUInt ||
        kind is ResolvedCastKind::UIntToUnsafePointer ||
        kind is ResolvedCastKind::FatPtrDownToThinPtr {

        DiagnosticEngine::get().emit_illegal_implicit_cast(v.get_stype().to_string(), dst_ty.to_string(), v.expr_node().span());
    }

    if kind is ResolvedCastKind::GenericFunctionToFnLower {
        DiagnosticEngine::get().emit_generic_fn_to_fn_type(v.get_stype().to_string(), v.expr_node().span());
        return v;
    }

    if kind is ResolvedCastKind::CaptureLambdaToFnLower {
        DiagnosticEngine::get().emit_capture_lambda_to_fn_type(v.expr_node().span());
        return v;
    }

    if kind is ResolvedCastKind::MutCaptureLambdaToFn {
        DiagnosticEngine::get().emit_capture_lambda_needs_fnmut(v.expr_node().span());
        return v;
    }

    if kind is ResolvedCastKind::OwnedFnUpperErasesLifetime {
        DiagnosticEngine::get().emit_owned_fn_lifetime_erased(v.get_stype().to_string(), v.expr_node().span());
        return v;
    }

    if kind is ResolvedCastKind::OwnedTraitObjectErasesLifetime {
        DiagnosticEngine::get().emit_owned_trait_object_lifetime_erased(
            v.get_stype().to_string(), dst_ty.to_string(), v.expr_node().span());
        return v;
    }

    if kind is ResolvedCastKind::FatPtrToFatPtr {
        // 确保 v 的类型是 dst_ty 的子类型
        if !is_subtype(v.get_stype(), dst_ty) {
            DiagnosticEngine::get().emit_not_subtype(v.get_stype().to_string(), dst_ty.to_string(), v.expr_node().span());
        }
    }

    if kind is ResolvedCastKind::ThinPtrUpToFatPtr {
        // 确保 v 的类型是 dst_ty 的子类型

        // FIXME: 泛型参数场景要根据当前上下文的 constraints 判断
        let sub = v.get_stype();
        if !contains_type_param(sub) && !contains_associated_type(sub) {
            if !is_subtype(sub, dst_ty) {
                DiagnosticEngine::get().emit_not_subtype(v.get_stype().to_string(), dst_ty.to_string(), v.expr_node().span());
            }
        }
    }

    let mut cast = CastValue::create(move v, move dst_ty);
    cast.resolved_kind = kind;
    cast.is_refutable = true;
    return cast as *RValue;
}

impl ToString for ResolvedCastKind {
    fn to_string_inplace(&self, buf: &mut String) {
        match self {
            ResolvedCastKind::Err => buf.push_str("Err");
            ResolvedCastKind::SameType => buf.push_str("SameType");
            ResolvedCastKind::BoolToInt => buf.push_str("BoolToInt");
            ResolvedCastKind::IntToInt => buf.push_str("IntToInt");
            ResolvedCastKind::IntToFloat => buf.push_str("IntToFloat");
            ResolvedCastKind::EnumToInt => buf.push_str("EnumToInt");
            ResolvedCastKind::FloatExt => buf.push_str("FloatExt");
            ResolvedCastKind::FloatTrunc => buf.push_str("FloatTrunc");
            ResolvedCastKind::FloatToInt => buf.push_str("FloatToInt");
            ResolvedCastKind::CharToUInt32 => buf.push_str("CharToUInt32");
            ResolvedCastKind::UInt32ToChar => buf.push_str("UInt32ToChar");
            ResolvedCastKind::ArrayRefToSlice => buf.push_str("ArrayRefToSlice");
            ResolvedCastKind::FunctionToFnLower => buf.push_str("FunctionToFnLower");
            ResolvedCastKind::GenericFunctionToFnLower => buf.push_str("GenericFunctionToFnLower");
            ResolvedCastKind::CaptureLambdaToFnLower => buf.push_str("CaptureLambdaToFnLower");
            ResolvedCastKind::FunctionToFnUpperBorrow => buf.push_str("FunctionToFnUpperBorrow");
            ResolvedCastKind::FnLowerToFnUpperBorrow => buf.push_str("FnLowerToFnUpperBorrow");
            ResolvedCastKind::LambdaToFnLower => buf.push_str("LambdaToFnLower");
            ResolvedCastKind::LambdaToFnUpperPtr => buf.push_str("LambdaToFnUpperPtr");
            ResolvedCastKind::MutCaptureLambdaToFn => buf.push_str("MutCaptureLambdaToFn");
            ResolvedCastKind::OwnedFnUpperErasesLifetime => buf.push_str("OwnedFnUpperErasesLifetime");
            ResolvedCastKind::OwnedTraitObjectErasesLifetime => buf.push_str("OwnedTraitObjectErasesLifetime");
            ResolvedCastKind::ArcToWeak => buf.push_str("ArcToWeak");
            ResolvedCastKind::MutBorrowToImmut => buf.push_str("MutBorrowToImmut");
            ResolvedCastKind::PointerSafeToUnsafe => buf.push_str("PointerSafeToUnsafe");
            ResolvedCastKind::TypedPtrToUnitPtr => buf.push_str("TypedPtrToUnitPtr");
            ResolvedCastKind::PointerUnsafeToSafe => buf.push_str("PointerUnsafeToSafe");
            ResolvedCastKind::UnsafePointerToUnsafePointer => buf.push_str("UnsafePointerToUnsafePointer");
            ResolvedCastKind::UnsafePointerToUInt => buf.push_str("UnsafePointerToUInt");
            ResolvedCastKind::UIntToUnsafePointer => buf.push_str("UIntToUnsafePointer");
            ResolvedCastKind::ThinPtrUpToFatPtr => buf.push_str("ThinPtrUpToFatPtr");
            ResolvedCastKind::FatPtrDownToThinPtr => buf.push_str("FatPtrDownToThinPtr");
            ResolvedCastKind::FatPtrToFatPtr => buf.push_str("FatPtrToFatPtr");
            ResolvedCastKind::DerefCast(_) => buf.push_str("DerefCast");
            ResolvedCastKind::DerefMutCast(_) => buf.push_str("DerefMutCast");
            ResolvedCastKind::LifetimeCast => buf.push_str("LifetimeCast");
        }
    }

    fn to_string(&self) -> String {
        let mut buf = String::new();
        self.to_string_inplace(&mut buf);
        return buf;
    }
}

// 检查 expr is pat 的结果是 AlwaysTrue, AlwaysFalse, Maybe
enum TypeTestKind {
    AlwaysTrue,
    AlwaysFalse,
    Maybe(*SType, *SType),
}

fn resolve_type_test_kind(expr_ty: *SType, pat_ty: *SType) -> TypeTestKind {
    match expr_ty.type_symbol {
        trait_sym: *TraitSymbol => {
            if pat_ty.type_symbol is type *TraitSymbol {
                if trait_sym as *raw TraitSymbol as UInt == pat_ty.type_symbol as *raw TypeSymbol as UInt {
                    return TypeTestKind::AlwaysTrue;
                }
            }
            return TypeTestKind::Maybe(expr_ty, pat_ty);
        }
        type_param_sym: *TypeParamSymbol => {
            if type_param_sym as *raw TypeParamSymbol as UInt == pat_ty.type_symbol as *raw TypeSymbol as UInt {
                return TypeTestKind::AlwaysTrue;
            }
            return TypeTestKind::Maybe(expr_ty, pat_ty);
        }
        _ => {
            if expr_ty.type_symbol as *raw TypeSymbol as UInt != pat_ty.type_symbol as *raw TypeSymbol as UInt {
                return TypeTestKind::AlwaysFalse;
            }
            if expr_ty.args.ty_args.len() != pat_ty.args.ty_args.len() {
                return TypeTestKind::AlwaysFalse;
            }
            let mut results = (type Vec<TypeTestKind>)::new();
            let mut i: UInt = 0;
            while i < expr_ty.args.ty_args.len() {
                let expr_arg = expr_ty.args.ty_arg(i);
                let pat_arg = pat_ty.args.ty_arg(i);
                let k = resolve_type_test_kind(expr_arg, pat_arg);
                if k is TypeTestKind::AlwaysFalse {
                    return TypeTestKind::AlwaysFalse;
                }
                if !(k is TypeTestKind::AlwaysTrue) {
                    results.push(move k);
                }
                i += 1;
            }

            if results.len() == 0 {
                return TypeTestKind::AlwaysTrue;
            } 
            else if results.len() == 1 {
                return results.at(0).get_or_panic();
            }
            else {
                return TypeTestKind::Maybe(expr_ty, pat_ty);
            }
        }
    }
}
// 函数项 (含方法) 的签名工具 ---------------------------------------------------

// impl 里的方法签名里会出现 impl 的 Self, 比较前先换成 impl 的目标类型
fn fn_item_normalize(sty: *SType, fsym: *FuncSymbol) -> *SType {
    if fsym.parent_sym is Some(isym: *ImplSymbol) {
        return subst_self_ty(sty, isym.self_ty, isym.self_ty.target_sty);
    }
    return sty;
}

fn fn_item_param_sty(fsym: *FuncSymbol, i: UInt) -> *SType {
    let p = *fsym.params.index(i).deref();
    return fn_item_normalize(p.stype, fsym);
}

fn fn_item_ret_sty(fsym: *FuncSymbol) -> *SType {
    let mut ret_sty: *SType = SType::sty_unit();
    if fsym.return_sty is Some(r) {
        ret_sty = fn_item_normalize(r, fsym);
    }
    return ret_sty;
}

// 函数/方法是否是"泛型"的: 它自己的类型参数、trait 方法 (Self 抽象)、
// 泛型 impl 里的方法、或者签名里还残留类型参数/关联类型, 都不能变成 fn 类型
fn fn_item_is_generic(fsym: *FuncSymbol) -> Bool {
    if !fsym.generics.ty_params.is_empty() {
        return true;
    }
    if fsym.parent_sym is Some(type *TraitSymbol) {
        return true;
    }
    if fsym.parent_sym is Some(isym: *ImplSymbol) {
        if !isym.generics.ty_params.is_empty() {
            return true;
        }
    }

    let mut i: UInt = 0;
    while i < fsym.params.len() {
        let p = fn_item_param_sty(fsym, i);
        if contains_type_param(p) || contains_associated_type(p) {
            return true;
        }
        i += 1;
    }
    let ret_sty = fn_item_ret_sty(fsym);
    return contains_type_param(ret_sty) || contains_associated_type(ret_sty);
}

// 函数项的签名是否和 fn 类型一致
fn fn_item_sig_matches(fsym: *FuncSymbol, dst: *SType) -> Bool {
    if fsym.params.len() != dst.fn_param_count() {
        return false;
    }
    let mut i: UInt = 0;
    while i < fsym.params.len() {
        if !stype_eq_regardless_lifetime(fn_item_param_sty(fsym, i), dst.fn_param_sty(i)) {
            return false;
        }
        i += 1;
    }
    return stype_eq_regardless_lifetime(fn_item_ret_sty(fsym), dst.fn_return_sty());
}

// enum variant 构造函数: fn(字段类型...) -> Enum 类型; 泛型 enum 先不支持
fn enum_ctor_sig_matches(evsym: *EnumVariantSymbol, dst: *SType) -> Bool {
    let esym = evsym.parent_enum.get_or_panic();
    if !esym.generics.ty_params.is_empty() {
        return false;
    }
    if evsym.fields.len() != dst.fn_param_count() {
        return false;
    }
    let mut i: UInt = 0;
    while i < evsym.fields.len() {
        let f = *evsym.fields.index(i).deref();
        if !stype_eq_regardless_lifetime(f, dst.fn_param_sty(i)) {
            return false;
        }
        i += 1;
    }
    return stype_eq_regardless_lifetime(esym.to_sty(), dst.fn_return_sty());
}

// 闭包的签名是否和 fn 类型一致; 参数类型没标注 (invalid) 或者还是抽象的, 都不算一致
// (实现在 type_utils.zn, 类型检查的其他地方也要用)

// ---------------------------------------------------------------------------
// Fn / FnMut (FnUpper / FnUpperMut) 有 trait 语义: 闭包类型相当于给它们做 impl。
// 和 trait 不同的是, 闭包类型是唯一的 "实现者", 并且按捕获方式区分:
//   - 没有捕获 / 只有 Ref, Value 捕获的闭包 -> Fn   (可以只拿共享借用调用)
//   - 有 RefMut 捕获的闭包               -> FnMut (调用时需要一个可变借用)
// (判断函数在 type_utils.zn 里, 类型检查的其他地方也要用)
// ---------------------------------------------------------------------------

// 闭包 -> &Fn / &mut FnMut。
//   - 没有捕获的闭包可以直接转换 (它不携带任何数据)
//   - 有捕获的闭包必须先把值绑定到变量, 再 &变量 转换 (闭包值需要一块存储放环境)
// from_ptr 表示当前的源类型已经是指向闭包的指针 (&闭包 / &mut 闭包 / box 闭包)
fn resolve_lambda_to_fn_upper(lsym: *LambdaSymbol, fn_upper_sty: *SType, from_ptr: Bool) -> ResolvedCastKind {
    if !lambda_impls_fn_upper(lsym, fn_upper_sty) {
        // 签名一致但没有捕获没有问题时, 只有 "需要 &mut" 这一种失败原因
        if lambda_sig_matches(lsym, fn_upper_sty) && !lambda_can_impl_fn(lsym) {
            return ResolvedCastKind::MutCaptureLambdaToFn;
        }
        return ResolvedCastKind::Err;
    }
    if !lsym.captures.is_empty() && !from_ptr {
        // 携带环境的闭包没有地方存放: 类型不匹配 (&Fn(..) 只能指向一个已经存在的闭包值)
        return ResolvedCastKind::Err;
    }
    return ResolvedCastKind::LambdaToFnUpperPtr;
}
