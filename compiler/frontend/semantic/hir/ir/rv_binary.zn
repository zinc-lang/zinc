use ::self::frontend::syntax::ast::{SyntaxNode, ExpressionNode};
use ::self::frontend::syntax::ast::expr::*;
use ::self::frontend::syntax::token::*;

use super::*;

impl BinaryExprValue {
    fn new(e: *BinaryExpr, lhs: *RValue, rhs: *RValue) -> *Self {
        let span = e.span();
        let op = e.op;
        return box {
            .expr = move e as *ExpressionNode,
            .parent_node = None,
            .lhs = move lhs,
            .rhs = move rhs,
            .op = move op,
            .sty = SType::sty_invalid(span),
        }: BinaryExprValue;
    }

    fn create(e: *ExpressionNode, lhs: *RValue, rhs: *RValue, op: PunctuationKind) -> *Self {
        let span = e.span();
        let token = {
            .source_span = span,
            .token_kind = TokenKind::Punctuation(op),
        }: Token;
        return box {
            .expr = move e,
            .parent_node = None,
            .lhs = move lhs,
            .rhs = move rhs,
            .op = token,
            .sty = SType::sty_invalid(span),
        }: BinaryExprValue;
    }
}

impl XValue for BinaryExprValue {
    fn expr_node(&self) -> *ExpressionNode {
        return self.expr as *ExpressionNode;
    }

    fn parent_scope(&self) -> Option<*ScopeSymbol> {
        return self.parent_node;
    }

    fn set_parent_scope(&mut self, ss: *ScopeSymbol) {
        self.parent_node = Some(move ss);
    }

    fn get_stype(&self) -> *SType {
        return self.sty;
    }

    fn set_stype(&mut self, sty: *SType) {
        self.sty = move sty;
    }

    fn dump(&self) {
        self.lhs.dump();
        if self.op.token_kind is TokenKind::Punctuation(pk) {
            print(pk);
        }
        self.rhs.dump();
    }
}

impl RValue for BinaryExprValue {

}
