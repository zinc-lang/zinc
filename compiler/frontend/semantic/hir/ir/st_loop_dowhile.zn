use super::*;
use ::self::frontend::syntax::ast::*;
use ::self::frontend::syntax::ast::stmt::*;
use ::self::frontend::source_code::*;

impl DoWhileLoopSentence {
    pub fn new(stmt: *DoWhileStmt,
                cond: *RValue,
                body: *BlockSentence,) -> *Self {
        return box {
            .stmt = move stmt,
            .parent_stmt = None,
            .cond = move cond,
            .body = move body,
        }: DoWhileLoopSentence;
    }
}

impl Sentence for DoWhileLoopSentence {
    fn stmt_node(&self) -> *StatementNode {
        return self.stmt as *StatementNode;
    }

    fn parent_scope(&self) -> Option<*ScopeSymbol> {
        return self.parent_stmt;
    }

    fn set_parent_scope(&mut self, ss: *ScopeSymbol) {
        self.parent_stmt = Some(ss);
    }
}

impl LoopSentence for DoWhileLoopSentence {
    fn loop_body(&self) -> *BlockSentence {
        return self.body;
    }
}