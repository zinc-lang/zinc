    node: *WeakPatternNode,
    inner: *Pattern,
    matches_with: Option<*RValue>,
}

pub struct DerefPattern {
    node: *DerefPatternNode,
    inner: *Pattern,
    matches_with: Option<*RValue>,
}

pub struct MutPattern {
    node: *MutPatternNode,
    inner: *Pattern,
    matches_with: Option<*RValue>,
}

pub struct FieldPattern {
    node: *FieldPatternNode,
    inner: *Pattern,
    struct_pat: *StructPattern,
    matches_with: Option<*RValue>,
}

pub struct StructPattern {
    node: *StructPatternNode,
    struct_sty: Option<*SType>,
    fields: Vec<*FieldPattern>,
    rest: Option<*RestPattern>,
    matches_with: Option<*RValue>,
}

pub struct TuplePattern {
    node: *TuplePatternNode,
    tuple_sty: Option<*SType>,
    elements: Vec<*Pattern>,
    matches_with: Option<*RValue>,
}

pub struct EnumVariantPattern {
    node: *PatternNode,
    enum_ctor_sym: *EnumVariantSymbol,
    elements: Vec<*Pattern>,
    matches_with: Option<*RValue>,
    payload: Option<*VariantPayloadValue>,
}

// syntax 中的 TypeNode 对应 hir 中的 SType

