    node: *WildcardPatternNode,
    matches_with: Option<*RValue>,
}

pub struct RestPattern {
    node: *RestPatternNode,
    matches_with: Option<*RValue>,
}

pub struct RefPattern {
    node: *RefPatternNode,
    inner: *Pattern,
    matches_with: Option<*RValue>,
}

