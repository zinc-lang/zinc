// syntax 中的 expression 对应 hir 中的 xvalue

pub trait XValue {
    virtual fn expr_node(&self) -> *ExpressionNode;
    virtual fn parent_scope(&self) -> Option<*ScopeSymbol>;
    virtual fn set_parent_scope(&mut self, ss: *ScopeSymbol);
    virtual fn get_stype(&self) -> *SType;
    virtual fn set_stype(&mut self, sty: *SType);
    virtual fn dump(&self);
}

pub trait LValue: XValue {}

pub struct IndexLValue {
    expr: *ExpressionNode,
    parent_node: Option<*ScopeSymbol>,
    base: *XValue,
    index: *RValue,
    sty: *SType,
}

pub struct FieldLValue {
    expr: *ExpressionNode,
    parent_node: Option<*ScopeSymbol>,
    base: *XValue,
    field: Token,
    field_resolved: Option<*VarSymbol>,
    sty: *SType,
}

pub struct TupleAccessLValue {
    expr: *ExpressionNode,
    parent_node: Option<*ScopeSymbol>,
    base: *XValue,
    index: UInt,
    sty: *SType,
}

pub struct DerefLValue {
    expr: *ExpressionNode,
    parent_node: Option<*ScopeSymbol>,
    operand: *XValue,
    desugared_method: Option<*MethodCallValue>,
    sty: *SType,
}

pub struct LocalVar {
    expr: *ExpressionNode,
    parent_node: Option<*ScopeSymbol>,
    sym_var: *VarSymbol,
}

pub struct StaticVar {
    expr: *ExpressionNode,
    parent_node: Option<*ScopeSymbol>,
    sym_var: *VarSymbol,
}

pub trait RValue: XValue {}

