// syntax 中的 statement 对应 hir 中的 sentence

pub trait Sentence {
    virtual fn stmt_node(&self) -> *StatementNode;
    virtual fn parent_scope(&self) -> Option<*ScopeSymbol>;
    virtual fn set_parent_scope(&mut self, ss: *ScopeSymbol);
}

pub struct EmptySentence {
    stmt: *StatementNode,
    parent_stmt: Option<*ScopeSymbol>,
}

pub struct ExprSentence {
    stmt: *StatementNode,
    expr: *RValue,
    parent_stmt: Option<*ScopeSymbol>,
}

pub struct LetSentence { // 如果一条 let 语句绑定了多个变量, 那么翻译成多条 LetSentence
    stmt: *LetStmt,
    parent_stmt: Option<*ScopeSymbol>,
    local:*LocalVar,
    init: *RValue,
}

pub struct CallCopyFnSentence { // 这一条基本是编译器隐式插入的
    place: *LValue,
}

pub struct BlockSentence { // 这个类型同时实现 ScopeSymbol 以及 Sentence
    stmt: *StatementNode,
    parent_stmt: Option<*ScopeSymbol>,
    sentences: Vec<*Sentence>,
    symbol_table: SymbolTable,
    local_vars: Vec<*VarSymbol>,
    inner_items: Vec<*Symbol>,
}

pub trait LoopSentence: Sentence {
    virtual fn loop_body(&self) -> *BlockSentence;
}

pub struct ForLoopSentence {
    stmt: *ForStmt,
    parent_stmt: Option<*ScopeSymbol>,
    iterable: *RValue,
    pattern: *Pattern,
    body: *BlockSentence,
    iterator: *IteratorValue,
    iter_next: *IteratorNextValue,
    iter_item: *IteratorItemValue,
}

pub struct WhileLoopSentence {
    stmt: *WhileStmt,
    parent_stmt: Option<*ScopeSymbol>,
    cond: *RValue,
    body: *BlockSentence,
}

pub struct DoWhileLoopSentence {
    stmt: *DoWhileStmt,
    parent_stmt: Option<*ScopeSymbol>,
    cond: *RValue,
    body: *BlockSentence,
}

pub struct BranchBreak {
    stmt: *BreakStmt,
    parent_stmt: Option<*ScopeSymbol>,
    target: *LoopSentence,
}

pub struct BranchContinue {
    stmt: *ContinueStmt,
    parent_stmt: Option<*ScopeSymbol>,
    target: *LoopSentence,
}

pub struct BranchReturn {
    stmt: *ReturnStmt,
    parent_stmt: Option<*ScopeSymbol>,
    value: Option<*RValue>,
}

pub struct BranchPanic {
    stmt: *PanicStmt,
    parent_stmt: Option<*ScopeSymbol>,
