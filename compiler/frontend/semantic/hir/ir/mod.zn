// 这个文件包含所有数据结构的定义，它们的成员函数一律写在对应的子模块中

// syntax 中的 decl 对应 hir 中的 symbol

pub trait Symbol {
    virtual fn syntax_node(&self) -> *SyntaxNode;

    virtual fn short_name(&self) -> String;
    virtual fn mangle_name(&self) -> String;
    virtual fn export_key(&self) -> String;
    virtual fn export_value(&self) -> String;

    virtual fn parent_scope(&self) -> Option<*ScopeSymbol>;
    virtual fn set_parent_scope(&mut self, ss: *ScopeSymbol);

    virtual fn visibility(&self) -> Option<Qualifier>; // 返回 pub qualifier
}

pub trait ScopeSymbol : Symbol {
    virtual fn sym_table(&mut self) -> &mut SymbolTable;
}

pub struct SymbolTable {
    symbols: HashMap<String, *Symbol>,
    named_use_symbol: HashMap<String, *Symbol>,
    star_use_symbol: HashMap<String, *Symbol>,
}

pub trait TypeSymbol : Symbol {
    virtual fn to_string_with_args(&self, args: &GenericArgs) -> String;
    virtual fn related_impls(&self) -> Vec<*ImplSymbol>;
    virtual fn to_sty(*self, args: GenericArgs) -> *SType;
    virtual fn to_sty(*self) -> *SType;
}

fn is_builtin_type_symbol(sym: *TypeSymbol) -> Bool {
    if sym is type *TupleSymbol || sym is type *ArraySymbol || sym is type *FnLowerTypeSymbol ||
        sym is type *FnUpperTypeSymbol || sym is type *FnUpperMutTypeSymbol ||
        sym is type *BoolSymbol || sym is type *CharSymbol || sym is type *IntegerSymbol ||
        sym is type *FloatSymbol || sym is type *PointerLikeSymbol {
        return true;
    } else {
        return false;
    }
}

// 描述语义类型 semantic type
pub struct SType {
    type_symbol: *TypeSymbol,
    args: GenericArgs,
}

pub struct ModSymbol {
    mod_node: *ModDecl,
    parent_sym: Option<*ScopeSymbol>,
    is_imported: Bool,
    symbol_table: SymbolTable,
}

pub struct GenericParams {
    lt_params: Vec<*LifetimeSymbol>,
    ty_params: Vec<*TypeParamSymbol>,
    constraints: GenericConstraints,
}

pub struct GenericArgs {
    lt_args: Vec<Lifetime>,
    ty_args: Vec<*SType>,
}

pub struct ImplSymbol {
    impl_node: *ImplDecl,
    parent_sym: Option<*ScopeSymbol>,
    generics: GenericParams,
    self_ty: *AssociatedTypeSymbol, // todo 这个是不是换成 TypeAliasSymbol 更合适？
    target_sty: *SType,
    trait_sty: Option<*SType>,
    associated_types: HashMap<String, *TypeAliasSymbol>,
    reuse_sym: Option<*ReuseSymbol>,
    methods: Vec<*FuncSymbol>,
    symbol_table: SymbolTable,
}

pub struct TypeAliasSymbol {
    type_alias_node: Option<*TypeAliasDecl>,
    dummy_node: Option<*DummySyntaxNode>, // 用于描述 Self 类型
    parent_sym: Option<*ScopeSymbol>,
    generics: GenericParams,
    target_sty: *SType,
    symbol_table: SymbolTable,
    cache: HashMap<GenericArgs, *SType>,
}

