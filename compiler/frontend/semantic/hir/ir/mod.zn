// syntax 中的 PatternNode 对应 hir 中的 Pattern

pub trait Pattern {
    virtual fn pattern_node(&self) -> *PatternNode;
    virtual fn destructure(&mut self, expr: *RValue, is_refutable: Bool);
    virtual fn collect_all_bindings(&self) -> Vec<*VarSymbol>;
    virtual fn type_check(&mut self, ctx: &mut TypeCheckContext);
}

pub struct InvalidPattern {
    node: *PatternNode,
}

pub struct LiteralPattern {
    node: *LiteralPatternNode,
    matches_with: Option<*RValue>,
    stype: *SType,
}

pub struct VarBindingPattern {
    node: *IdentPatternNode,
    pat_sty: Option<*SType>,
    var_sym: *VarSymbol,
    matches_with: Option<*RValue>,
}

pub struct ConstPattern {
    node: *PatternNode,
    constant: *Symbol,
    matches_with: Option<*RValue>,
}

