use ::self::frontend::syntax::ast::{SyntaxNode, ExpressionNode, DummySyntaxNode};
use ::self::frontend::syntax::ast::expr::*;
use ::self::frontend::source_code::*;
use super::*;

impl DerefRValue {
    fn new(e: *UnaryExpr, operand: *RValue) -> *Self {
        if !(e.kind is UnaryExprKind::Deref) {
            panic "BUG: DerefRValue can only be created from a dereference unary expression";
        }
        return box {
            .expr = e as *ExpressionNode,
            .parent_node = None,
            .operand = move operand,
            .desugared_method = (type Option<*MethodCallValue>)::None,
            .sty = SType::sty_invalid(e.span()),
        }: DerefRValue;
    }

    fn create(span: SourceSpan, operand: *RValue) -> *Self {
        let dummy = box {
            .source_span = span,
        }: DummySyntaxNode;

        let sty = operand.get_stype();
        if !(sty.type_symbol is type *PointerLikeSymbol) {
            let sty_str = sty.to_string();
            let msg = f"BUG: deref of $(sty_str)";
            panic msg.as_str().deref();
        }

        return box {
            .expr = dummy as *ExpressionNode,
            .parent_node = None,
            .operand = move operand,
            .desugared_method = (type Option<*MethodCallValue>)::None,
            .sty = sty.args.ty_arg(0),
        }: DerefRValue;
    }
}

impl XValue for DerefRValue {
    fn expr_node(&self) -> *ExpressionNode {
        return self.expr as *ExpressionNode;
    }

    fn parent_scope(&self) -> Option<*ScopeSymbol> {
        return self.parent_node;
    }

    fn set_parent_scope(&mut self, ss: *ScopeSymbol) {
        self.parent_node = Some(move ss);
    }

    fn get_stype(&self) -> *SType {
        return self.sty;
    }

    fn set_stype(&mut self, sty: *SType) {
        self.sty = move sty;
    }
    fn dump(&self) {
        print("*");
        self.operand.dump();
    }
}

impl RValue for DerefRValue {

}
