use super::*;
use ::self::frontend::syntax::ast::*;
use ::self::frontend::syntax::ast::decl::*;
use ::self::frontend::source_code::*;

impl ImplSymbol {
    pub fn new(node: *ImplDecl) -> *Self {
        let self_ty = AssociatedTypeSymbol::self_ty_in_impl(node);
        let span = node.span();
        let sym = box {
            .impl_node = move node,
            .parent_sym = None,
            .generics = GenericParams::new(),
            .symbol_table = SymbolTable::new(),
            .self_ty = self_ty,
            .target_sty = InvalidSymbol::new(span).to_sty(),
            .trait_sty = None,
            .associated_types = (type HashMap<String, *TypeAliasSymbol>)::new(),
            .reuse_sym = None,
            .methods = (type Vec<*FuncSymbol>)::new(),
        }: ImplSymbol;
        self_ty.parent_sym = Some(sym as *ScopeSymbol);
        return sym;
    }

    pub fn find_method(&self, method: String, arg_count: UInt) -> Option<*FuncSymbol> {
        for m in self.methods {
            if m.short_name().eq(&method) &&
                m.accept_params(arg_count) {
                return Some(move m);
            }
        }
        if self.trait_sty is Some(trait_sty) {
            if trait_sty.type_symbol is trait_sym: *TraitSymbol {
                for m in trait_sym.methods {
                    if m.short_name().eq(&method) &&
                        m.accept_params(arg_count) {
                        return Some(move m);
                    }
                }
            }
        }

        return None;
    }

    // 只在 impl 自己写的方法里查找, 不会回退到 trait 里的声明.
    // 检查"impl 有没有真的实现 trait 的方法"时必须用它: find_method 会回退到
    // trait 的方法 (这是为了拿到默认实现), 于是分不清"实现了"和"根本没写".
    pub fn find_own_method(&self, method: String, arg_count: UInt) -> Option<*FuncSymbol> {
        for m in self.methods {
            if m.short_name().eq(&method) &&
                m.accept_params(arg_count) {
                return Some(move m);
            }
        }
        return None;
    }

    pub fn collect_methods_table(&self) -> Vec<*FuncSymbol> {

        let mut res: Vec<*FuncSymbol> = (type Vec<*FuncSymbol>)::new();
        if self.trait_sty is Some(trait_sty) {
            if trait_sty.type_symbol is trait_sym: *TraitSymbol {
                let trait_methods = trait_sym.methods_of_total();
                for f in trait_methods {
                    let o = self.override_method_of(f, );
                    res.push(move o);
                }
            }
        }
        return res;
    }

    // 与 collect_methods_table 顺序完全一致, 但把"trait 里的声明"也带出来:
    // 元素是 (trait 声明的方法, impl 里真正实现它的方法)。codegen 需要前者
    // (调用点的 ABI 取自 trait 声明) 来判断 vtable 条目要不要加适配 thunk。
    pub fn collect_methods_table_with_decls(&self) -> Vec<(*FuncSymbol, *FuncSymbol)> {

        let mut res: Vec<(*FuncSymbol, *FuncSymbol)> = (type Vec<(*FuncSymbol, *FuncSymbol)>)::new();
        if self.trait_sty is Some(trait_sty) {
            if trait_sty.type_symbol is trait_sym: *TraitSymbol {
                let trait_methods = trait_sym.methods_of_total();
                for f in trait_methods {
                    let o = self.override_method_of(f, );
                    res.push((move f, move o));
                }
            }
        }
        return res;
    }

    pub fn override_method_of(&self, f: *FuncSymbol) -> *FuncSymbol {
        if f.parent_sym is Some(trsym: *TraitSymbol) {
            for isym in self.target_sty.type_symbol.related_impls() {
                if isym.trait_sty is Some(tr) && tr.type_symbol is trsym2: *TraitSymbol {
                    if trsym as *raw TraitSymbol as UInt == trsym2 as *raw TraitSymbol as UInt {
                        let found = isym.find_method(f.short_name(), f.params.len());
                        if found is Some(o) {
                            return o;
                        } else if f.body is Some(_) {
                            return f;
                        } else {
                            panic;
                        }
                    }
                }
            }
        }
        panic;
    }
}

fn impl_sig_text(node: *ImplDecl) -> String {
    let mut res = String::new();
    if node.trait_ty is Some(tt) {
        let t = SourceManager::get().source_piece_of(tt.span());
        res.push_str(t.as_str().deref());
    } else {
        res.push_str("<inherent>");
    }
    res.push_str(" for ");
    let ty = SourceManager::get().source_piece_of(node.target_ty.span());
    res.push_str(ty.as_str().deref());
    return res;
}

// 在同一个父语法节点下, 声明顺序位于 node 之前且签名文本相同的 impl 个数.
// 纯语法计算, 幂等: 同一个声明在任何时刻都得到同一个序号.
fn impl_sig_rank(node: *ImplDecl, parent_node: *SyntaxNode) -> UInt {
    let span = node.span();
    let sig = impl_sig_text(node);
    let mut n: UInt = 0;
    for ch in parent_node.children() {
        if ch is other: *ImplDecl {
            if other as *raw ImplDecl as UInt != node as *raw ImplDecl as UInt &&
                other.span().start.offset < span.start.offset &&
                impl_sig_text(other).eq(&sig) {
                n += 1;
            }
        }
    }
    return n;
}

impl Symbol for ImplSymbol {
    fn syntax_node(&self) -> *SyntaxNode {
        return self.impl_node as *SyntaxNode;
    }

    // short_name 只当作 SymbolTable 的 key 用 (impl 不按名字查找, 见
    // SymbolTable::add_child 的注释), 这个值也不会导出到 zno 里面去。
    //
    // 历史上这里用过"对象地址串"(随 ASLR 漂移)和"文件路径 + 起始字节偏移"(对注释/
    // 空白过敏). 现在改成**语义稳定键**:
    //   - 与偏移/行号/注释/空白无关: 只取语法结构 (文件路径 + trait/目标类型语法文本
    //     + 同父同签名的声明序号), 不取任何 raw 文本偏移;
    //   - 跨运行稳定: 不含地址, 不含 HashMap 迭代序, 不含时间;
    //   - 进程内唯一: 同文件同签名按声明序号区分, 不同文件路径不同, 因此不会互相
    //     误报冲突 (真冲突时 add_child 依旧按重名报错, 不会静默合并);
    //   - round1 阶段就可用: 只读 AST 语法, 不依赖 export_key/mangle_name —— round1
    //     建符号时 target_sty/trait_sty 还是 Invalid, 用它们会让所有 impl 撞成同一个 key.
    fn short_name(&self) -> String {
        let span = self.impl_node.span();
        let mut res = SourceManager::get().file_path_of(span.start.file_id);
        res.push_str("@");
        res.push_str(impl_sig_text(self.impl_node).as_str().deref());
        res.push_str("#");
        let mut rank: UInt = 0;
        if self.parent_sym is Some(psym) {
            rank = impl_sig_rank(self.impl_node, psym.syntax_node());
        }
        let rank_str = rank.to_string();
        res.push_str(rank_str.as_str().deref());
        return res;
    }

    fn mangle_name(&self) -> String {
        return self.export_key();
    }

    fn export_key(&self) -> String {
        let mut res = self.target_sty.type_symbol.export_key();
        if self.trait_sty is Some(ty) {
            res.push_str("#");
            res.push_str(ty.type_symbol.export_key().as_str().deref());
        }
        return res;
    }

    fn export_value(&self) -> String {
        let mut res = String::new();
        self.impl_node.qualifiers().to_string_inplace(&mut res);

        res.push_str(" impl ");
        res.push_str(self.generics.export_value().as_str().deref());
        res.push_str(" ");
        if self.trait_sty is Some(trait_sty) {
            if !self.impl_node.bang.is_invalid() {
                res.push_str("!");
            }
            res.push_str(trait_sty.to_string().as_str().deref());
            res.push_str(" for ");
        }
        res.push_str(self.target_sty.to_string().as_str().deref());

        let where_conds = self.generics.export_constraints();
        res.push_str(where_conds.as_str().deref());

        res.push_str(" {\n");
        for kv in self.associated_types {
            let s = kv.1.export_value();
            res.push_str(s.as_str().deref());
            res.push_str("\n");
        }
        for f in self.methods {
            if f.should_export() {
                res.push_str(f.export_value().as_str().deref());
                res.push_str("\n");
            }
        }
        res.push_str("}\n");
        return res;
    }

    fn parent_scope(&self) -> Option<*ScopeSymbol> {
        return self.parent_sym;
    }

    fn set_parent_scope(&mut self, ss: *ScopeSymbol) {
        self.parent_sym = Some(ss);
    }

    fn visibility(&self) -> Option<Qualifier> {
        return None;
    }
}

impl ScopeSymbol for ImplSymbol {
    fn sym_table(&mut self) -> &mut SymbolTable {
        return &mut self.symbol_table;
    }
}