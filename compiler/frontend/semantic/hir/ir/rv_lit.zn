use ::self::frontend::syntax::ast::{SyntaxNode, ExpressionNode};
use ::self::frontend::syntax::ast::expr::*;
use ::self::frontend::source_code::SourceSpan;
use super::*;

impl LiteralValue {
    fn new(e: *LiteralExpr) -> *Self {
        let span = e.span();
        return box {
            .expr = move e,
            .parent_node = None,
            .sty = SType::sty_invalid(span),
            .negated = false,
            .folded_span = None,
        }: LiteralValue;
    }

    // 诊断用的位置: 一元负号折叠出来的字面量用外层表达式 (含 `-`) 的 span,
    // 其它情况用数字 token 自己的 span。
    fn diag_span(&self) -> SourceSpan {
        if self.folded_span is Some(s) {
            return s;
        }
        return self.expr.span();
    }
}

impl XValue for LiteralValue {
    fn expr_node(&self) -> *ExpressionNode {
        return self.expr as *ExpressionNode;
    }

    fn parent_scope(&self) -> Option<*ScopeSymbol> {
        return self.parent_node;
    }

    fn set_parent_scope(&mut self, ss: *ScopeSymbol) {
        self.parent_node = Some(move ss);
    }

    fn get_stype(&self) -> *SType {
        return self.sty;
    }

    fn set_stype(&mut self, sty: *SType) {
        self.sty = move sty;
    }

    fn dump(&self) {
        
    }
}

impl RValue for LiteralValue {

}
