    }

    fn dump(&self) {
    }
}

impl RValue for IteratorNextValue {

}

impl IteratorItemValue {
    fn new(iter_next: *IteratorNextValue) -> *Self {
        let span = iter_next.expr_node().span();
        return box {
            .iter_next = move iter_next,
            .desugared_pmv = None,
            .desugared_payload = None,
            .sty = SType::sty_invalid(span),
        }: IteratorItemValue;
    }
}

impl XValue for IteratorItemValue {
    fn expr_node(&self) -> *ExpressionNode {
        return self.iter_next.expr_node();
