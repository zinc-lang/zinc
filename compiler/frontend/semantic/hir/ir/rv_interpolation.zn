use ::self::frontend::syntax::ast::{SyntaxNode, ExpressionNode};
use ::self::frontend::syntax::ast::expr::*;
use ::self::frontend::syntax::token::*;
use ::self::frontend::semantic::hir::checker::TypeCheckContext;
use ::self::frontend::semantic::hir::checker::type_mapping::*;
use ::self::frontend::semantic::hir::checker::type_utils::*;
use ::self::frontend::semantic::hir::checker::type_cast::*;
use ::self::frontend::semantic::hir::builder::resolver::*;
use ::self::frontend::diagnostic::*;
use ::self::frontend::source_code::*;

use super::*;

// 字符串插值 f"..." 的语义表示:
//   parts 由若干文本段 (Str) 和内嵌表达式段 (Expr) 组成。
//   分段/转义/子表达式的语法解析在 parser 里做 (见 FileParser::parse_interpolation_expr),
//   这里只负责类型检查, MIR 阶段再解糖成 "构造 String + 依次 to_string_inplace"。
impl InterpolationValue {
    fn new(e: *ExpressionNode, sty: *SType) -> *Self {
        return box {
            .expr = e,
            .parent_node = None,
            .parts = (type Vec<InterpolationPart>)::new(),
            .checked = false,
            .sty = move sty,
        }: InterpolationValue;
    }

    // 每个内嵌表达式都要推一遍类型, 并且它的类型必须实现了 ToString
    fn type_check(&mut self, ctx: &mut TypeCheckContext) {
        if self.checked {
            return;
        }
        self.checked = true;

        for ref part in self.parts {
            if part is InterpolationPart::Expr(rv) {
                let sty = ctx.infer(rv as *XValue);
                ensure_can_tostring(sty, rv.expr_node().span());
            }
        }
    }
}

// 能插值的类型必须实现了 ::std::primitives::string::ToString
fn ensure_can_tostring(sty: *SType, span: SourceSpan) {
    if !ensure_type_valid(sty, span) {
        return;
    }
    let stripped = strip_pointer_except_weak(sty);
    for i in stripped.type_symbol.related_impls() {
        if i.trait_sty is Some(trait_sty) {
            let key = trait_sty.type_symbol.export_key();
            if key.as_str().deref().eq(&"::std::primitives::string::ToString") {
                return;
            }
        }
    }

    DiagnosticEngine::get().emit_not_tostring(stripped.to_string(), span);
}

impl XValue for InterpolationValue {
    fn expr_node(&self) -> *ExpressionNode {
        return self.expr;
    }

    fn parent_scope(&self) -> Option<*ScopeSymbol> {
        return self.parent_node;
    }

    fn set_parent_scope(&mut self, ss: *ScopeSymbol) {
        self.parent_node = Some(move ss);
    }

    fn get_stype(&self) -> *SType {
        return self.sty;
    }

    fn set_stype(&mut self, sty: *SType) {
        // 检查 sty 是 String 类型
    }

    fn dump(&self) {
        print("f\"...\"");
    }
}

impl RValue for InterpolationValue {

}
