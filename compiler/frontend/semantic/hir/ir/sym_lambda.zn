use super::*;
use ::self::frontend::syntax::ast::*;
use ::self::frontend::syntax::ast::expr::*;
use ::self::frontend::syntax::token::*;
use ::self::frontend::source_code::*;

impl LambdaCapture {
    // 根据外层变量的类型和捕获模式计算闭包内部绑定的类型。
    // builder 阶段外层变量的类型常常还未知, 此时返回 invalid,
    // 由类型检查阶段 (check_lambda_body) 再算一次。
    pub fn local_sty(&self) -> *SType {
        let outer_sty = self.outer_var.stype;
        if self.mode is LambdaCaptureKind::Value {
            return outer_sty;
        }
        if outer_sty.is_invalid() {
            return SType::sty_invalid(self.token.span());
        }
        if self.mode is LambdaCaptureKind::Ref {
            return BorrowImmutSymbol::new().to_sty(GenericArgs::from1(outer_sty));
        }
        if self.mode is LambdaCaptureKind::RefMut {
            return BorrowMutSymbol::new().to_sty(GenericArgs::from1(outer_sty));
        }
        // weak 捕获要求外层变量是 Arc
        if outer_sty.type_symbol is type *ArcPointerSymbol {
            return WeakPointerSymbol::new().to_sty(GenericArgs::from1(outer_sty.args.ty_arg(0)));
        }
        return SType::sty_invalid(self.token.span());
    }

    // 创建捕获项, 并给闭包内部的绑定定好类型 (外层类型已知时)
    pub fn create(mode: LambdaCaptureKind, is_explicit: Bool, token: Token, outer: *VarSymbol, local: *VarSymbol) -> *Self {
        let capture = box {
            .mode = mode,
            .is_explicit = is_explicit,
            .token = token,
            .outer_var = move outer,
            .local_var = move local,
        }: LambdaCapture;
        capture.local_var.stype = capture.local_sty();
        return capture;
    }
}

impl LambdaSymbol {
    pub fn new(node: *LambdaExpr) -> *Self {
        let sym = box {
            .lambda_node = move node,
            .parent_sym = None,
            .generics = GenericParams::new(),
            .params = (type Vec<*VarSymbol>)::new(),
            .captures = (type Vec<*LambdaCapture>)::new(),
            .symbol_table = SymbolTable::new(),
            .return_sty = None,
            .body_block = None,
            .body_expr = None,
            .cache = (type HashMap<GenericArgs, *SType>)::new(),
        }: LambdaSymbol;
        return sym;
    }

    pub fn qualifiers(&self) -> QualifierList {
        return self.lambda_node.qualifier_list;
    }

    pub fn params_tys(&self) -> Vec<*SType> {
        let mut tys = (type Vec<*SType>)::new();
        for p in self.params {
            tys.push(p.stype);
        }
        return tys;
    }

    // todo: 考虑带有参数默认值的情况
    pub fn accept_params(&self, c: UInt) -> Bool {
        return self.params.len() == c;
    }

    pub fn has_captures(&self) -> Bool {
        return self.captures.len() > 0;
    }

    // 显式捕获在闭包体内按名字可见, 需要把内部绑定注册进闭包的作用域
    pub fn add_capture(&mut self, capture: *LambdaCapture) {
        let local = capture.local_var;
        self.captures.push(capture);
        self.symbol_table.add_child(local as *Symbol);
    }

    pub fn find_capture(&self, name: &String) -> Option<*LambdaCapture> {
        for c in self.captures {
            if c.local_var.short_name().eq(name) {
                return Some(move c);
            }
        }
        return None;
    }

    // 查找捕获了指定外层变量的捕获项
    pub fn find_capture_of(&self, outer: *VarSymbol) -> Option<*LambdaCapture> {
        for c in self.captures {
            if c.outer_var as *raw VarSymbol as UInt == outer as *raw VarSymbol as UInt {
                return Some(move c);
            }
        }
        return None;
    }

    // 闭包是匿名的, 用字面量所在位置生成一个唯一名字, 供 name mangling 使用
    pub fn unique_key(&self) -> String {
        let span = self.lambda_node.span();
        let mut res = String::new();
        res.push_str("<lambda>@");
        res.push_str(span.start.file_id.to_string().as_str().deref());
        res.push_str(":");
        res.push_str(span.start.offset.to_string().as_str().deref());
        return res;
    }

    // 闭包能访问到的泛型参数: 外层作用域链上的 + 自己的
    pub fn type_params_in_ctx(&self) -> Vec<*TypeParamSymbol> {
        let mut all = (type Vec<*TypeParamSymbol>)::new();

        let mut cur: Option<*ScopeSymbol> = self.parent_sym;
        while cur is Some(ss) {
            if ss is fs: *FuncSymbol {
                for p in fs.generics.ty_params {
                    all.push(move p);
                }
            }
            else if ss is ls: *LambdaSymbol {
                for p in ls.generics.ty_params {
                    all.push(move p);
                }
            }
            else if ss is isym: *ImplSymbol {
                for p in isym.generics.ty_params {
                    all.push(move p);
                }
                let origin = isym.target_sty.type_symbol.to_sty();
                for a in origin.args.ty_args {
                    if a.type_symbol is p: *TypeParamSymbol {
                        all.push(move p);
                    }
                }
            }
            else if ss is tsym: *TraitSymbol {
                for p in tsym.generics.ty_params {
                    all.push(move p);
                }
            }
            cur = ss.parent_scope();
        }

        for p in self.generics.ty_params {
            all.push(move p);
        }
        return all;
    }

    pub fn type_params_except(&self, excepts: &Vec<*TypeParamSymbol>) -> Vec<*TypeParamSymbol> {
        let all = self.type_params_in_ctx();
        if excepts.is_empty() {
            return all;
        }

        let mut res = (type Vec<*TypeParamSymbol>)::new();
        for t in all {
            let mut found = false;
            for e in excepts {
                if t as *raw TypeParamSymbol as UInt == e as *raw TypeParamSymbol as UInt {
                    found = true;
                    break;
                }
            }
            if !found {
                res.push(t);
            }
        }
        return res;
    }
}

impl Symbol for LambdaSymbol {
    fn syntax_node(&self) -> *SyntaxNode {
        return self.lambda_node as *SyntaxNode;
    }

    fn short_name(&self) -> String {
        return "<lambda>".to_string();
    }

    fn mangle_name(&self) -> String {
        if self.parent_sym is Some(ps) {
            let mut res = ps.export_key();
            res.push_str("::");
            res.push_str(self.unique_key().as_str().deref());
            return res;
        } else {
            return self.unique_key();
        }
    }

    fn export_key(&self) -> String {
        return self.mangle_name();
    }

    fn export_value(&self) -> String {
        let mut res = String::new();
        res.push_str("fn ");
        res.push_str(self.short_name().as_str().deref());
        res.push_str(self.generics.export_value().as_str().deref());
        res.push_str("(");

        let mut first = true;
        for p in self.params {
            if first {
                first = false;
            } else {
                res.push_str(", ");
            }
            res.push_str(p.short_name().as_str().deref());
            res.push_str(": ");
            res.push_str(p.stype.to_string().as_str().deref());
        }
        res.push_str(")");
        if self.return_sty is Some(rt) {
            res.push_str(" -> ");
            res.push_str(rt.export_value().as_str().deref());
        }

        let where_conds = self.generics.export_constraints();
        res.push_str(where_conds.as_str().deref());

        res.push_str(";");
        return res;
    }

    fn parent_scope(&self) -> Option<*ScopeSymbol> {
        return self.parent_sym;
    }

    fn set_parent_scope(&mut self, ss: *ScopeSymbol) {
        self.parent_sym = Some(ss);
    }

    fn visibility(&self) -> Option<Qualifier> {
        return self.lambda_node.qualifier_list.get(QualifierKind::Pub);
    }
}

impl TypeSymbol for LambdaSymbol {
    fn to_string_with_args(&self, args: &GenericArgs) -> String {
        let mut res = String::new();
        res.push_str(self.unique_key().as_str().deref());
        res.push_str(args.to_string().as_str().deref());
        return res;
    }
    fn related_impls(&self) -> Vec<*ImplSymbol> {
        return (type Vec<*ImplSymbol>)::new();
    }
    fn lifetime_count(&self) -> UInt {
        return self.generics.lt_params.len();
    }
    fn to_sty(*self, args: GenericArgs) -> *SType {
        if self.cache.at(&args) is Some(t) {
            return t;
        } else {
            let sty = box {
                .type_symbol = self as *TypeSymbol,
                .args = args,
            }: SType;
            self.cache.insert(move args, sty);
            return sty;
        }
    }
    fn to_sty(*self) -> *SType {
        let args = self.generics.to_generic_args();
        return self.to_sty(move args);
    }
}

impl ScopeSymbol for LambdaSymbol {
    fn sym_table(&mut self) -> &mut SymbolTable {
        return &mut self.symbol_table;
    }
}
