use super::*;
use ::self::frontend::syntax::ast::*;
use ::self::frontend::syntax::ast::decl::*;
use ::self::frontend::source_code::*;

// ARC pointer

unsafe static mut G_ARC_SYMBOL: Option<*ArcPointerSymbol> = None;

impl ArcPointerSymbol {
    pub fn new() -> *Self {
        unsafe {
            if G_ARC_SYMBOL is Some(s) {
                return s;
            } else {
                let mut generics = GenericParams::new();
                generics.ty_params.push(TypeParamSymbol::new());

                let sym = box {
                    .generics = move generics,
                    .cache = (type HashMap<GenericArgs, *SType>)::new(),
                }: ArcPointerSymbol;
                G_ARC_SYMBOL = Some(sym);
                return sym;
            }
        }
    }

}

impl Symbol for ArcPointerSymbol {
    fn syntax_node(&self) -> *SyntaxNode {
        let dummy = box {
            .source_span = SourceSpan::empty()
        }: DummySyntaxNode;
        return dummy as *SyntaxNode;
    }

    fn short_name(&self) -> String {
        return f"Arc";
    }
    fn mangle_name(&self) -> String {
        return self.short_name();
    }
    fn export_key(&self) -> String {
        return self.short_name();
    }
    fn export_value(&self) -> String {
        return self.short_name();
    }

    fn parent_scope(&self) -> Option<*ScopeSymbol> {
        return None;
    }

    fn set_parent_scope(&mut self, ss: *ScopeSymbol) {
        return;
    }

    fn visibility(&self) -> Option<Qualifier> {
        return None;
    }
}

impl TypeSymbol for ArcPointerSymbol {
    fn to_string_with_args(&self, args: &GenericArgs) -> String {
        if args.ty_args.len() != 1 {
            return f"Arc<?>";
        } else {
            let arg = *args.ty_args.index(0).deref();
            let arg_str = arg.to_string();
            return f"*$(arg_str)";
        }
    }
    fn related_impls(&self) -> Vec<*ImplSymbol> {
        return (type Vec<*ImplSymbol>)::new();
    }
    fn to_sty(*self, args: GenericArgs) -> *SType {
        if self.cache.at(&args) is Some(t) {
            return t;
        } else {
            let sty = box {
                .type_symbol = self as *TypeSymbol,
                .args = args,
            }: SType;
            self.cache.insert(move args, sty);
            return sty;
        }
    }
    fn to_sty(*self) -> *SType {
        let args = self.generics.to_generic_args();
        return self.to_sty(move args);
    }
}

impl PointerLikeSymbol for ArcPointerSymbol { }

