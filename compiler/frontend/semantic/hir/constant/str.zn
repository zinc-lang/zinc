use ::self::frontend::source_code::*;
use ::self::frontend::diagnostic::DiagnosticEngine;
use ::self::frontend::syntax::token::*;
use ::self::frontend::syntax::ast::*;
use ::self::frontend::semantic::hir::ir::*;

use super::*;

impl ConstValue for StringCValue {
    fn span(&self) -> SourceSpan {
        return self.token.source_span;
    }

    fn structural_eq(&self, other: &ConstValue) -> Bool {
        if other is o: &StringCValue {
            return self.value.eq(&o.value);
        } else {
            return false;
        }
    }

    fn to_string(&self) -> String {
        return self.value;
    }
}

impl StringCValue {
    fn new(t: Token) -> Self {
        if t.token_kind is TokenKind::Literal(LiteralKind::LIT_RAW_STR) {
            return StringCValue::from_raw(move t);
        }
        let mut tok_str = t.raw_str().as_str().deref();
        if t.token_kind is TokenKind::Literal(LiteralKind::LIT_CSTR) {
            if tok_str.starts_with("c") {
                tok_str = tok_str.sub_str(1);
            }
        }
        tok_str = trim_quotes(tok_str);

        let mut value = String::new();
        let len = tok_str.len();
        let mut i: UInt = 0;
        while i < len {
            let b = tok_str.index(i);
            if b == b'\\' {
                let second = tok_str.index(i+1);
                if second == b't' { value.push(b'\t'); }
                else if second == b'r' { value.push(b'\r'); }
                else if second == b'n' { value.push(b'\n'); }
                else if second == b'0' { value.push(0_u8); }
                else if second == b'\\' { value.push(b'\\'); }
                else if second == b'\'' { value.push(b'\''); }
                else if second == b'"' { value.push(b'"'); }
                else {
                    DiagnosticEngine::get().emit_invalid_escape(t.source_span);
                }
                i += 1;
            } else {
                value.push(b);
            }
            i += 1;
        }

        if t.token_kind is TokenKind::Literal(LiteralKind::LIT_CSTR) {
            value.push(0_u8);
        }

        return {
            .token = move t,
            .value = move value,
        }: StringCValue;
    }

    fn from_raw(t: Token) -> Self {
        let tok_str = t.raw_str().as_str().deref();
        let mut i: UInt = 0;
        if tok_str.len() > 0 && tok_str.index(0) == b'r' {
            i = 1;
        }
        let mut hashes: UInt = 0;
        while i < tok_str.len() && tok_str.index(i) == b'#' {
            hashes += 1;
            i += 1;
        }
        if i < tok_str.len() && tok_str.index(i) == 34 {
            i += 1;
        }
        let mut end = tok_str.len();
        if end >= 1 + hashes {
            end = end - (1 + hashes);
        }
        if i > end {
            i = end;
        }
        let inner = tok_str.sub_str(i, end - i);
        let mut value = String::new();
        let mut k: UInt = 0;
        while k < inner.len() {
            value.push(inner.index(k));
            k += 1;
        }
        return {
            .token = move t,
            .value = move value,
        }: StringCValue;
    }
}

// 去掉字符串首尾的双引号
fn trim_quotes<'a>(s: Str<'a>) -> Str<'a> {
    let mut start: UInt = 0;
    let mut end = s.len();
    if s.starts_with("\"") {
        start += 1;
        end -= 1;
    }
    if s.ends_with("\"") {
        end -= 1;
    }
    return s.sub_str(start, end);
}
