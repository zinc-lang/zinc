use ::self::frontend::source_code::*;
use ::self::frontend::diagnostic::DiagnosticEngine;
use ::self::frontend::syntax::token::*;
use ::self::frontend::syntax::ast::*;
use ::self::frontend::semantic::hir::ir::*;

use super::*;

impl ConstValue for IntegerCValue {
    fn span(&self) -> SourceSpan {
        return self.token.source_span;
    }

    fn structural_eq(&self, other: &ConstValue) -> Bool {
        if other is o: &IntegerCValue {
            return self.value == o.value;
        } else {
            return false;
        }
    }

    fn to_string(&self) -> String {
        return self.value.to_string();
    }
}

impl IntegerCValue {
    fn new(t: Token) -> Self {
        let mut tok_str = t.raw_str().as_str().deref();

        // 处理负号
        let mut sign = true;
        if tok_str.starts_with("-") {
            sign = false;
            tok_str = tok_str.sub_str(1);
        }

        // 先剥掉后缀并删除所有的下划线, 这个函数应该写到标准库里面。
        // 必须先剥后缀再判断进制前缀: 否则 `0_i` 的 `_i` 会被当成 "0 后面跟了非进制前缀"。
        let mut str = String::new();
        let mut suffix = String::new();
        {
            let len = tok_str.len();
            let mut i: UInt = 0;
            while i < len {
                let c = tok_str.index(i);
                if c == b'i' || c == b'u' {
                    // 后缀合法性在 lexer 里面已经判断过了
                    suffix = tok_str.sub_str(i).to_string();
                    break;
                }
                if c != b'_' {
                    str.push(c);
                }
                i += 1;
            }
        }

        // 处理进制前缀: 只认 0b/0B (二), 0o/0O (八), 0x/0X (十六)。
        // 单独的数字 0 是十进制; `010` 这种以 0 开头又没有进制前缀的写法没有明确含义,
        // 按非法前缀报错 (符合本文件原有的 emit_illegal_int_prefix 意图), 不再静默按十六进制算错。
        let mut numeral: UInt32 = 10;
        let mut digits: Str = str.as_str().deref();
        if digits.len() > 1 && digits.index(0) == b'0' {
            let second = digits.index(1);
            if second == b'b' || second == b'B' {
                numeral = 2;
                digits = digits.sub_str(2);
            } else if second == b'o' || second == b'O' {
                numeral = 8;
                digits = digits.sub_str(2);
            } else if second == b'x' || second == b'X' {
                numeral = 16;
                digits = digits.sub_str(2);
            } else {
                DiagnosticEngine::get().emit_illegal_int_prefix(t.source_span);
            }
        }

        // 解析整数部分
        let mut num: UInt64 = 0;
        {
            let len = digits.len();
            let mut i: UInt = 0;
            while i < len {
                let c = digits.index(i);
                if numeral == 2 {
                    if c != b'0' && c != b'1' {
                        DiagnosticEngine::get().emit_illegal_int_literal(t.source_span);
                        break;
                    }
                    let v = (c - b'0') as UInt64;
                    let temp_num = num * 2 + v;
                    if temp_num < num {
                        DiagnosticEngine::get().emit_int_literal_overflow(t.source_span);
                        break;
                    }
                    num = temp_num;
                }
                else if numeral == 8 {
                    if c < b'0' || c > b'7' {
                        DiagnosticEngine::get().emit_illegal_int_literal(t.source_span);
                        break;
                    }
                    let v = (c - b'0') as UInt64;
                    let temp_num = num * 8 + v;
                    if temp_num < num {
                        DiagnosticEngine::get().emit_int_literal_overflow(t.source_span);
                        break;
                    }
                    num = temp_num;
                }
                else if numeral == 10 {
                    if c < b'0' || c > b'9' {
                        DiagnosticEngine::get().emit_illegal_int_literal(t.source_span);
                        break;
                    }
                    let v = (c - b'0') as UInt64;
                    let temp_num = num * 10 + v;
                    if temp_num < num {
                        DiagnosticEngine::get().emit_int_literal_overflow(t.source_span);
                        break;
                    }
                    num = temp_num;
                }
                else if numeral == 16 {
                    let mut v: UInt64 = 0;
                    if c >= b'0' && c <= b'9' { v = (c - b'0') as UInt64; }
                    else if c >= b'a' && c <= b'f' { v = (c - b'a') as UInt64 + 10; }
                    else if c >= b'A' && c <= b'F' { v = (c - b'A') as UInt64 + 10; }
                    else {
                        DiagnosticEngine::get().emit_illegal_int_literal(t.source_span);
                        break;
                    }
                    let temp_num = num * 16 + v;
                    if temp_num < num {
                        DiagnosticEngine::get().emit_int_literal_overflow(t.source_span);
                        break;
                    }
                    num = temp_num;
                }
                else {
                    break;
                }
                i += 1;
            }
        }

        // 类型检查阶段判断数字范围是否溢出

        return {
            .token = move t,
            .sign = move sign,
            .value = move num,
            .suffix = move suffix,
        }: IntegerCValue;
    }

    fn stype_from_suffix(&self) -> *SType {
        let suffix = self.suffix.as_str().deref();

        if suffix.eq(&"i") {
            return IntegerSymbol::new(IntegerKind::Isize).to_sty();
        }
        else if suffix.eq(&"i8") {
            return IntegerSymbol::new(IntegerKind::I8).to_sty();
        }
        else if suffix.eq(&"i16") {
            return IntegerSymbol::new(IntegerKind::I16).to_sty();
        }
        else if suffix.eq(&"i32") {
            return IntegerSymbol::new(IntegerKind::I32).to_sty();
        }
        else if suffix.eq(&"i64") {
            return IntegerSymbol::new(IntegerKind::I64).to_sty();
        }
        else if suffix.eq(&"u") {
            return IntegerSymbol::new(IntegerKind::Usize).to_sty();
        }
        else if suffix.eq(&"u8") {
            return IntegerSymbol::new(IntegerKind::U8).to_sty();
        }
        else if suffix.eq(&"u16") {
            return IntegerSymbol::new(IntegerKind::U16).to_sty();
        }
        else if suffix.eq(&"u32") {
            return IntegerSymbol::new(IntegerKind::U32).to_sty();
        }
        else if suffix.eq(&"u64") {
            return IntegerSymbol::new(IntegerKind::U64).to_sty();
        }
        else {
            return SType::sty_invalid(self.token.source_span);
        }
    }
}
