// reverse (独占分支) 不应泄漏元素引用: 3 个元素反转后每个元素 rc 仍为 1。
// 回归: 独占分支曾经用 `tmp = *head` (多 retain 一次) + forget(tmp) 做交换,
// 没有配对的 release, 反转后每个元素 rc == 2 (泄漏)。
use std::{assert, assert_eq};

fn mk(x: Int) -> Vec<Int> {
    let mut v = (type Vec<Int>)::new();
    v.push(x);
    return v;
}

fn rc_of(v: &Vec<Vec<Int>>, i: UInt) -> UInt {
    let p = unsafe(v.get_unchecked(i));
    return p.ref_count() as UInt;
}

fn main() {
    let mut v = (type Vec<Vec<Int>>)::new();
    v.push(mk(1_i));
    v.push(mk(2_i));
    v.push(mk(3_i));
    v.reverse();
    // 先检查引用计数: 注意 at() 返回的 Option 临时量在当前编译器上不会被析构,
    // 若先做内容断言会额外占住一个强引用, 影响后面的 rc 观察。
    let mut j: UInt = 0_u;
    while j < 3_u {
        assert_eq(rc_of(&v, j), 1_u);
        j += 1_u;
    }
    // 1 2 3 -> 3 2 1
    assert_eq(v.at(0_u).get_or_panic().at(0_u).get_or_panic(), 3_i);
    assert_eq(v.at(2_u).get_or_panic().at(0_u).get_or_panic(), 1_i);
}
