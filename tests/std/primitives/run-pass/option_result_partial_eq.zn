// Option<T> / Result<T,E> 的 PartialEq / Eq / Hash。
//
// Option/Result 都是泛型类型定义, 它们的 impl 只有在运行期实例化的时候被登记进
// TypeMeta.impls, 才能被 `T: PartialEq` 约束下的方法调用查到。assert_eq/assert_ne
// 走的正是这条运行期派发路径 (泛型类型的 impl 曾经因为 trait_fn 为 NULL 被跳过,
// find_impl 返回 NULL 直接段错误)。这里优先用 assert_eq/assert_ne。
use std::{assert, assert_eq, assert_ne};
use std::cmp::{Eq, PartialEq};
use std::hash::{Hash, Hasher, default_hasher};

fn main() {
    // ---- Option ----
    let a: Option<Int> = Some(1_i);
    let b: Option<Int> = Some(1_i);
    let c: Option<Int> = None;
    let d: Option<Int> = None;
    assert_eq(a, b);
    assert_eq(c, d);
    assert_ne(a, c);
    assert_ne(c, a);
    assert(!a.eq(&c));
    assert(!c.eq(&a));

    let s1: Option<String> = Some(String::from_str("hi"));
    let s2: Option<String> = Some(String::from_str("hi"));
    let s3: Option<String> = Some(String::from_str("ho"));
    assert_eq(s1, s2);
    assert_ne(s1, s3);

    // None vs Some 比较之后 payload 仍可用 (比较里不能误释放/误拷贝 payload)
    let s4: Option<String> = Some(String::from_str("hi"));
    let n3: Option<String> = None;
    assert_ne(s4, n3);
    assert_ne(n3, s4);
    assert(!s4.eq(&n3));
    match s4 {
        Option::Some(v) => { assert(v.eq(&String::from_str("hi"))); }
        Option::None => { assert(false, "s4 不应变成 None"); }
    }

    // Hash 与 Eq 一致: 相等 -> 哈希相同, Some/None 不碰撞
    let mut h1 = default_hasher();
    a.hash(&mut h1);
    let mut h2 = default_hasher();
    b.hash(&mut h2);
    let mut h3 = default_hasher();
    c.hash(&mut h3);
    assert_eq(h1.finish(), h2.finish());
    assert(h1.finish() != h3.finish());

    // ---- Result ----
    let r1: Result<Int, Int> = (type Result<Int, Int>)::Ok(1_i);
    let r2: Result<Int, Int> = (type Result<Int, Int>)::Ok(1_i);
    let e1: Result<Int, Int> = (type Result<Int, Int>)::Err(2_i);
    let e2: Result<Int, Int> = (type Result<Int, Int>)::Err(2_i);
    assert_eq(r1, r2);
    assert_eq(e1, e2);
    assert_ne(r1, e1);
    // Ok 与 Err 永远不相等 (即使 payload 类型相同)
    assert_ne(r1, (type Result<Int, Int>)::Err(1_i));
    assert(!r1.eq(&((type Result<Int, Int>)::Err(1_i))));

    let mut g1 = default_hasher();
    r1.hash(&mut g1);
    let mut g2 = default_hasher();
    r2.hash(&mut g2);
    let mut g3 = default_hasher();
    e1.hash(&mut g3);
    assert_eq(g1.finish(), g2.finish());
    assert(g1.finish() != g3.finish());

    println("option/result partial eq ok");
}
