// 跨符号性整数加宽: 扩展符号必须看**源**类型。
// 历史 bug: IntToInt 按目标类型选 sext/zext,
//   255_u8 as Int16 -> -1,  (-1_i8) as UInt16 -> 255。
use std::{assert, assert_eq};

fn main() {
    assert_eq(255_u8 as Int16, 255_i16);
    assert_eq(255_u8 as Int32, 255_i32);
    assert_eq(255_u8 as Int, 255_i);
    assert_eq(200_u8 as Int16, 200_i16);

    assert_eq((-1_i8) as UInt16, 65535_u16);
    assert_eq((-1_i8) as UInt32, 4294967295_u32);
    assert_eq((-1_i8) as UInt, 18446744073709551615_u);
    assert_eq((-128_i8) as UInt16, 65408_u16);

    assert_eq(0xFFFF_u16 as Int32, 65535_i32);
    assert_eq((-1_i16) as UInt32, 4294967295_u32);
}
