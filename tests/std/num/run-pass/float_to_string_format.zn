// 浮点 ToString 的格式 (%g, 6 位有效数字) 与 f"$(x)" / to_string 一致性,
// 以及追加到非空缓冲区时长度推进是否正确。
// 已有 float_to_string.zn 只覆盖了 3.25 / 1.5 / 0 / -0.5 / inf / nan,
// 这里补: 科学计数法边界 (1e20 / 1e-7 / 1e300 / 1e-300)、大整数、F32 与追加。
use std::{assert, assert_eq};
use std::primitives::string::ToString;

fn main() {
    // ---- 普通小数 ----
    assert_eq(f"$(0.0_f64)", f"0");
    assert_eq(f"$(2.0_f64)", f"2");
    assert_eq(f"$(0.5_f64)", f"0.5");
    assert_eq(f"$(-0.5_f64)", f"-0.5");
    assert_eq(f"$(3.25_f64)", f"3.25");
    assert_eq(f"$(1.5_f64)", f"1.5");
    assert_eq(f"$(-2.5_f64)", f"-2.5");

    // ---- 科学计数法边界 (%g 的切换点在 1e-5 / 1e6 附近) ----
    assert_eq(f"$(0.0001_f64)", f"0.0001");
    assert_eq(f"$(0.00001_f64)", f"1e-05");
    assert_eq(f"$(0.0000001_f64)", f"1e-07");
    assert_eq(f"$(100000.0_f64)", f"100000");
    assert_eq(f"$(1000000.0_f64)", f"1e+06");
    assert_eq(f"$(1234567.0_f64)", f"1.23457e+06");
    assert_eq(f"$(123456789.0_f64)", f"1.23457e+08");
    assert_eq(f"$(100000000000000000000.0_f64)", f"1e+20");

    // 1/3 只保留 6 位有效数字
    assert_eq(f"$(1.0_f64 / 3.0_f64)", f"0.333333");
    assert_eq(f"$(2.0_f64 / 3.0_f64)", f"0.666667");

    // ---- 特殊值 ----
    let z: F64 = 0.0;
    let inf = 1.0_f64 / z;
    let ninf = -1.0_f64 / z;
    let nan = z / z;
    assert_eq(f"$(inf)", f"inf");
    assert_eq(f"$(ninf)", f"-inf");
    assert_eq(f"$(nan)", f"nan");
    assert_eq(f"$(-0.0_f64)", f"-0");

    // ---- f"$(x)" 与 to_string 必须一致 ----
    let a: F64 = 3.25;
    let b: F64 = -0.5;
    let c: F32 = 1.5;
    assert_eq(f"$(a)", a.to_string());
    assert_eq(f"$(b)", b.to_string());
    assert_eq(f"$(c)", c.to_string());
    let mut it: F64 = 1.0;
    while it < 100000.0 { it = it * 10.0; }
    assert_eq(f"$(it)", it.to_string());

    // ---- F32 ----
    assert_eq(f"$(0.0_f32)", f"0");
    assert_eq(f"$(1.5_f32)", f"1.5");
    assert_eq(f"$(-1.25_f32)", f"-1.25");
    assert_eq(f"$(0.5_f32)", f"0.5");
    let z32: F32 = 0.0;
    assert_eq(f"$(1.0_f32 / z32)", f"inf");
    assert_eq(f"$(-1.0_f32 / z32)", f"-inf");
    // NaN 的符号位由硬件/常量折叠决定 (可能是 "nan" 也可能是 "-nan"), 只要求渲染出 nan 文本
    let nan32 = z32 / z32;
    assert(nan32.is_nan());
    let nan32_text = f"$(nan32)";
    assert(nan32_text.ends_with("nan"));
    assert_eq(f"$(-0.0_f32)", f"-0");

    // ---- 通过循环生成的超大 / 超小数 (字面量语法不支持 e 记数法) ----
    let mut big: F64 = 1.0;
    let mut i: Int = 0;
    while i < 300 {
        big = big * 10.0_f64;
        i += 1;
    }
    assert_eq(f"$(big)", f"1e+300");

    let mut small: F64 = 1.0;
    let mut j: Int = 0;
    while j < 300 {
        small = small / 10.0_f64;
        j += 1;
    }
    assert_eq(f"$(small)", f"1e-300");

    // ---- 追加到非空 String: 长度从原来的 size 继续推进 ----
    let mut s = String::new();
    s.push_str("v=");
    a.to_string_inplace(&mut s);
    assert_eq(s, f"v=3.25");
    assert_eq(s.len(), 6_u);
    s.push_str(",");
    b.to_string_inplace(&mut s);
    assert_eq(s, f"v=3.25,-0.5");

    let mut t = String::from_str("head|");
    c.to_string_inplace(&mut t);
    assert_eq(t, f"head|1.5");

    println("float to_string format ok");
}
