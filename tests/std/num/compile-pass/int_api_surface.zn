// 各整数类型暴露的方法签名 (只做类型检查, 运行期行为在 run-pass 里验证)。
// 覆盖 Int / UInt / Int8..64 / UInt8..64 / Short / UShort 的:
// 位运算、min/max_value、wrapping_*、checked_*、saturating_*、ToString、Clone、Default。
use std::primitives::string::ToString;
use std::hash::{Hash, Hasher, default_hasher};
use std::cmp::Ordering;

fn int_api() {
    let v: Int = 0x0F_i;
    let _r: Int = v.reverse_bits();
    let _l: Int = v.rotate_left(1_u32);
    let _rr: Int = v.rotate_right(1_u32);
    let _a: Int = v.bit_and(0xFF_i);
    let _o: Int = v.bit_or(0xF0_i);
    let _x: Int = v.bit_xor(0xFF_i);
    let _n: Int = v.bit_not();
    let _sl: Int = v.bit_shl(1_u32);
    let _sr: Int = v.bit_shr(1_u32);
    let _min: Int = Int::min_value();
    let _max: Int = Int::max_value();
    let _wa: Int = v.wrapping_add(1_i);
    let _ws: Int = v.wrapping_sub(1_i);
    let _wm: Int = v.wrapping_mul(2_i);
    let _ca: Option<Int> = v.checked_add(1_i);
    let _cs: Option<Int> = v.checked_sub(1_i);
    let _cm: Option<Int> = v.checked_mul(2_i);
    let _sa: Int = v.saturating_add(1_i);
    let _ss: Int = v.saturating_sub(1_i);
    let _sm: Int = v.saturating_mul(2_i);
    let _ts: String = v.to_string();
    let _cl: Int = v.clone();
    let _df: Int = Int::default();
    let mut h = default_hasher();
    v.hash(&mut h);
    let _hf: UInt64 = h.finish();
}

fn uint_api() {
    let v: UInt = 0x0F_u;
    let _r: UInt = v.reverse_bits();
    let _l: UInt = v.rotate_left(1_u32);
    let _rr: UInt = v.rotate_right(1_u32);
    let _a: UInt = v.bit_and(0xFF_u);
    let _o: UInt = v.bit_or(0xF0_u);
    let _x: UInt = v.bit_xor(0xFF_u);
    let _n: UInt = v.bit_not();
    let _sl: UInt = v.bit_shl(1_u32);
    let _sr: UInt = v.bit_shr(1_u32);
    let _min: UInt = UInt::min_value();
    let _max: UInt = UInt::max_value();
    let _wa: UInt = v.wrapping_add(1_u);
    let _ws: UInt = v.wrapping_sub(1_u);
    let _wm: UInt = v.wrapping_mul(2_u);
    let _ca: Option<UInt> = v.checked_add(1_u);
    let _cs: Option<UInt> = v.checked_sub(1_u);
    let _cm: Option<UInt> = v.checked_mul(2_u);
    let _sa: UInt = v.saturating_add(1_u);
    let _ss: UInt = v.saturating_sub(1_u);
    let _sm: UInt = v.saturating_mul(2_u);
    let _ts: String = v.to_string();
    let _cl: UInt = v.clone();
    let _df: UInt = UInt::default();
    let mut h = default_hasher();
    v.hash(&mut h);
    let _hf: UInt64 = h.finish();
}

fn int8_api() {
    let v: Int8 = 0x0F_i8;
    let _r: Int8 = v.reverse_bits();
    let _l: Int8 = v.rotate_left(1_u32);
    let _a: Int8 = v.bit_and(0x0F_i8);
    let _n: Int8 = v.bit_not();
    let _sl: Int8 = v.bit_shl(1_u32);
    let _sr: Int8 = v.bit_shr(1_u32);
    let _min: Int8 = Int8::min_value();
    let _max: Int8 = Int8::max_value();
    let _wa: Int8 = v.wrapping_add(1_i8);
    let _ca: Option<Int8> = v.checked_add(1_i8);
    let _cm: Option<Int8> = v.checked_mul(2_i8);
    let _sa: Int8 = v.saturating_mul(2_i8);
    let _ts: String = v.to_string();
    let _cl: Int8 = v.clone();
    let _df: Int8 = Int8::default();
}

