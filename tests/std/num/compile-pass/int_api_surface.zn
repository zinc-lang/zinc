    let v: Int64 = 0x0F_i64;
    let _r: Int64 = v.reverse_bits();
    let _l: Int64 = v.rotate_right(1_u32);
    let _a: Int64 = v.bit_and(0xFF_i64);
    let _n: Int64 = v.bit_not();
    let _sl: Int64 = v.bit_shl(1_u32);
    let _sr: Int64 = v.bit_shr(1_u32);
    let _min: Int64 = Int64::min_value();
    let _max: Int64 = Int64::max_value();
    let _ca: Option<Int64> = v.checked_add(1_i64);
    let _sa: Int64 = v.saturating_sub(1_i64);
    let _ts: String = v.to_string();
    let _cl: Int64 = v.clone();
    let _df: Int64 = Int64::default();
