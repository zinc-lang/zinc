    let _min: Int16 = Int16::min_value();
    let _max: Int16 = Int16::max_value();
    let _ca: Option<Int16> = v.checked_sub(1_i16);
    let _sa: Int16 = v.saturating_add(1_i16);
    let _ts: String = v.to_string();
    let _cl: Int16 = v.clone();
    let _df: Int16 = Int16::default();
}

