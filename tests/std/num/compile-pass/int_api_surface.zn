fn uint16_api() {
    let v: UInt16 = 0x0F_u16;
    let _r: UInt16 = v.reverse_bits();
    let _l: UInt16 = v.rotate_left(1_u32);
    let _a: UInt16 = v.bit_and(0xFF_u16);
    let _n: UInt16 = v.bit_not();
    let _sl: UInt16 = v.bit_shl(1_u32);
    let _sr: UInt16 = v.bit_shr(1_u32);
    let _min: UInt16 = UInt16::min_value();
    let _max: UInt16 = UInt16::max_value();
    let _ca: Option<UInt16> = v.checked_sub(1_u16);
    let _sa: UInt16 = v.saturating_add(1_u16);
    let _ts: String = v.to_string();
    let _cl: UInt16 = v.clone();
    let _df: UInt16 = UInt16::default();
}

fn uint32_api() {
    let v: UInt32 = 0x0F_u32;
    let _r: UInt32 = v.reverse_bits();
    let _l: UInt32 = v.rotate_left(1_u32);
    let _a: UInt32 = v.bit_and(0xFF_u32);
    let _n: UInt32 = v.bit_not();
    let _sl: UInt32 = v.bit_shl(1_u32);
    let _sr: UInt32 = v.bit_shr(1_u32);
    let _min: UInt32 = UInt32::min_value();
    let _max: UInt32 = UInt32::max_value();
    let _ca: Option<UInt32> = v.checked_mul(2_u32);
    let _sa: UInt32 = v.saturating_mul(2_u32);
    let _ts: String = v.to_string();
    let _cl: UInt32 = v.clone();
    let _df: UInt32 = UInt32::default();
}

fn uint64_api() {
    let v: UInt64 = 0x0F_u64;
    let _r: UInt64 = v.reverse_bits();
    let _l: UInt64 = v.rotate_right(1_u32);
    let _a: UInt64 = v.bit_and(0xFF_u64);
    let _n: UInt64 = v.bit_not();
    let _sl: UInt64 = v.bit_shl(1_u32);
    let _sr: UInt64 = v.bit_shr(1_u32);
    let _min: UInt64 = UInt64::min_value();
    let _max: UInt64 = UInt64::max_value();
    let _ca: Option<UInt64> = v.checked_add(1_u64);
    let _sa: UInt64 = v.saturating_sub(1_u64);
    let _ts: String = v.to_string();
    let _cl: UInt64 = v.clone();
    let _df: UInt64 = UInt64::default();
}

fn short_api() {
    let v: Short = 15;
    let _r: Short = v.reverse_bits();
    let _l: Short = v.rotate_left(1_u32);
    let _a: Short = v.bit_and(255);
    let _n: Short = v.bit_not();
    let _sl: Short = v.bit_shl(1_u32);
    let _sr: Short = v.bit_shr(1_u32);
    let _min: Short = Short::min_value();
    let _max: Short = Short::max_value();
    let _ca: Option<Short> = v.checked_add(1);
    let _sa: Short = v.saturating_mul(2);
    let _ts: String = v.to_string();
    let _cl: Short = v.clone();
    let _df: Short = Short::default();
}

fn ushort_api() {
    let v: UShort = 15;
    let _r: UShort = v.reverse_bits();
    let _l: UShort = v.rotate_left(1_u32);
    let _a: UShort = v.bit_and(255);
    let _n: UShort = v.bit_not();
    let _sl: UShort = v.bit_shl(1_u32);
    let _sr: UShort = v.bit_shr(1_u32);
    let _min: UShort = UShort::min_value();
    let _max: UShort = UShort::max_value();
    let _ca: Option<UShort> = v.checked_add(1);
    let _sa: UShort = v.saturating_mul(2);
    let _ts: String = v.to_string();
    let _cl: UShort = v.clone();
    let _df: UShort = UShort::default();
}

fn float_api() {
    let a: F64 = 1.5;
    let b: F32 = 1.5_f32;
    let _na: Bool = a.is_nan();
    let _nb: Bool = b.is_nan();
    let _tsa: String = a.to_string();
    let _tsb: String = b.to_string();
    let _cla: F64 = a.clone();
    let _clb: F32 = b.clone();
    let _dfa: F64 = F64::default();
    let _dfb: F32 = F32::default();
    let _pc: Option<Ordering> = a.partial_cmp(&a);
    let _eq: Bool = a.eq(&a);
    let _lt: Bool = a.lt(&a);
}

fn main() {
    int_api();
    uint_api();
    int8_api();
    int16_api();
    int32_api();
    int64_api();
    uint8_api();
    uint16_api();
    uint32_api();
    uint64_api();
    short_api();
    ushort_api();
    float_api();
}
