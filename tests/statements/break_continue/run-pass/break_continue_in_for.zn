// for 循环里的 continue / break: 累加奇数, 遇到 7 提前结束
use std::{assert, assert_eq};

fn main() {
    let mut v = (type Vec<Int>)::new();
    let mut i = 0_i;
    while i < 10_i {
        v.push(i);
        i += 1_i;
    }

    let mut sum = 0_i;
    for x in v {
        if x % 2_i == 0_i { continue; } // 偶数跳过
        if x == 7_i { break; }          // 到 7 结束
        sum += x;
    }

    assert_eq(sum, 9_i); // 1 + 3 + 5
}
