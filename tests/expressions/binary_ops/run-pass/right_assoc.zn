// Zinc 的二元运算符是右结合的: a - b - c 等价 a - (b - c)
// (和多数语言不同, 这里用运行期断言确认真实语义)
use std::{assert, assert_eq, assert_ne};

fn main() {
    // 减法右结合
    assert_eq(10_i - 3_i - 2_i, 9_i);    // 10 - (3 - 2)
    assert_ne(10_i - 3_i - 2_i, 5_i);    // 不是 (10 - 3) - 2

    // 除法右结合
    assert_eq(100_i / 10_i / 2_i, 20_i); // 100 / (10 / 2)
    assert_ne(100_i / 10_i / 2_i, 5_i);

    // 加法右结合 (结果和左结合一样, 这里只是说明语法)
    assert_eq(1_i + 2_i + 3_i, 6_i);

    // 想得到左结合必须显式写括号
    assert_eq((10_i - 3_i) - 2_i, 5_i);
    assert_eq((100_i / 10_i) / 2_i, 5_i);
}
