// 算术二元运算的优先级: * / % 比 + - 紧, 括号可以改变分组
use std::{assert, assert_eq};

fn main() {
    // 优先级: 先 * / %, 再 + -
    assert_eq(1_i + 2_i * 3_i, 7_i);
    assert_eq(10_i - 6_i / 2_i, 7_i);
    // 同一优先级内部也是右结合: 2_i * (3_i % 4_i)
    assert_eq(2_i * 3_i % 4_i, 6_i);
    assert_eq(8_i % 6_i * 2_i, 8_i % (6_i * 2_i));

    // 括号改变分组
    assert_eq((1_i + 2_i) * 3_i, 9_i);
    assert_eq((2_i + 4_i) % 3_i, 0_i);

    // 不同宽度的整数 (两边类型必须一致)
    let a: UInt8 = 250_u8;
    assert_eq(a + 5_u8, 255_u8);

    let b: Int64 = 1_i64;
    assert_eq(b * 3_i64, 3_i64);
}
