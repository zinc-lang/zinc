// 二元运算符在同一优先级内部左结合: a - b - c 等价 (a - b) - c
// (和多数语言一致; 括号可以强制右侧分组)
use std::{assert, assert_eq, assert_ne};

fn main() {
    // 减法左结合
    assert_eq(10_i - 3_i - 2_i, 5_i);    // (10 - 3) - 2
    assert_ne(10_i - 3_i - 2_i, 9_i);    // 不是 10 - (3 - 2)

    // 除法左结合
    assert_eq(100_i / 10_i / 2_i, 5_i);  // (100 / 10) / 2
    assert_ne(100_i / 10_i / 2_i, 20_i); // 不是 100 / (10 / 2)

    // 取模左结合 (选一组能区分结合方向的数: 100%30%7 = 3, 100%(30%7) = 0)
    assert_eq(100_i % 30_i % 7_i, 3_i);  // (100 % 30) % 7
    assert_ne(100_i % 30_i % 7_i, 0_i);

    // 乘 / 取模混合也是左结合
    assert_eq(2_i * 3_i % 4_i, 2_i);     // (2 * 3) % 4
    assert_eq(8_i % 6_i * 2_i, 4_i);     // (8 % 6) * 2

    // 括号改变结合方向
    assert_eq(10_i - (3_i - 2_i), 9_i);
    assert_eq(100_i / (10_i / 2_i), 20_i);

    // 加法左右结合结果一致, 这里只是说明语法
    assert_eq(1_i + 2_i + 3_i, 6_i);
}
