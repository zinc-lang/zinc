// 浮点字面量: 小数形式 + 可选 f32/f64 后缀
// 浮点字面量本身不带默认类型, 所以必须给出后缀或上下文类型
//
// 注意 (编译器 bug): 带 _f32/_f64 后缀的字面量解析出来的数值是错的,
// 见同目录 run-pass/float_suffix_value_bug.zn 与报告
fn main() {
    let a: F64 = 1.5;
    let b: F32 = 2.5;
    let c = 3.5_f64;
    let d = 4.5_f32;
    let e: F64 = 0.25;

    // 科学计数法不被支持, 这里只覆盖普通小数形式
    let f: F64 = 100.0;
    let g: F64 = 0.001;
}
