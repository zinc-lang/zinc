// 越界字面量会被静默截断 (编译器 bug, 这里记录当前的错误行为)
// UInt8 的范围是 0..=255, 但 300_u8 不会被报错, 运行期得到 300 & 0xFF == 44
// Int64 最大 9223372036854775807, 9223372036854775808_i 得到 -9223372036854775808
use std::{assert, assert_eq};

fn main() {
    let b: UInt8 = 300_u8;
    assert_eq(b as UInt, 44_u);

    let a: Int = 9223372036854775808_i;
    assert(a < 0_i);
}
