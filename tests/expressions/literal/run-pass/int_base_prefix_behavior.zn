// 整数字面量的进制前缀: 0b/0B (二), 0o/0O (八), 0x/0X (十六)
// 以 0 开头又没有进制前缀的写法 (010 等) 会报非法前缀, 见 compile-fail/int_leading_zero.zn
use std::{assert, assert_eq};

fn main() {
    assert_eq(0b1010_i, 10_i);
    assert_eq(0B11_i, 3_i);
    assert_eq(0o17_i, 15_i);
    assert_eq(0O10_i, 8_i);
    assert_eq(0xFF_i, 255_i);
    assert_eq(0X10_i, 16_i);

    // 下划线分隔符在三种进制里都要忽略
    assert_eq(0b1111_0000_i, 240_i);
    assert_eq(0o7_7_i, 63_i);
    assert_eq(0xDEAD_BEEF_i, 3735928559_i);
}
