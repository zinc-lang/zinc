// 编译器 bug: 带 _f64/_f32 后缀的浮点字面量数值是错的
//
// compiler/frontend/semantic/hir/constant/float.zn 的 FloatCValue::new 里:
//   1. 循环用的是 `tok_str.len()` 而不是去掉后缀后的 `str.len()`, 所以小数部分
//      会把 'f'、'6'、'4' 这些字符也当成数字继续累加;
//   2. 累加时做的是 `c - b'0'` 的 UInt8 减法, 对 'f' 这种比 '0' 小的字符会下溢。
//
// 结果 2.5_f64 != 2.5, 这是一个记录当前错误行为的用例。
use std::assert;

fn main() {
    let a: F64 = 2.5;
    let b: F64 = 2.5_f64;
    // 不加后缀的是正确值
    assert(a == 2.5);
    // 加了后缀的不是
    assert(!(b == 2.5));
}
