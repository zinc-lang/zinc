// 命名参数按参数名绑定到形参, 与书写顺序无关
use std::{assert, assert_eq};

fn named(a: Int, b: Int) -> Int {
    return a * 10_i + b;
}

fn named3(a: Int, b: Int, c: Int) -> Int {
    return a * 100_i + b * 10_i + c;
}

fn main() {
    // 书写顺序与声明一致
    assert_eq(named(.a = 3_i, .b = 4_i), 34_i);
    assert_eq(named3(.a = 3_i, .b = 2_i, .c = 1_i), 321_i);

    // 书写顺序改变, 结果不变: 按名字绑定
    assert_eq(named(.b = 4_i, .a = 3_i), 34_i);
    assert_eq(named3(.c = 1_i, .b = 2_i, .a = 3_i), 321_i);
    assert_eq(named3(.b = 2_i, .a = 3_i, .c = 1_i), 321_i);
}
