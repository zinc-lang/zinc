// 可变下标赋值: a[i] = v (可以叠加 += 等复合赋值)
fn main() {
    let mut a = [1_i, 2_i, 3_i];

    // 直接赋值
    a[0] = 10_i;
    a[2] = 30_i;

    // 复合赋值
    a[1] += 5_i;
    a[0] -= 1_i;
    a[2] *= 2_i;

    // 下标是 UInt 变量
    let i: UInt = 1_u;
    a[i] = 100_i;

    // 嵌套数组的赋值
    let mut m = [[1_i, 2_i], [3_i, 4_i]];
    m[0][1] = 20_i;
    m[1][0] = 30_i;

    // 赋值结果可以继续参与运算
    let v = a[2_i as UInt] + m[1][0];
}
