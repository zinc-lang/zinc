// 元组字面量: 各项类型可以不同, 嵌套元组, 单元类型 ()
fn main() {
    // 基本元组: 元素类型各不相同
    let t = (1_i, 2.5_f64, true);
    // 两元素元组
    let pair: (Int, UInt) = (1_i, 2_u);
    // 带尾随逗号的单元素元组
    let single = (9_i,);
    // 嵌套元组
    let nested = ((1_i, 2_i), 3_i);
    let deep = (((1_i, 2_i), (3_i, 4_i)), 5_i);
    // 单元类型: 空元组
    let unit: () = ();
    // 元组元素本身可以是数组 / 字符串
    let mixed = ([1_i, 2_i], String::new());
}
