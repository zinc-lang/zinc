// 结构体初始化表达式: { .field = value, ... }: Type
// 注意: 这个语言不支持 `Point { .x = 1 }` 这种写法, 必须大括号 + 类型标注
struct Point {
    x: Int,
    y: Int,
}

struct Line {
    start: Point,
    end: Point,
}

struct Holder {
    n: Int,
    name: String,
}

fn main() {
    // 基本形式
    let p = { .x = 1_i, .y = 2_i }: Point;
    // 字段顺序可以颠倒
    let q = { .y = 2_i, .x = 1_i }: Point;
    // 嵌套结构体初始化
    let line = {
        .start = { .x = 0_i, .y = 0_i }: Point,
        .end = { .x = 3_i, .y = 4_i }: Point,
    }: Line;
    // 字段值可以是任意表达式
    let r = { .x = 1_i + 1_i, .y = (2_i * 3_i) }: Point;
    // 字段类型可以是 String
    let h = { .n = 1_i, .name = String::from_str("zinc") }: Holder;
    // 初始化表达式也可以作为 `const(...)` 的操作数
    let c = const({ .x = 5_i, .y = 6_i }: Point);
}
