// 整数之间的 as: 同宽度 / 加宽 / 截断 / 回绕; 链式 as 是左结合
use std::{assert, assert_eq};

fn main() {
    assert_eq(1_i as UInt, 1_u);
    assert_eq(1_u as Int, 1_i);
    assert_eq(1_i as Int64, 1_i64);
    assert_eq(1_i as Int8, 1_i8);

    // 截断: 只保留低 8 位
    assert_eq(300_i as UInt8, 44_u8);
    assert_eq(256_i as UInt8, 0_u8);

    // 有符号/无符号之间的回绕
    assert_eq(-1_i as UInt, 18446744073709551615_u);
    assert_eq(-1_i as UInt64, 18446744073709551615_u64);

    // as 是左结合: ((1_i as UInt32) as UInt64) as Int
    assert_eq(1_i as UInt32 as UInt64 as Int, 1_i);
    assert_eq(300_i as UInt64 as UInt8 as Int, 44_i);
}
