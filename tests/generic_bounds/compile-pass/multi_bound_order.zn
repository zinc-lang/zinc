// 上界的书写顺序不影响判定: B + A 和 A + B 等价。
trait A {
    fn a(&self) -> Int;
}
trait B {
    fn b(&self) -> Int;
}

struct S { n: Int }

impl A for S {
    fn a(&self) -> Int { return self.n; }
}
impl B for S {
    fn b(&self) -> Int { return self.n + 1; }
}

fn f<T: B + A>(x: T) -> Int {
    return x.a() + x.b();
}

fn main() {
    let s = { .n = 1 }: S;
    println(f(s));
}
