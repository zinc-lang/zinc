// 堆类型的边界: 按引用捕获 Vec<UInt>。
// std 里 `impl<T> !Sync for Vec<T> {}`, 所以 &Vec<UInt> 不是 Send
// (交叉规则: &T: Send <=> T: Sync), 捕获它的闭包也就不是 Send。
//
// 注意: 这里测的是"按引用捕获", 与"按值 move 捕获堆类型"是两条路径。
// 后者的 [V8] ICE 已在第 2 项修掉 (见 run-pass/lambda_value_capture_heap_run.zn 与
// compile-pass/lambda_value_capture_vec_send.zn), 所以本文件只保留按引用捕获的判据。
//
// 修改前: 闭包一律非 Send, 也会失败 (同样原因不同)。
fn is_send<T>(x: T) where T: Send {}

fn main() {
    let mut v = (type Vec<UInt>)::new();
    v.push(1_u);
    // 闭包体只读, 隐式按引用捕获 (&Vec<UInt>)
    let f = .{ -> UInt => return v.len(); };
    is_send(f);
}
