{
  "name": "zinc",
  "displayName": "Zinc",
  "description": "Zinc language: syntax highlighting, brackets, comments, and snippets for .zn files",
  "version": "0.0.2",
  "publisher": "F001",
  "icon": "./zinc-logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zinc-lang/zinc"
  },
  "engines": {
    "vscode": "^1.8.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [{
      "id": "zinc",
      "aliases": ["Zinc", "zinc"],
      "extensions": [".zn"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "zinc",
      "scopeName": "source.zinc",
      "path": "./syntaxes/zinc.tmLanguage.json"
    }],
    "snippets": [{
      "language": "zinc",
      "path": "./snippets/zinc.json"
    }]
  }
}
