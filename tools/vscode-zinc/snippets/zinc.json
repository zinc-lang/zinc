{
  "fn": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2}) ${3:-> ${4:Type} }{", "    $0", "}"],
    "description": "Function"
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "    ${2:field}: ${3:Type}", "}"],
    "description": "Struct"
  },
  "impl": {
    "prefix": "impl",
    "body": ["impl ${1:Type} {", "    $0", "}"],
    "description": "Inherent impl"
  },
  "match": {
    "prefix": "match",
    "body": ["match ${1:expr} {", "    ${2:Pattern} => {", "        $0", "    }", "}"],
    "description": "Match expression"
  },
  "mod": {
    "prefix": "mod",
    "body": ["mod ${1:name} {", "    $0", "}"],
    "description": "Module"
  },
  "println": {
    "prefix": "println",
    "body": "println(${1:expr});",
    "description": "Print a value followed by newline (Zinc; not Rust println!)"
  },
  "println-fstring": {
    "prefix": ["printlnf", "fprintln"],
    "body": "println(f\"${1:label}=$(${2:expr})\");",
    "description": "Print an f-string with $(expr) interpolation"
  },
  "print": {
    "prefix": "print",
    "body": "print(${1:expr});",
    "description": "Print a value without a trailing newline"
  },
  "fstring": {
    "prefix": "f\"",
    "body": "f\"${1:text}=$(${2:expr})\"",
    "description": "Zinc f-string with $(expr) interpolation"
  }
}
