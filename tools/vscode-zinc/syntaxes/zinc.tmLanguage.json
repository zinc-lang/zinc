{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "zinc",
	"scopeName": "source.zinc",
	"fileTypes": ["zn"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#chars" },
		{ "include": "#numbers" },
		{ "include": "#keywords" },
		{ "include": "#types" }
	],
	"repository": {
		"keywords": {
			"patterns": [
			  {
				"match": "\\b(unsafe|inline|fn|Fn|FnMut|final|virtual|sealed)\\b",
				"name": "storage.modifier.zinc"
			  },
			  {
				"begin": "\\b(fn)\\b\\s+",
				"end": "\\s*(?=\\()",
				"patterns": [
					{
						"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b",
						"name": "entity.name.function"
					}
				]
			  },
			  {
				"match": "\\b(while|for|do|in)\\b",
				"name": "keyword.control.repeat.zinc"
			  },
			  {
				"name": "keyword.storage.zinc",
				"match": "\\b(import|export)\\b"
			  },
			  {
				"name": "storage.type.zinc",
				"match": "\\b(struct|enum|trait|union|type|Self)\\b"
			  },
			  {
				"name": "keyword.control.zinc",
				"match": "\\b(if|else|then|match|let)\\b"
			  },
			  {
				"name": "keyword.control.flow.zinc",
				"match": "\\b(break|continue|return|panic)\\b"
			  },
			  {
				"name": "constant.language.bool.zinc",
				"match": "\\b(true|false)\\b"
			  },
			  {
				"name": "keyword.other.zinc",
				"match": "\\b(as|asm|box|is|move|self|super)\\b"
			  },
			  {
				"name": "keyword.other.tag.zinc",
				"match": "\\b(const|extern|impl|macro|mod|reuse|use|where|static|pub)\\b"
			  },
			  {
				"name": "keyword.other.zinc",
				"match": "\\b(mut|out|ref|raw|weak)\\b"
			  },
			  {
				"name": "invalid.deprecated",
				"match": "\\b(yield|goto|await|async|override)\\b"
			  }
			]
		},
		"types": {
			"match": "\\b(Bool|Char|Str|String|Int|UInt|Int8|UInt8|Int16|UInt16|Int32|UInt32|Int64|UInt64|Short|UShort|F32|F64|Option|Result|Vec|HashMap|Slice|RangeExclusive|RangeInclusive)\\b",
			"name": "support.type.zinc"
		},
		"numbers": {
			"match": "\\b(?:0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+|[0-9][0-9_]*)(?:_[iuf](?:8|16|32|64)?)?\\b",
			"name": "constant.numeric.zinc"
		},
		"chars": {
			"name": "string.quoted.single.zinc",
			"match": "'(?:\\\\.|[^'\\\\])'"
		},
		"comments": {
			"patterns": [{
				"name": "comment.block.zinc",
				"begin": "/\\*",
				"end": "\\*/"
			},
			{
				"name": "comment.line.double-slash.zinc",
				"match": "(//).*\\n?"
			}]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.raw.zinc",
					"begin": "r(#*)\"",
					"end": "\"\\1"
				},
				{
					"name": "string.quoted.double.interpolated.zinc",
					"begin": "f\"",
					"end": "\"",
					"patterns": [
						{ "name": "constant.character.escape.zinc", "match": "\\\\." },
						{ "name": "variable.other.interpolated.zinc", "begin": "\\$\\(", "end": "\\)" }
					]
				},
				{
					"name": "string.quoted.double.c.zinc",
					"begin": "c\"",
					"end": "\"",
					"patterns": [
						{ "name": "constant.character.escape.zinc", "match": "\\\\." }
					]
				},
				{
					"name": "string.quoted.double.zinc",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{ "name": "constant.character.escape.zinc", "match": "\\\\." }
					]
				}
			]
		}
	}
}
